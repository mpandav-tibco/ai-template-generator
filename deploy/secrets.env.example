# BWCE AI Generator: secrets for your environment.
#
# Copy this file to secrets.env, fill in the values and keep it out of version control (store it in your secret
# manager or a Kubernetes Secret). Same format as config.env: KEY=value, no quotes.

# GitHub token: contents read on the template library, contents read/write on the target repositories;
# TARGET_MODE=newRepo also needs administration rights to create repositories.
GITHUB_TOKEN=

POSTGRESQL_GENERATIONREGISTRY_PASSWORD=

# Only for LLM or embedding endpoints that need a key (not needed for Ollama)
LLM_API_KEY=
LLM_EMBEDDING_API_KEY=

# Only for a Weaviate instance with API key authentication
WEAVIATE_WEAVIATETEMPLATEKB_API_KEY=

# Only for an SMTP server with authentication (user in config.env)
SMTP_PASSWORD=

# Kubernetes operations (optional): JSON on one line, context name -> url, namespace, token
#K8S_CONTEXTS={"prod":{"url":"https://<api-server>:6443","namespace":"<namespace>","token":"<service-account-token>"}}

# Code review service (optional)
#CODE_REVIEW_PASSWORD=
#CODE_REVIEW_COOKIE=
