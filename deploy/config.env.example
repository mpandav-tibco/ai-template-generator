# BWCE AI Generator: settings for your environment (no secrets; those go in secrets.env).
#
# Copy this file to config.env and set the values for your infrastructure. Every app property can be set with an
# environment variable: the property name in upper case, dots replaced by underscores
# (PostgreSQL.GenerationRegistry.Host -> POSTGRESQL_GENERATIONREGISTRY_HOST). Commented lines show the default
# built into the app; leave them commented to keep it.
# Format: one KEY=value per line, no quotes, comments only on their own line (docker --env-file and
# kubectl --from-env-file read the values as they are).

# Read app properties from the environment, and serve the OpenAPI definition at /api/v2/swagger.json
FLOGO_APP_PROPS_ENV=auto
FLOGO_EXPOSE_SWAGGER_EP=true

# ── GitHub: template library and where generated repositories are published ──────────────────────────────────
# GitHub Enterprise: https://<host>/api/v3
GITHUB_API_URL=https://api.github.com
TEMPLATE_REPO_URL=https://github.com/<org>/ci-bwcetemplates
TEMPLATE_REF=main
# subfolder: one folder per integration in TARGET_REPO_URL; newRepo: one private repository per integration
# under TARGET_OWNER_URL (the UI, REST and MCP requests can choose per generation)
TARGET_MODE=subfolder
TARGET_REPO_URL=https://github.com/<org>/bwce-integration-repos
TARGET_OWNER_URL=https://github.com/<org>
TARGET_BRANCH=main
GIT_AUTHOR_NAME=BWCE AI Generator
GIT_AUTHOR_EMAIL=bwce-ai-generator@<your-domain>
# Jenkinsfile, GitHub Actions workflow, Kubernetes manifests and runtime config in every generated repository
#GENERATE_CICD=true

# ── PostgreSQL: generation registry, chat sessions, IKD registry, code review history ────────────────────────
# The tables are created or upgraded at startup, so the user needs CREATE rights on the database.
POSTGRESQL_GENERATIONREGISTRY_HOST=<postgres-host>
POSTGRESQL_GENERATIONREGISTRY_PORT=5432
POSTGRESQL_GENERATIONREGISTRY_DATABASE_NAME=<database>
POSTGRESQL_GENERATIONREGISTRY_USER=<user>
# TLS, required by most managed PostgreSQL services: TLS=true, TLS_MODE VerifyCA or VerifyFull, and the server's CA
# certificate as base64-encoded PEM on one line (base64 < ca.pem | tr -d '\n')
#POSTGRESQL_GENERATIONREGISTRY_TLS=false
#POSTGRESQL_GENERATIONREGISTRY_TLS_MODE=VerifyCA
#POSTGRESQL_GENERATIONREGISTRY_CA_CERTIFICATE=
#POSTGRESQL_GENERATIONREGISTRY_MAXIMUM_OPEN_CONNECTIONS=0
#POSTGRESQL_GENERATIONREGISTRY_MAXIMUM_IDLE_CONNECTIONS=2
#POSTGRESQL_GENERATIONREGISTRY_MAXIMUM_CONNECTION_LIFETIME=0
#POSTGRESQL_GENERATIONREGISTRY_MAXIMUM_CONNECTION_RETRY_ATTEMPTS=3
#POSTGRESQL_GENERATIONREGISTRY_CONNECTION_RETRY_DELAY=5
#POSTGRESQL_GENERATIONREGISTRY_CONNECTION_TIMEOUT=20

# ── Weaviate: template catalog for semantic search (collection created and filled at startup) ────────────────
WEAVIATE_WEAVIATETEMPLATEKB_HOST=<weaviate-host>
WEAVIATE_WEAVIATETEMPLATEKB_PORT=8080
# https for Weaviate Cloud or any TLS endpoint (port 443)
WEAVIATE_WEAVIATETEMPLATEKB_SCHEME=http
VECTOR_COLLECTION=BWCECiTemplates768
#WEAVIATE_WEAVIATETEMPLATEKB_SECURE_CONNECTION=false
#WEAVIATE_WEAVIATETEMPLATEKB_TIMEOUT_SECONDS=30
#WEAVIATE_WEAVIATETEMPLATEKB_MAX_RETRIES=3
#WEAVIATE_WEAVIATETEMPLATEKB_RETRY_BACKOFF_MS=500
#WEAVIATE_WEAVIATETEMPLATEKB_CONFIGURE_EMBEDDING_PROVIDER=false

# ── LLM: extracts the integration spec from the conversation ─────────────────────────────────────────────────
# Ollama: Ollama API at LLM_BASE_URL/api/generate.
# OpenAI, Azure OpenAI or Custom: OpenAI chat completions API at LLM_BASE_URL/v1/chat/completions with
# "Authorization: Bearer <LLM_API_KEY>" (OpenAI, vLLM, LiteLLM, an API gateway, or Ollama itself).
LLM_PROVIDER=Ollama
LLM_BASE_URL=http://<ollama-host>:11434
LLM_MODEL=qwen2.5:7b
#EXTRACTION_SYSTEM_PROMPT=<the prompt built into the app>

# ── Embeddings: template search ──────────────────────────────────────────────────────────────────────────────
# OpenAI or Custom: OpenAI embeddings API at LLM_EMBEDDING_BASE_URL/embeddings (Ollama offers it at
# http://<host>:11434/v1); Azure OpenAI: the deployment's full embeddings URL (key sent as api-key);
# Ollama: Ollama API at LLM_EMBEDDING_BASE_URL/api/embed; Cohere: the embed URL.
LLM_EMBEDDING_PROVIDER=OpenAI
LLM_EMBEDDING_BASE_URL=http://<ollama-host>:11434/v1
LLM_EMBEDDING_MODEL=nomic-embed-text
# Vector size of LLM_EMBEDDING_MODEL. A Weaviate collection keeps one size: change VECTOR_COLLECTION with it.
LLM_EMBEDDING_DIMENSIONS=768

# ── E-mail notification per generation ───────────────────────────────────────────────────────────────────────
SMTP_HOST=<smtp-host>
SMTP_PORT=587
# NONE (plain relay), TLS (STARTTLS, usually port 587) or SSL (usually port 465)
SMTP_SECURITY=TLS
# Leave the user empty for a relay without authentication (password in secrets.env)
SMTP_USERNAME=
NOTIFY_SENDER=bwce-ai-generator@<your-domain>
NOTIFY_RECIPIENTS=<team-mailbox>@<your-domain>
# Footer line of the e-mail ({{organization}} in the templates)
NOTIFY_ORGANIZATION=<your organization>
# E-mail templates: HTML with {{placeholders}}, read for every e-mail (see README, Notification e-mail)
#NOTIFY_TEMPLATE=config/email/new-repository.html
#NOTIFY_TEMPLATE_CONFIG_ONLY=config/email/config-only.html
#BRAND_LOGO_FILE=static/email-logo.png

# ── Kubernetes operations (optional) ─────────────────────────────────────────────────────────────────────────
# K8S_CONTEXTS (cluster URLs, namespaces and tokens) is in secrets.env. K8S_CA_CERT: PEM, base64 PEM or
# file:///var/run/secrets/kubernetes.io/serviceaccount/ca.crt; empty = system CAs.
#K8S_CONTEXT=local
#K8S_INSECURE=false
#K8S_CA_CERT=

# ── Code review service (optional; its endpoints answer 503 until the credentials are set) ───────────────────
#CODE_REVIEW_BASE_URL=https://codereview.example.com/intginvent
#CODE_REVIEW_USERNAME=
#CODE_REVIEW_USERID=
#CODE_REVIEW_USERTYPE=admin
#CODE_REVIEW_INSECURE=true
#CODE_REVIEW_TOKEN_METHOD=POST

# ── UI, ports and files ──────────────────────────────────────────────────────────────────────────────────────
# Address of QAssist for the UI's QAssist tab (empty: not configured)
#QASSIST_URL=
#REST_PORT=9999
#MCP_PORT=8081
# Files are read relative to the working directory (/app in the container image); mount your own over them
#TEMPLATE_REGISTRY=config/ci-bwcetemplates.json
#IKD_INTERFACES_FILE=config/ikd/ikd-interface-ids.json
#IKD_SCENARIOS_FILE=config/ikd/ikd-scenario-ids.json
#OPS_PROGRAMS=config/ops-programs.json
#RULES_PATH=rules/
