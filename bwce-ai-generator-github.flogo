            "id": "GetCatalog",
            "name": "GetCatalog",
            "description": "Reads the template catalog (ids) so a requested template is only used if it exists"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.ikd_registry (kind, ikd_value, repo_name) SELECT t.k, t.v, ?repo ::text FROM (VALUES ('InterfaceIDs', ?iid ::text), ('ScenarioIDs', ?sid ::text)) AS t(k, v) WHERE ?config_only <> 'true' AND t.v <> '' ON CONFLICT (kind, repo_name) DO UPDATE SET ikd_value = EXCLUDED.ikd_value, updated_at = now() RETURNING kind",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
