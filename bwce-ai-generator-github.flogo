            "id": "ClearSession",
            "name": "ClearSession",
            "description": "Deletes the stored session row from the PostgreSQL chat_session table.",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 1000
              }
            },
            "activity": {
              "ref": "#delete",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "DELETE FROM public.chat_session WHERE session_id = ?session_id;",
                "manualmode": false,
                "RuntimeQuery": "",
                "Fields": [
                  {
                    "FieldName": "session_id",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "State": "b2652a57-000f-46ae-8708-b7405e729563DELETE FROM public.chat_session WHERE session_id = ?session_id;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "session_id": "=$flow.content.session_id"
