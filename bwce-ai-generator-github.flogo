      "id": "flow:HttpCall",
      "data": {
        "name": "HttpCall",
        "description": "Generic outbound HTTP call: never throws on HTTP status, returns text + parsed JSON",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Invoke",
            "type": "label",
