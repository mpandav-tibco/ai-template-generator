                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"arguments\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
          }
        }
      }
    },
    {
      "id": "flow:MCPListTemplates",
      "data": {
        "name": "MCPListTemplates",
        "description": "MCP tool 'list_templates'. Returns all available BWCE integration templates from shared memory.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetTemplates",
            "type": "label",
            "label": "StartActivity to GetTemplates"
          },
          {
            "id": 2,
            "from": "GetTemplates",
            "to": "BuildListResult",
            "type": "label",
            "label": "GetTemplates to BuildListResult"
          },
          {
            "id": 3,
            "from": "BuildListResult",
            "to": "ReturnTemplates",
            "type": "label",
            "label": "BuildListResult to ReturnTemplates"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetTemplates",
            "name": "GetTemplates",
            "description": "Reads the cached template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_CONFIG\"",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "BuildListResult",
            "name": "BuildListResult",
            "description": "Build the MCP tool response {data,error} from the cached template list.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "response": {
                      "data": "=coerce.toString($activity[GetTemplates].output.data)",
                      "error": "=\"\""
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ReturnTemplates",
            "name": "ReturnTemplates",
            "description": "Wraps the template list as an MCP ToolResult and returns it to the agent.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": "=$activity[BuildListResult].output.response"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkdldFRlbXBsYXRlcyI6eyJ4IjoyNTAsInkiOjE1MH0sIkJ1aWxkTGlzdFJlc3VsdCI6eyJ4Ijo0NTAsInkiOjI1MH0sIlJldHVyblRlbXBsYXRlcyI6eyJ4Ijo2NTAsInkiOjM1MH19",
