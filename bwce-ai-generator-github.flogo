                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildExtractResult",
            "name": "BuildExtractResult",
            "description": "Builds the MCP response from the extracted spec.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "response": {
                      "data": "=coerce.toString($activity[ExtractSpecSubflow].responseBody.body)",
                      "error": ""
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnResult",
            "name": "ReturnResult",
            "description": "Wraps the extracted spec as an MCP ToolResult and returns it to the agent.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": "=$activity[BuildExtractResult].output.response"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkJ1aWxkRXh0cmFjdEFyZ3MiOnsieCI6MjUwLCJ5Ijo0NX0sIkV4dHJhY3RTcGVjU3ViZmxvdyI6eyJ4Ijo0NTAsInkiOjQ1fSwiQnVpbGRFeHRyYWN0UmVzdWx0Ijp7IngiOjY1MCwieSI6NDV9LCJSZXR1cm5SZXN1bHQiOnsieCI6MjUwLCJ5IjoxOTV9fQ==",
