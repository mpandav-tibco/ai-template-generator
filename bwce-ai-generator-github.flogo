              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "suggestions": "=$activity[SuggestTemplates].sourceDocuments"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
