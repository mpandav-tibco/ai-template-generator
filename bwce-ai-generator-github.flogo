                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"method\": {\"type\": \"string\"}, \"user\": {\"type\": \"string\"}, \"password\": {\"type\": \"string\"}}}"
                  }
