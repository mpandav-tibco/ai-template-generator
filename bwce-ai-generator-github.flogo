                  "mapping": {
                    "product_area": "=(coerce.toString($flow.content.spec.product_area) != \"\") ? string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) : string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \"))",
                    "repo_prefix": "=(coerce.toString($flow.content.spec.product_area) != \"\") ? ((string.startsWith(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\")) ? ((string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csddistribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd-distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd_distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd-sourcing\") ? \"incsdsourcing-\" : ((string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-tsi-siam\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-tsi_siam\") ? \"intsisiam-\" : ((string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\") != \"\") ? string.concat(\"in\", string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\"), \"-\") : \"\"))) : \"\") : ((string.startsWith(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\")) ? ((string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csddistribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd-distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd_distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd-sourcing\") ? \"incsdsourcing-\" : ((string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-tsi-siam\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-tsi_siam\") ? \"intsisiam-\" : ((string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\") != \"\") ? string.concat(\"in\", string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\"), \"-\") : \"\"))) : \"\")",
                    "repo_itype": "=(string.startsWith(string.toUpper(coerce.toString($flow.content.spec.template_type)), \"REST_SERVICE\") || string.startsWith(string.toUpper(coerce.toString($flow.content.spec.template_type)), \"SOAP_SERVICE\")) ? \"service\" : string.toLower(string.trim(coerce.toString($flow.content.spec.interface_type), \" \"))",
                    "business_object": "=(number.len(string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\")) > 40) ? string.substring(string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\"), 0, 40) : string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\")",
                    "unique_suffix": "=(string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"1none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"\") ? string.concat(\"-\", string.toLower(coerce.toString($flow.content.spec.unique_id))) : \"\"",
                    "country_suffix": "=(string.toLower(coerce.toString($flow.content.spec.country_code)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"1none\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"\") ? string.concat(\"-\", string.substringBefore(string.concat(string.toLower(coerce.toString($flow.content.spec.country_code)), \"---\"), \"---\")) : \"\""
                  }
                }
              },
              "ref": "#mapper",
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}}}"
                  }
                }
