    {
      "id": "flow:MCPExtractSpecTool",
      "data": {
        "name": "MCPExtractSpecTool",
        "description": "MCP tool 'extract_spec'. Wraps the extract flow so AI agents can turn a natural-language description into a structured BWCE spec.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildExtractArgs",
            "type": "label",
            "label": "StartActivity to ExtractSpecSubflow"
          },
          {
            "id": 2,
            "from": "BuildExtractArgs",
            "to": "ExtractSpecSubflow",
            "type": "label",
            "label": "BuildExtractArgs to ExtractSpecSubflow"
          },
          {
            "id": 3,
            "from": "ExtractSpecSubflow",
            "to": "BuildExtractResult",
            "type": "label",
            "label": "ExtractSpecSubflow to BuildExtractResult"
          },
          {
            "id": 4,
            "from": "BuildExtractResult",
            "to": "ReturnResult",
            "type": "label",
            "label": "BuildExtractResult to ReturnResult"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildExtractArgs",
            "name": "BuildExtractArgs",
            "description": "Builds the content object passed to the extract subflow (evaluates argument expressions).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "content": {
                      "message": "=coerce.toString($flow.arguments.message)",
                      "current_spec": "=$flow.arguments.current_spec"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ExtractSpecSubflow",
            "name": "ExtractSpecSubflow",
            "description": "Runs the extract flow to convert the description into a structured spec.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:extract_POST",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "content": "=$activity[BuildExtractArgs].output.content"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "activity": {
              "input": {
                "input": {
                  "mapping": {
                    "response": {
                      "data": "=coerce.toString($activity[ExtractSpecSubflow].responseBody.body)",
                      "error": "=\"\""
                    }
                  }
                }
              },
              "ref": "#mapper"
            },
            "id": "BuildExtractResult",
            "name": "BuildExtractResult",
            "description": "Builds the MCP response from the extracted spec."
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": "=$activity[BuildExtractResult].output.response"
                }
              }
            },
            "id": "ReturnResult",
            "name": "ReturnResult",
            "description": "Wraps the extracted spec as an MCP ToolResult and returns it to the agent."
          }
        ],
