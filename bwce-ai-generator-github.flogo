                "Server Certificate": "=$property[\"K8S_CA_CERT\"]",
                "disableSSLVerification": "=$property[\"K8S_INSECURE\"]",
                "disableKeepAlives": false,
                "followRedirects": false,
                "Timeout": 30000,
                "proxy": "",
                "host": "",
                "serviceUrl": "=$flow.url",
