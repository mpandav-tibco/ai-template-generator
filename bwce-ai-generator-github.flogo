    {
      "id": "flow:codereview_run_POST",
      "data": {
        "name": "codereview_run_POST",
        "description": "Runs a code review (POST /api/codereview/run): token, one retry with a fresh token, history",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "ReadRun",
            "type": "label",
            "label": "GetOps to ReadRun"
          },
          {
            "id": 3,
            "from": "ReadRun",
            "to": "ReturnBad",
            "type": "expression",
            "label": "ReadRun to ReturnBad",
            "value": "$activity[ReadRun].output.err != \"\""
          },
          {
            "id": 4,
            "from": "ReadRun",
            "to": "Token1",
            "type": "expression",
            "label": "ReadRun to Token1",
            "value": "$activity[ReadRun].output.err == \"\""
          },
          {
            "id": 5,
            "from": "Token1",
            "to": "HistTokenFail",
            "type": "expression",
            "label": "Token1 to HistTokenFail",
            "value": "$activity[Token1].ok != true"
          },
          {
            "id": 6,
            "from": "Token1",
            "to": "Run1In",
            "type": "expression",
            "label": "Token1 to Run1In",
            "value": "$activity[Token1].ok == true"
          },
          {
            "id": 7,
            "from": "HistTokenFail",
            "to": "ReturnTokenFail",
            "type": "label",
            "label": "HistTokenFail to ReturnTokenFail"
          },
          {
            "id": 8,
            "from": "Run1In",
            "to": "Run1Plan",
            "type": "label",
            "label": "Run1In to Run1Plan"
          },
          {
            "id": 9,
            "from": "Run1Plan",
            "to": "Attempt1",
            "type": "label",
            "label": "Run1Plan to Attempt1"
          },
          {
            "id": 10,
            "from": "Attempt1",
            "to": "Token2",
            "type": "expression",
            "label": "Attempt1 to Token2",
            "value": "($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400)"
          },
          {
            "id": 11,
            "from": "Attempt1",
            "to": "Outcome",
            "type": "expression",
            "label": "Attempt1 to Outcome",
            "value": "!($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400)"
          },
          {
            "id": 12,
            "from": "Token2",
            "to": "Run2In",
            "type": "label",
            "label": "Token2 to Run2In"
          },
          {
            "id": 13,
            "from": "Outcome",
            "to": "RunResult",
            "type": "label",
            "label": "Outcome to RunResult"
          },
          {
            "id": 14,
            "from": "Run2In",
            "to": "Run2Plan",
            "type": "label",
            "label": "Run2In to Run2Plan"
          },
          {
            "id": 15,
            "from": "RunResult",
            "to": "HistOk",
            "type": "expression",
            "label": "RunResult to HistOk",
            "value": "$activity[RunResult].output.r.ok == true"
          },
          {
            "id": 16,
            "from": "RunResult",
            "to": "HistFail",
            "type": "expression",
            "label": "RunResult to HistFail",
            "value": "$activity[RunResult].output.r.ok != true"
