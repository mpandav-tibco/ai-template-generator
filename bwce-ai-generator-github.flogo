    {
      "ref": "#startuphook",
      "name": "tibco-appstartup",
      "description": "Runs once when the application starts. Loads the template registry and provider/protocol alias mappings into shared memory and ensures the PostgreSQL generation_log table exists.",
      "settings": {},
      "id": "AppStartup",
      "handlers": [
        {
          "description": "Application bootstrap flow. Loads the template registry and alias mappings from disk into shared memory and initializes the PostgreSQL schema.",
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:StartupFlow"
            }
          },
          "name": "StartupFlow"
        }
      ]
    },
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Model Context Protocol (MCP) server. Exposes the generator's capabilities as MCP tools (extract_spec, generate_code, list_templates) so AI assistants and agents can drive integration generation.",
      "settings": {
        "serverName": "bwce-ai-generator",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "=$property[\"MCP_AUTH_TYPE\"]",
        "authToken": "=$property[\"MCP_AUTH_TOKEN\"]"
      },
      "id": "MCPServer",
      "handlers": [
        {
          "description": "MCP tool 'extract_spec'. Wraps the extract flow so AI agents can turn a natural-language description into a structured BWCE spec.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "extract_spec",
            "handlerDescription": "Extract BWCE integration spec from natural language description",
            "toolTitle": "",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true,
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPExtractSpecTool"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
