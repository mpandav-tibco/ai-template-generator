        "databaseName": "=$property[\"PostgreSQL.GenerationRegistry.Database_Name\"]",
        "user": "=$property[\"PostgreSQL.GenerationRegistry.User\"]",
        "password": "=$property[\"PostgreSQL.GenerationRegistry.Password\"]",
        "maxopenconnection": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Open_Connections\"]",
        "maxidleconnection": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Idle_Connections\"]",
        "connmaxlifetime": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Connection_Lifetime\"]",
        "maxconnectattempts": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Connection_Retry_Attempts\"]",
        "connectionretrydelay": "=$property[\"PostgreSQL.GenerationRegistry.Connection_Retry_Delay\"]",
        "connectiontimeout": "=$property[\"PostgreSQL.GenerationRegistry.Connection_Timeout\"]",
        "onprem": false,
        "tlsconfig": false,
        "tlsparam": "VerifyCA",
        "cacert": "",
        "clientcert": "",
        "clientkey": ""
      }
    },
    "6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924": {
      "id": "6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
      "name": "WeaviateTemplateKB",
      "ref": "#connector",
      "isGlobal": false,
      "settings": {
        "name": "WeaviateTemplateKB",
        "host": "=$property[\"weaviate.WeaviateTemplateKB.Host\"]",
        "port": "=$property[\"weaviate.WeaviateTemplateKB.Port\"]",
        "apiKey": "=$property[\"weaviate.WeaviateTemplateKB.API_Key\"]",
        "useTLS": "=$property[\"weaviate.WeaviateTemplateKB.Secure_Connection\"]",
        "tlsInsecureSkipVerify": false,
        "timeoutSeconds": "=$property[\"weaviate.WeaviateTemplateKB.Timeout_(seconds)\"]",
        "maxRetries": "=$property[\"weaviate.WeaviateTemplateKB.Max_Retries\"]",
        "retryBackoffMs": "=$property[\"weaviate.WeaviateTemplateKB.Retry_Backoff_(ms)\"]",
        "scheme": "http",
        "enableEmbedding": "=$property[\"weaviate.WeaviateTemplateKB.Configure_Embedding_Provider\"]",
        "embeddingProvider": "OpenAI"
      }
    }
  },
  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "9999",
        "spec": {
          "name": "bwce-ai-generator-github",
          "version": "1.0.0"
        },
        "title": "BWCEAIIntegrationGenerator",
        "swagger": {
          "openapi": "3.0.0",
          "info": {
            "title": "BWCE AI Integration Generator (GitHub edition)",
            "description": "Generates TIBCO BWCE integration repositories from natural language and publishes them to GitHub, plus the operations APIs (Kubernetes, code review, schema upload, IKD registry). Authentication and authorization are done by the API gateway (Kong) in front of the app. Every operation is implemented by one Flogo flow of the same name.",
            "version": "1.0.0",
            "contact": {
              "name": "Core Integration Team",
              "email": "core-integration@adidas.com"
            }
          },
          "servers": [
            {
              "url": "http://localhost:9999",
              "description": "Local development"
            }
          ],
          "tags": [
            {
              "name": "System"
            },
            {
              "name": "Chat"
            },
            {
              "name": "Templates"
            },
            {
              "name": "Generation"
            },
            {
              "name": "Schemas"
            },
            {
              "name": "Code Review"
            },
            {
              "name": "Kubernetes"
            }
          ],
          "paths": {
            "/": {
              "get": {
                "operationId": "root_GET",
                "summary": "Web UI",
                "tags": [
                  "System"
                ],
                "responses": {
                  "200": {
                    "description": "Single-page web UI",
                    "content": {
                      "text/html": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/docs": {
              "get": {
                "operationId": "docs_GET",
                "summary": "API documentation page",
                "tags": [
                  "System"
                ],
                "responses": {
                  "200": {
                    "description": "HTML page rendering this API definition",
                    "content": {
                      "text/html": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/openapi.json": {
              "get": {
                "operationId": "openapi_json_GET",
                "summary": "This API definition",
                "tags": [
                  "System"
                ],
                "responses": {
                  "200": {
                    "description": "OpenAPI document",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/health": {
              "get": {
                "operationId": "health_GET",
                "summary": "Liveness and readiness probe",
                "tags": [
                  "System"
                ],
                "responses": {
                  "200": {
                    "description": "Service is up",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/HealthResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/chat/init": {
              "post": {
                "operationId": "api_chat/init_POST",
                "summary": "Start a conversation",
                "tags": [
                  "Chat"
                ],
                "responses": {
                  "200": {
                    "description": "Session created",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ChatInitResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/chat/message": {
              "post": {
                "operationId": "api_chat/message_POST",
                "summary": "Send a message; returns the reply and the updated integration spec",
                "tags": [
                  "Chat"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ChatMessageRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Reply with the current spec",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ChatMessageResponse"
