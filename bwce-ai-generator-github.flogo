                    "value": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"k8s\": {\"type\": \"object\", \"properties\": {\"prelude\": {\"type\": \"string\"}, \"route\": {\"type\": \"string\"}, \"routes\": {\"type\": \"object\"}, \"init\": {\"type\": \"string\"}, \"ops\": {\"type\": \"object\"}}}, \"schemas\": {\"type\": \"object\", \"properties\": {\"wrapper_template\": {\"type\": \"string\"}, \"plan\": {\"type\": \"string\"}}}, \"codereview\": {\"type\": \"object\", \"properties\": {\"token_request\": {\"type\": \"string\"}, \"token_result\": {\"type\": \"string\"}, \"run_check\": {\"type\": \"string\"}, \"run_request\": {\"type\": \"string\"}, \"run_result\": {\"type\": \"string\"}, \"netdebug\": {\"type\": \"string\"}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\"}, \"render\": {\"type\": \"string\"}}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"k8s\": {\"type\": \"object\", \"properties\": {\"prelude\": {\"type\": \"string\"}, \"route\": {\"type\": \"string\"}, \"routes\": {\"type\": \"object\"}, \"init\": {\"type\": \"string\"}, \"ops\": {\"type\": \"object\"}}}, \"schemas\": {\"type\": \"object\", \"properties\": {\"wrapper_template\": {\"type\": \"string\"}, \"plan\": {\"type\": \"string\"}}}, \"codereview\": {\"type\": \"object\", \"properties\": {\"token_request\": {\"type\": \"string\"}, \"token_result\": {\"type\": \"string\"}, \"run_check\": {\"type\": \"string\"}, \"run_request\": {\"type\": \"string\"}, \"run_result\": {\"type\": \"string\"}, \"netdebug\": {\"type\": \"string\"}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\"}, \"render\": {\"type\": \"string\"}}}}}}}"
