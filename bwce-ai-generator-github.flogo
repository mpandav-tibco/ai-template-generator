    {
      "id": "flow:codereview_run_POST",
      "data": {
        "name": "codereview_run_POST",
        "description": "Runs a code review (POST /api/codereview/run): token, one retry with a fresh token, history, audit",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 2,
            "from": "Authorize",
            "to": "Deny",
            "type": "expression",
            "label": "Authorize to Deny",
            "value": "$activity[Authorize].ok != true"
          },
          {
            "id": 3,
            "from": "Authorize",
            "to": "GetOps",
            "type": "expression",
            "label": "Authorize to GetOps",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 4,
            "from": "GetOps",
            "to": "ReadRun",
            "type": "label",
            "label": "GetOps to ReadRun"
          },
          {
            "id": 5,
            "from": "ReadRun",
            "to": "ReturnBad",
            "type": "expression",
            "label": "ReadRun to ReturnBad",
            "value": "$activity[ReadRun].output.err != \"\""
          },
          {
            "id": 6,
            "from": "ReadRun",
            "to": "Token1",
            "type": "expression",
            "label": "ReadRun to Token1",
            "value": "$activity[ReadRun].output.err == \"\""
          },
          {
            "id": 7,
            "from": "Token1",
            "to": "HistTokenFail",
            "type": "expression",
            "label": "Token1 to HistTokenFail",
            "value": "$activity[Token1].ok != true"
          },
          {
            "id": 8,
            "from": "HistTokenFail",
            "to": "ReturnTokenFail",
            "type": "label",
            "label": "HistTokenFail to ReturnTokenFail"
          },
          {
            "id": 9,
            "from": "Token1",
            "to": "Run1In",
            "type": "expression",
            "label": "Token1 to Run1In",
            "value": "$activity[Token1].ok == true"
          },
          {
            "id": 10,
            "from": "Run1In",
            "to": "Run1Plan",
            "type": "label",
            "label": "Run1In to Run1Plan"
          },
          {
            "id": 11,
            "from": "Run1Plan",
            "to": "Attempt1",
            "type": "label",
            "label": "Run1Plan to Attempt1"
          },
          {
            "id": 12,
            "from": "Attempt1",
            "to": "Token2",
            "type": "expression",
            "label": "Attempt1 to Token2",
            "value": "($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400)"
          },
          {
            "id": 13,
            "from": "Token2",
            "to": "Run2In",
            "type": "label",
            "label": "Token2 to Run2In"
          },
          {
            "id": 14,
            "from": "Run2In",
            "to": "Run2Plan",
            "type": "label",
            "label": "Run2In to Run2Plan"
          },
          {
            "id": 15,
            "from": "Run2Plan",
            "to": "Attempt2",
            "type": "label",
            "label": "Run2Plan to Attempt2"
          },
          {
            "id": 16,
            "from": "Attempt2",
            "to": "Outcome",
            "type": "label",
            "label": "Attempt2 to Outcome"
          },
          {
            "id": 17,
            "from": "Attempt1",
            "to": "Outcome",
            "type": "expression",
            "label": "Attempt1 to Outcome",
            "value": "!($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400)"
          },
          {
            "id": 18,
            "from": "Outcome",
            "to": "RunResult",
            "type": "label",
            "label": "Outcome to RunResult"
          },
          {
            "id": 19,
            "from": "RunResult",
            "to": "HistOk",
            "type": "expression",
            "label": "RunResult to HistOk",
            "value": "$activity[RunResult].output.r.ok == true"
          },
          {
            "id": 20,
            "from": "HistOk",
            "to": "AuditRun",
            "type": "label",
            "label": "HistOk to AuditRun"
          },
          {
            "id": 21,
            "from": "AuditRun",
            "to": "ReturnRun",
            "type": "label",
            "label": "AuditRun to ReturnRun"
          },
          {
            "id": 22,
            "from": "RunResult",
            "to": "HistFail",
            "type": "expression",
            "label": "RunResult to HistFail",
            "value": "$activity[RunResult].output.r.ok != true"
          },
          {
            "id": 23,
            "from": "HistFail",
            "to": "ReturnRunError",
            "type": "label",
            "label": "HistFail to ReturnRunError"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "/api/codereview/run",
                "admin_only": false,
                "trusted": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller (session, bearer token or API key)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Authorize].status",
                  "data": "=$activity[Authorize].body"
                }
              }
            },
            "id": "Deny",
            "name": "Deny",
            "description": "Rejects unauthenticated (401) or non-admin (403) callers"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "err": "=array.get(json.jq($flow.content, $activity[GetOps].output.data.codereview.run_check), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}"
                  }
                }
