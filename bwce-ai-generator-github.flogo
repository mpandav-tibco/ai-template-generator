                    "payload": "=$activity[Decide].output.d.claims",
                    "secret": "=$activity[GetAuth].output.data.signing_key",
                    "algorithm": "HS256"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"secret\": {\"type\": \"string\"}, \"algorithm\": {\"type\": \"string\"}, \"header\": {\"type\": \"string\"}, \"payload\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"secret\": {\"type\": \"string\"}, \"algorithm\": {\"type\": \"string\"}, \"header\": {\"type\": \"string\"}, \"payload\": {\"type\": \"string\"}}}"
