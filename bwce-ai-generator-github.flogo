            "description": "Result"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "status": "=$activity[Result].output.status",
                  "text": "=$activity[Result].output.text",
                  "json": "=$activity[Result].output.json",
                  "content_type": "=$activity[Result].output.content_type",
                  "elapsed_ms": "=$activity[Result].output.elapsed_ms",
