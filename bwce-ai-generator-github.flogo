          {
            "id": "BuildRemoved",
            "name": "BuildRemoved",
            "description": "Cleanup result: folder removed from the shared repository",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "repo_name": "=$activity[Plan].output.repo_name",
                    "target_mode": "=$activity[Plan].output.target_mode",
                    "github_url": "=$activity[Plan].output.github_url",
                    "registry_rows": "=$activity[DeleteRows].Output.records[0].registry_rows",
                    "ikd_rows": "=$activity[DeleteRows].Output.records[0].ikd_rows",
                    "folder_removed": "=$activity[RemoveFolder].pushed == true",
                    "commit_sha": "=coerce.toString($activity[RemoveFolder].commitSHA)",
                    "message": "=$activity[RemoveFolder].pushed == true ? string.concat(\"Removed folder \", $activity[Plan].output.repo_name, \" from \", $activity[Plan].output.repo_url, \" and its registry entries.\") : string.concat(\"The folder \", $activity[Plan].output.repo_name, \" was not in \", $activity[Plan].output.repo_url, \"; removed its registry entries.\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://CleanupResponse"
                },
                "output": {
                  "output": "schema://CleanupResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildKept",
            "name": "BuildKept",
            "description": "Cleanup result: repository kept on GitHub",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "repo_name": "=$activity[Plan].output.repo_name",
                    "target_mode": "=$activity[Plan].output.target_mode",
                    "github_url": "=$activity[Plan].output.github_url",
                    "registry_rows": "=$activity[DeleteRowsKept].Output.records[0].registry_rows",
                    "ikd_rows": "=$activity[DeleteRowsKept].Output.records[0].ikd_rows",
                    "folder_removed": false,
                    "commit_sha": "",
                    "message": "=string.concat(\"Repository \", $activity[Plan].output.github_url, \" was created on its own and stays on GitHub; delete or archive it there if it is no longer needed. Its registry entries were removed.\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://CleanupResponse"
                },
                "output": {
                  "output": "schema://CleanupResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnRemoved",
            "name": "ReturnRemoved",
            "description": "Returns the cleanup result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[BuildRemoved].output"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ReturnKept",
            "name": "ReturnKept",
            "description": "Returns the cleanup result",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[BuildKept].output"
                    }
                  }
                }
              }
            }
          }
