            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetTemplates",
            "name": "GetTemplates",
            "description": "Reads the cached template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "APP_CONFIG",
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}, \"description\": {\"type\": \"string\"}, \"source_protocols\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"target_protocols\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"interface_types\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"keywords\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"text\": {\"type\": \"string\"}}}}, \"template_ids\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}, \"description\": {\"type\": \"string\"}, \"source_protocols\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"target_protocols\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"interface_types\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"keywords\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"text\": {\"type\": \"string\"}}}}, \"template_ids\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildListResult",
            "name": "BuildListResult",
            "description": "Build the MCP tool response {data,error} from the cached template list.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "response": {
                      "data": "=coerce.toString($activity[GetTemplates].output.data)",
                      "error": ""
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"response\": {\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
