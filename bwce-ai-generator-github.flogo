    {
      "id": "flow:codereview_history_GET",
      "data": {
        "name": "codereview_history_GET",
        "description": "Code review history, newest first (GET /api/codereview/history)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadHistory",
            "type": "label",
            "label": "StartActivity to ReadHistory"
          },
          {
            "id": 2,
            "from": "ReadHistory",
            "to": "ReturnHistory",
            "type": "label",
            "label": "ReadHistory to ReturnHistory"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT json_build_object('count', count(*), 'entries', COALESCE(json_agg(json_build_object('timestamp', to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'), 'repoName', repo_name, 'productName', product_name, 'version', version, 'checkbwdesign', checkbwdesign, 'status', status, 'error', error, 'master_html', master_html, 'app_html', app_html, 'links', links) ORDER BY id DESC), '[]'::json))::text AS doc FROM public.code_review_history",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [],
                "RuntimeQuery": "",
                "State": "a8a59859-1c02-550d-b2d3-caf1285cefbfSELECT json_build_object('count', count(*), 'entries', COALESCE(json_agg(json_build_object('timestamp', to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'), 'repoName', repo_name, 'productName', product_name, 'version', version, 'checkbwdesign', checkbwdesign, 'status', status, 'error', error, 'master_html', master_html, 'app_html', app_html, 'links', links) ORDER BY id DESC), '[]'::json))::text AS doc FROM public.code_review_history"
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "ReadHistory",
            "name": "ReadHistory",
            "description": "ReadHistory"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=coerce.toObject($activity[ReadHistory].Output.records[0].doc)"
                    }
                  }
                }
              }
            },
            "id": "ReturnHistory",
            "name": "ReturnHistory",
            "description": "ReturnHistory"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIlJlYWRIaXN0b3J5Ijp7IngiOjI1MCwieSI6NDV9LCJSZXR1cm5IaXN0b3J5Ijp7IngiOjQ1MCwieSI6NDV9fQ==",
        "metadata": {
