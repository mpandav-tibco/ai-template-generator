          }
        }
      }
    },
    {
      "id": "flow:StartupFlow",
      "data": {
        "name": "StartupFlow",
        "description": "Application bootstrap flow. Loads the template registry and alias mappings from disk into shared memory and initializes the PostgreSQL schema.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadTemplateRegistry",
            "type": "label",
            "label": "StartActivity to ReadTemplateRegistry"
          },
          {
            "id": 2,
            "from": "ReadTemplateRegistry",
            "to": "ParseTemplateRegistry",
            "type": "label",
            "label": " vc "
          },
          {
            "id": 3,
            "from": "ParseTemplateRegistry",
            "to": "ReadAliasMappings",
            "type": "label",
            "label": "ParseTemplateRegistry to ReadAliasMappings"
          },
          {
            "id": 4,
            "from": "ReadAliasMappings",
            "to": "ParseAliasMappings",
            "type": "label",
            "label": "ReadAliasMappings to ParseAliasMappings"
          },
          {
            "id": 5,
            "from": "ParseAliasMappings",
            "to": "StoreConfigToSharedData",
            "type": "label",
            "label": "ParseAliasMappings to StoreConfigToSharedData"
          },
          {
            "id": 6,
            "from": "StoreConfigToSharedData",
            "to": "StoreAliasesToSharedData",
            "type": "label",
            "label": "StoreConfigToSharedData to SetupDatabase"
          },
          {
            "id": 7,
            "from": "StoreAliasesToSharedData",
            "to": "SetupDatabase",
            "type": "label",
            "label": "StoreAliasesToSharedData to SetupDatabase"
          },
          {
            "id": 8,
            "from": "SetupDatabase",
            "to": "IngestTemplatesToVectorDB",
            "type": "label",
            "label": "SetupDatabase to IngestTemplatesToVectorDB"
          },
          {
            "id": 9,
            "from": "IngestTemplatesToVectorDB",
            "to": "ReadIKDInterfaces",
            "type": "label",
            "label": "IngestTemplatesToVectorDB to ReadIKDInterfaces"
          },
          {
            "id": 10,
            "from": "ReadIKDInterfaces",
            "to": "ParseIKDInterfaces",
            "type": "label",
            "label": "ReadIKDInterfaces to ParseIKDInterfaces"
          },
          {
            "id": 11,
            "from": "ParseIKDInterfaces",
            "to": "StoreIKDInterfaces",
            "type": "label",
            "label": "ParseIKDInterfaces to StoreIKDInterfaces"
          },
          {
            "id": 12,
            "from": "StoreIKDInterfaces",
            "to": "ReadIKDScenarios",
            "type": "label",
            "label": "StoreIKDInterfaces to ReadIKDScenarios"
          },
          {
            "id": 13,
            "from": "ReadIKDScenarios",
            "to": "ParseIKDScenarios",
            "type": "label",
            "label": "ReadIKDScenarios to ParseIKDScenarios"
          },
          {
            "id": 14,
            "from": "ParseIKDScenarios",
            "to": "StoreIKDScenarios",
            "type": "label",
            "label": "ParseIKDScenarios to StoreIKDScenarios"
          },
          {
            "id": 15,
            "from": "StoreIKDScenarios",
            "to": "ReadOps",
            "type": "label",
            "label": "StoreIKDScenarios to ReadOps"
          },
          {
            "id": 16,
            "from": "ReadOps",
            "to": "ParseOps",
            "type": "label",
            "label": "ReadOps to ParseOps"
          },
          {
            "id": 17,
            "from": "ParseOps",
            "to": "StoreOps",
            "type": "label",
            "label": "ParseOps to StoreOps"
          },
          {
            "id": 18,
            "from": "StoreOps",
            "to": "StoreAuth",
            "type": "label",
            "label": "StoreOps to StoreAuth"
          },
          {
            "id": 19,
            "from": "StoreAuth",
            "to": "K8sConfig",
            "type": "label",
            "label": "StoreAuth to K8sConfig"
          },
          {
            "id": 20,
            "from": "K8sConfig",
            "to": "K8sInit",
            "type": "label",
            "label": "K8sConfig to K8sInit"
          },
          {
            "id": 21,
            "from": "K8sInit",
            "to": "StoreK8s",
            "type": "label",
            "label": "K8sInit to StoreK8s"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadTemplateRegistry",
            "name": "ReadTemplateRegistry",
            "description": "Reads the template registry JSON file from disk.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"TEMPLATE_REGISTRY\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseTemplateRegistry",
            "name": "ParseTemplateRegistry",
            "description": "Parses the template registry JSON into an object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadTemplateRegistry].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "ReadAliasMappings",
            "name": "ReadAliasMappings",
            "description": "Reads the provider/protocol alias-mappings JSON file from disk.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"ALIAS_MAPPINGS\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseAliasMappings",
            "name": "ParseAliasMappings",
            "description": "Parses the alias mappings JSON into an object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadAliasMappings].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreConfigToSharedData",
            "name": "StoreConfigToSharedData",
            "description": "Caches the template registry in shared memory under APP_CONFIG.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_CONFIG\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseTemplateRegistry].jsonObject"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://AppConfig"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "StoreAliasesToSharedData",
            "name": "StoreAliasesToSharedData",
            "description": "Caches the alias mappings in shared memory under APP_ALIASES.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_ALIASES\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseAliasMappings].jsonObject"
                  }
                }
              }
            }
          },
          {
            "id": "SetupDatabase",
            "name": "SetupDatabase",
            "description": "Invokes the SetupDatabaseFlow subflow to initialize the PostgreSQL schema.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:SetupDatabaseFlow",
                "detached": false,
                "execTimeout": 0
              }
            }
          },
          {
            "id": "IngestTemplatesToVectorDB",
            "name": "IngestTemplatesToVectorDB",
            "description": "Invokes the TemplateIngestionFlow subflow to load BWCE templates into the Weaviate vector database so semantic template selection has data to search.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:TemplateIngestionFlow",
                "detached": false,
                "execTimeout": 0
              }
            }
          },
          {
            "id": "ReadIKDInterfaces",
            "name": "ReadIKDInterfaces",
            "description": "Reads the IKD interface-ID registry (JSON array of valid IKD interface identifiers) from disk during startup.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"IKD_INTERFACES_FILE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseIKDInterfaces",
            "name": "ParseIKDInterfaces",
            "description": "Parses the IKD interface-ID registry text into a JSON array.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadIKDInterfaces].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreIKDInterfaces",
            "name": "StoreIKDInterfaces",
            "description": "Caches the valid IKD interface IDs in application shared data (APP_IKD_INTERFACES) for fast cross-checking during generation.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "array"
              },
              "input": {
                "key": "\"APP_IKD_INTERFACES\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseIKDInterfaces].jsonObject"
                  }
                }
              }
            }
          },
          {
            "id": "ReadIKDScenarios",
            "name": "ReadIKDScenarios",
            "description": "Reads the IKD scenario-ID registry (JSON array of valid IKD scenario identifiers) from disk during startup.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"IKD_SCENARIOS_FILE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseIKDScenarios",
            "name": "ParseIKDScenarios",
            "description": "Parses the IKD scenario-ID registry text into a JSON array.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadIKDScenarios].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreIKDScenarios",
            "name": "StoreIKDScenarios",
            "description": "Caches the valid IKD scenario IDs in application shared data (APP_IKD_SCENARIOS) for fast cross-checking during generation.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "array"
              },
              "input": {
                "key": "\"APP_IKD_SCENARIOS\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseIKDScenarios].jsonObject"
                  }
                }
              }
            }
          },
          {
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"OPS_PROGRAMS\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            },
            "id": "ReadOps",
            "name": "ReadOps",
            "description": "Reads the operations programs (jq) and CI/CD templates"
          },
          {
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadOps].output.fileContent.textContent"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {}}"
                  }
                }
              }
            },
            "id": "ParseOps",
            "name": "ParseOps",
            "description": "ParseOps"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseOps].jsonObject"
                  }
                }
              }
            },
            "id": "StoreOps",
            "name": "StoreOps",
            "description": "StoreOps"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_AUTH\"",
                "input": {
                  "mapping": {
                    "data": {
                      "signing_key": "=$property[\"SESSION_SIGNING_KEY\"] != \"\" ? $property[\"SESSION_SIGNING_KEY\"] : string.concat(utils.uuid(), utils.uuid())"
                    }
                  }
                }
              }
            },
            "id": "StoreAuth",
            "name": "StoreAuth",
            "description": "Session signing key: SESSION_SIGNING_KEY or a random per-process key"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "contexts_json": "=$property[\"K8S_CONTEXTS\"]",
                    "name": "=$property[\"K8S_CONTEXT\"]"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"contexts_json\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"contexts_json\": {\"type\": \"string\"}, \"name\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "id": "K8sConfig",
            "name": "K8sConfig",
            "description": "K8sConfig"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "state": "=array.get(json.jq($activity[K8sConfig].output, $activity[ParseOps].jsonObject.k8s.init), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"state\": {\"type\": \"object\", \"properties\": {\"contexts\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"state\": {\"type\": \"object\", \"properties\": {\"contexts\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              }
            },
            "id": "K8sInit",
            "name": "K8sInit",
            "description": "K8sInit"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_K8S\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[K8sInit].output.state"
                  }
                }
              }
            },
            "id": "StoreK8s",
            "name": "StoreK8s",
            "description": "StoreK8s"
          }
        ],
