                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"password\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"password\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Lookup",
            "name": "Lookup",
            "description": "Account, failed attempts and password check in one row (constant-time for unknown users)"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "row": "=coerce.toObject($activity[Lookup].Output.records[0].doc)",
                    "max": "=$property[\"AUTH_LOGIN_MAX_ATTEMPTS\"]",
                    "lockout": "=$property[\"AUTH_LOGIN_LOCKOUT_SECONDS\"]",
                    "username": "=$activity[ReadLogin].output.b.username",
                    "ttl": "=$property[\"SESSION_TTL_SECONDS\"]",
                    "secure": "=$property[\"HTTPS_ENABLED\"]",
                    "jti": "=utils.uuid()"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"row\": {\"type\": \"object\", \"properties\": {}}, \"max\": {\"type\": \"number\"}, \"lockout\": {\"type\": \"number\"}, \"username\": {\"type\": \"string\"}, \"ttl\": {\"type\": \"number\"}, \"secure\": {\"type\": \"boolean\"}, \"jti\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"row\": {\"type\": \"object\", \"properties\": {}}, \"max\": {\"type\": \"number\"}, \"lockout\": {\"type\": \"number\"}, \"username\": {\"type\": \"string\"}, \"ttl\": {\"type\": \"number\"}, \"secure\": {\"type\": \"boolean\"}, \"jti\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "id": "DecideIn",
            "name": "DecideIn",
            "description": "DecideIn"
          },
