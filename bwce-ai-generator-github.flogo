            "name": "Sign",
            "description": "Sign"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:WriteAudit",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "username": "=$activity[Decide].output.d.username",
                "display_name": "=$activity[Decide].output.d.display_name",
                "role": "=$activity[Decide].output.d.role",
