    {
      "id": "flow:K8sOperation",
      "data": {
        "name": "K8sOperation",
        "description": "Runs one Kubernetes operation: resolves the route to the operation, plans the API calls, calls the Kubernetes API and returns a kubectl-style response",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "GetK8s",
            "type": "label",
            "label": "GetOps to GetK8s"
          },
          {
            "id": 3,
            "from": "GetK8s",
            "to": "Facts",
            "type": "label",
            "label": "GetK8s to Facts"
          },
          {
            "id": 4,
            "from": "Facts",
            "to": "Plan",
            "type": "label",
            "label": "Facts to Plan"
          },
          {
            "id": 5,
            "from": "Plan",
            "to": "PlanError",
            "type": "expression",
            "label": "Plan to PlanError",
            "value": "$activity[Plan].output.plan.mode == \"error\""
          },
          {
            "id": 6,
            "from": "Plan",
            "to": "StoreK8s",
            "type": "expression",
            "label": "Plan to StoreK8s",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $activity[Plan].output.plan.op == \"switch\""
          },
          {
            "id": 7,
            "from": "Plan",
            "to": "ReturnImmediate",
            "type": "expression",
            "label": "Plan to ReturnImmediate",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $activity[Plan].output.plan.op != \"switch\""
          },
          {
            "id": 8,
            "from": "Plan",
            "to": "Fetch",
            "type": "expression",
            "label": "Plan to Fetch",
            "value": "$activity[Plan].output.plan.mode == \"fetch\""
          },
          {
            "id": 9,
            "from": "StoreK8s",
            "to": "ReturnImmediate",
            "type": "label",
            "label": "StoreK8s to ReturnImmediate"
          },
          {
            "id": 10,
            "from": "Fetch",
            "to": "Collect",
            "type": "label",
            "label": "Fetch to Collect"
          },
          {
            "id": 11,
            "from": "Collect",
            "to": "Transform",
            "type": "label",
            "label": "Collect to Transform"
          },
          {
            "id": 12,
            "from": "Transform",
            "to": "ReturnOp",
            "type": "label",
            "label": "Transform to ReturnOp"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_K8S\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetK8s",
            "name": "GetK8s",
            "description": "GetK8s"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "route": "=$flow.route",
                    "query": "=$flow.query",
                    "params": "=$flow.params",
                    "body": "=$flow.content",
                    "ctx": "=$activity[GetK8s].output.data.active",
                    "contexts": "=$activity[GetK8s].output.data.contexts",
                    "k8s": "=$activity[GetOps].output.data.k8s"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"route\": {\"type\": \"string\"}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"ctx\": {\"type\": \"object\", \"properties\": {}}, \"contexts\": {\"type\": \"object\", \"properties\": {}}, \"k8s\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"route\": {\"type\": \"string\"}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"ctx\": {\"type\": \"object\", \"properties\": {}}, \"contexts\": {\"type\": \"object\", \"properties\": {}}, \"k8s\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
            "id": "Facts",
            "name": "Facts",
            "description": "Facts"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "plan": "=array.get(json.jq($activity[Facts].output, $activity[GetOps].output.data.k8s.route), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"plan\": {\"type\": \"object\", \"properties\": {\"mode\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}, \"error_body\": {\"type\": \"object\", \"properties\": {}}, \"req\": {\"type\": \"object\", \"properties\": {}}, \"program\": {\"type\": \"string\"}, \"immediate\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}, \"calls\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"op\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"plan\": {\"type\": \"object\", \"properties\": {\"mode\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}, \"error_body\": {\"type\": \"object\", \"properties\": {}}, \"req\": {\"type\": \"object\", \"properties\": {}}, \"program\": {\"type\": \"string\"}, \"immediate\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}, \"calls\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"op\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "Plan",
            "name": "Plan",
            "description": "Plan"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Plan].output.plan.error_code",
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[Plan].output.plan.error_body"
                    }
                  }
                }
              }
            },
            "id": "PlanError",
            "name": "PlanError",
            "description": "PlanError"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_K8S\"",
                "input": {
                  "mapping": {
                    "data": {
                      "contexts": "=$activity[GetK8s].output.data.contexts",
                      "active": "=$activity[Plan].output.plan.active"
                    }
                  }
                }
              }
            },
            "id": "StoreK8s",
            "name": "StoreK8s",
            "description": "Switches the active context"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[Plan].output.plan.immediate"
                    }
                  }
                }
              }
            },
            "id": "ReturnImmediate",
            "name": "ReturnImmediate",
            "description": "ReturnImmediate"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:HttpCall",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "method": "=$iteration[value].method",
                "url": "=$iteration[value].url",
                "headers": "=$iteration[value].headers",
                "body": "=$iteration[value].body",
                "request_type": "=$iteration[value].request_type",
                "insecure": "=$iteration[value].insecure",
                "ca": "=$iteration[value].ca",
                "timeout_ms": "=$iteration[value].timeout_ms"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"insecure\": {\"type\": \"boolean\"}, \"ca\": {\"type\": \"string\"}, \"timeout_ms\": {\"type\": \"integer\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"insecure\": {\"type\": \"boolean\"}, \"ca\": {\"type\": \"string\"}, \"timeout_ms\": {\"type\": \"integer\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "iterate": "=$activity[Plan].output.plan.calls",
              "accumulate": true
            },
            "id": "Fetch",
            "name": "Fetch",
            "description": "Calls the Kubernetes API once per planned request",
            "type": "iterator"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "r": "=$activity[Fetch]",
                    "req": "=$activity[Plan].output.plan.req"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"r\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"req\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"r\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"req\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
            "id": "Collect",
            "name": "Collect",
            "description": "Collect"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "out": "=array.get(json.jq($activity[Collect].output, $activity[Plan].output.plan.program), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"out\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"out\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              }
            },
            "id": "Transform",
            "name": "Transform",
            "description": "Transform"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Transform].output.out.code",
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[Transform].output.out.body"
                    }
                  }
                }
              }
            },
            "id": "ReturnOp",
            "name": "ReturnOp",
            "description": "ReturnOp"
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "route",
              "type": "string"
            },
            {
              "name": "content",
              "type": "object"
            },
            {
              "name": "query",
              "type": "object"
            },
            {
              "name": "params",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "output": "{\"type\": \"object\", \"title\": \"Outputs\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        }
      }
