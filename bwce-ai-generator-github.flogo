    {
      "id": "flow:api_tracker_GET",
      "data": {
        "name": "api_tracker_GET",
        "description": "Lists generated repositories from the generation registry (GET /api/tracker)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "QueryTracker",
            "type": "label",
            "label": "StartActivity to QueryTracker"
          },
          {
            "id": 2,
            "from": "QueryTracker",
            "to": "ReplyTracker",
            "type": "label",
            "label": "QueryTracker to ReplyTracker"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT generation_id, repo_name, template_name, template_type, source_system, target_system, business_object, interface_type, env, interface_id, scenario_id, bitbucket_project, status, created_at FROM public.generation_log ORDER BY created_at DESC LIMIT 100",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [],
                "RuntimeQuery": "",
                "State": "8a043619-f6d5-58a1-bb3d-81afdccc81e7SELECT generation_id, repo_name, template_name, template_type, source_system, target_system, business_object, interface_type, env, interface_id, scenario_id, bitbucket_project, status, created_at FROM public.generation_log ORDER BY created_at DESC LIMIT 100"
              },
              "ref": "#query",
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "QueryTracker",
            "name": "QueryTracker",
            "description": "Latest 100 generations"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "records": "=$activity[QueryTracker].Output.records",
                        "target_repo_url": "=$property[\"TARGET_REPO_URL\"]",
                        "target_branch": "=$property[\"TARGET_BRANCH\"]",
                        "target_mode": "=$property[\"TARGET_MODE\"]"
                      }
                    }
                  }
                }
              }
            },
            "id": "ReplyTracker",
            "name": "ReplyTracker",
            "description": "Returns the registry rows"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIlF1ZXJ5VHJhY2tlciI6eyJ4IjoyNTAsInkiOjQ1fSwiUmVwbHlUcmFja2VyIjp7IngiOjQ1MCwieSI6NDV9fQ==",
        "metadata": {
