          {
            "id": 17,
            "from": "Run2Plan",
            "to": "Attempt2",
            "type": "label",
            "label": "Run2Plan to Attempt2"
          },
          {
            "id": 18,
            "from": "HistOk",
            "to": "ReturnRun",
            "type": "label",
            "label": "HistOk to ReturnRun"
          },
          {
            "id": 19,
            "from": "HistFail",
            "to": "ReturnRunError",
            "type": "label",
            "label": "HistFail to ReturnRunError"
          },
          {
            "id": 20,
            "from": "Attempt2",
            "to": "Outcome",
            "type": "label",
            "label": "Attempt2 to Outcome"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
