                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"insecure\": {\"type\": \"boolean\"}, \"ca\": {\"type\": \"string\"}, \"timeout_ms\": {\"type\": \"integer\"}}}"
