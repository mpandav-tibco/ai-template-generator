    {
      "id": "flow:SendNotificationFlow",
      "data": {
        "name": "SendNotificationFlow",
        "description": "Builds the rich HTML email (full-repo vs config-only variant) with the inline brand logo and doc attachment, and sends it via SMTP to the core integration team.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildEmailParts",
            "type": "label",
            "label": "StartActivity to BuildEmailParts"
          },
          {
            "id": 2,
            "from": "BuildEmailParts",
            "to": "BuildEmailAttachment",
            "type": "label",
            "label": "BuildEmailParts to BuildEmailAttachment"
          },
          {
            "id": 3,
            "from": "BuildEmailAttachment",
            "to": "SendNotification",
            "type": "label",
            "label": "BuildEmailAttachment to SendNotification"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildEmailParts",
            "name": "BuildEmailParts",
            "description": "Pre-builds both notification variants (full repo vs config-only) as complete plain-concat strings: message, subject and the doc-attachment file/name. The downstream mapper then selects per config_only with simple ref-only ternaries (Flogo cannot parse a ternary whose branch is a function call).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "message_full": "=string.concat(\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='color-scheme' content='light dark'><meta name='supported-color-schemes' content='light dark'></head><body style='margin:0;padding:0;background:#eef1f6'><div style='display:none;max-height:0;overflow:hidden;mso-hide:all;opacity:0;color:#eef1f6;font-size:1px;line-height:1px'>New repository scaffolded &mdash; \", $flow.repo_name, \"</div><div style='margin:0;padding:24px 12px;background:#eef1f6;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif'><table role='presentation' align='center' width='600' cellpadding='0' cellspacing='0' style='max-width:600px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0'><tr><td style='background:#0b1f3a;padding:22px 28px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0'><tr><td style='vertical-align:middle;width:44px'><img src='cid:email-logo.png' width='44' height='44' alt='BWCE AI' style='display:block;width:44px;height:44px;border-radius:10px' /></td><td style='vertical-align:middle;padding-left:14px'><div style='color:#ffffff;font-size:18px;font-weight:700;letter-spacing:0.2px'>BWCE AI Generator</div><div style='color:#9fb3c8;font-size:12px;margin-top:2px'>New integration repository scaffolded</div></td></tr></table></td></tr><tr><td style='height:3px;background:#00e0a4;line-height:3px;font-size:0'>&nbsp;</td></tr><tr><td style='padding:22px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#e6f9f2;border:1px solid #00b386;border-radius:10px'><tr><td style='padding:13px 16px;color:#04694f;font-size:14px;font-weight:600'>&#10003;&nbsp; Repository generated and registered successfully.</td></tr></table></td></tr><tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em'>Repository</div><div style='font-family:Consolas,Menlo,monospace;font-size:20px;font-weight:700;color:#0b1f3a;margin-top:5px;word-break:break-all'>\", $flow.repo_name, \"</div></td></tr><tr><td style='padding:18px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;border-collapse:collapse'>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Template</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.template_name, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Source &rarr; Target</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6'>\", $flow.source_system, \" &rarr; \", $flow.target_system, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Business Object</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.business_object, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Interface Type</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.interface_type, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Environment</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.env, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>CDM</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", coerce.toString($flow.cdm), \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;width:42%'>Template Match Score</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;'>\", coerce.toString($flow.match_score), \"</td></tr>\", \"</table></td></tr>\", \"<tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px'>Clone</div><div style='background:#0a0c10;border-radius:8px;padding:12px 14px;font-family:Consolas,Menlo,monospace;font-size:12.5px;color:#00e0a4;word-break:break-all'>git clone \", $flow.clone_url, \"</div></td></tr><tr><td style='padding:18px 28px 26px'><a href='\", $flow.github_url, \"' style='display:inline-block;background:#00b386;color:#ffffff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 24px;border-radius:8px'>Open in GitHub &rarr;</a></td></tr>\", \"<tr><td style='background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 28px;color:#94a3b8;font-size:11px;line-height:1.6'>Generation ID: \", $flow.generation_id, \"<br />Automated notification from the BWCE AI Integration Generator</td></tr></table><div style='text-align:center;color:#b4c0cf;font-size:11px;padding:14px 0 2px'>adidas &middot; Core Integration Platform</div></div></body></html>\")",
                    "message_config": "=string.concat(\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='color-scheme' content='light dark'><meta name='supported-color-schemes' content='light dark'></head><body style='margin:0;padding:0;background:#eef1f6'><div style='display:none;max-height:0;overflow:hidden;mso-hide:all;opacity:0;color:#eef1f6;font-size:1px;line-height:1px'>Config-only generation complete &mdash; \", $flow.repo_name, \"</div><div style='margin:0;padding:24px 12px;background:#eef1f6;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif'><table role='presentation' align='center' width='600' cellpadding='0' cellspacing='0' style='max-width:600px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0'><tr><td style='background:#0b1f3a;padding:22px 28px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0'><tr><td style='vertical-align:middle;width:44px'><img src='cid:email-logo.png' width='44' height='44' alt='BWCE AI' style='display:block;width:44px;height:44px;border-radius:10px' /></td><td style='vertical-align:middle;padding-left:14px'><div style='color:#ffffff;font-size:18px;font-weight:700;letter-spacing:0.2px'>BWCE AI Generator</div><div style='color:#9fb3c8;font-size:12px;margin-top:2px'>Config-only generation &middot; scaffold skipped</div></td></tr></table></td></tr><tr><td style='height:3px;background:#00e0a4;line-height:3px;font-size:0'>&nbsp;</td></tr><tr><td style='padding:22px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#e6f9f2;border:1px solid #00b386;border-radius:10px'><tr><td style='padding:13px 16px;color:#04694f;font-size:14px;font-weight:600'>&#10003;&nbsp; Configuration generated successfully (config-only).</td></tr></table></td></tr><tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em'>Repository (name reserved)</div><div style='font-family:Consolas,Menlo,monospace;font-size:20px;font-weight:700;color:#0b1f3a;margin-top:5px;word-break:break-all'>\", $flow.repo_name, \"</div></td></tr><tr><td style='padding:18px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;border-collapse:collapse'>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Template</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.template_name, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Source &rarr; Target</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6'>\", $flow.source_system, \" &rarr; \", $flow.target_system, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Business Object</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.business_object, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Interface Type</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.interface_type, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Environment</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.env, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>CDM</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", coerce.toString($flow.cdm), \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;width:42%'>Template Match Score</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;'>\", coerce.toString($flow.match_score), \"</td></tr>\", \"</table></td></tr>\", \"<tr><td style='padding:20px 28px 26px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#fff7ed;border:1px solid #fdba74;border-radius:10px'><tr><td style='padding:13px 16px;color:#9a3412;font-size:13px;line-height:1.55'><strong>Config-only run.</strong> Application code was left untouched. <strong>configs/generation.properties</strong> and <strong>configs/generation-metadata.json</strong> were refreshed in GitHub: \", $flow.github_url, \"</td></tr></table></td></tr>\", \"<tr><td style='background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 28px;color:#94a3b8;font-size:11px;line-height:1.6'>Generation ID: \", $flow.generation_id, \"<br />Automated notification from the BWCE AI Integration Generator</td></tr></table><div style='text-align:center;color:#b4c0cf;font-size:11px;padding:14px 0 2px'>adidas &middot; Core Integration Platform</div></div></body></html>\")",
                    "subject_full": "=string.concat(\"✅ [BWCE AI Generator] New repository: \", $flow.repo_name)",
                    "subject_config": "=string.concat(\"✅ [BWCE AI Generator] Config generated: \", $flow.repo_name)"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildEmailAttachment",
            "name": "BuildEmailAttachment",
            "description": "Selects the notification variant (full repo vs config-only) for subject, HTML body and the doc attachment via ref-only ternaries on config_only, and adds the inline CID brand logo attachment.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "subject": "=$flow.config_only == true ? $activity[BuildEmailParts].output.subject_config : $activity[BuildEmailParts].output.subject_full",
                    "message": "=$flow.config_only == true ? $activity[BuildEmailParts].output.message_config : $activity[BuildEmailParts].output.message_full",
                    "attachments": [
                      {
                        "file": "=string.concat(\"file://\", $property[\"BRAND_LOGO_FILE\"])",
                        "filename": "email-logo.png",
                        "inline": true,
                        "base64EncodedContents": false
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "SendNotification",
            "name": "SendNotification",
            "description": "Sends an email notification (via the configured SMTP server / maildev mock) to the core integration team announcing the newly scaffolded repository.",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 2000
              }
            },
            "activity": {
              "ref": "#sendmail",
              "input": {
                "Server": "=$property[\"SMTP_HOST\"]",
                "Port": "=$property[\"SMTP_PORT\"]",
                "authorizationType": "Basic",
                "Username": "",
                "Password": "",
                "Connection Security": "NONE",
                "message_content_type": "text/html",
                "sender": "=$property[\"NOTIFY_SENDER\"]",
                "recipients": "=$property[\"NOTIFY_RECIPIENTS\"]",
                "cc_recipients": "",
                "bcc_recipients": "",
                "reply_to": "",
                "subject": "=$activity[BuildEmailAttachment].output.subject",
                "message": "=$activity[BuildEmailAttachment].output.message",
                "attachments": "=$activity[BuildEmailAttachment].output.attachments"
              },
              "schemas": {
                "input": {
                  "attachments": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkJ1aWxkRW1haWxQYXJ0cyI6eyJ4IjoyNTAsInkiOjQ1fSwiQnVpbGRFbWFpbEF0dGFjaG1lbnQiOnsieCI6NDUwLCJ5Ijo0NX0sIlNlbmROb3RpZmljYXRpb24iOnsieCI6NjUwLCJ5Ijo0NX19",
        "metadata": {
