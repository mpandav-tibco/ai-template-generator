            "name": "ReturnBad",
            "description": "ReturnBad",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Plan].output.p.error_code",
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=$activity[Plan].output.p.error"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "FindRepo",
            "name": "FindRepo",
            "description": "The repository must have been generated (its template is needed for the commit)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT template_name, github_url, target_mode FROM public.generation_log WHERE repo_name = ?repo ORDER BY created_at DESC LIMIT 1",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "template_name",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "github_url",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "target_mode",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "fd648c4e-22ae-5384-95bf-2b2d29015b29SELECT template_name, github_url, target_mode FROM public.generation_log WHERE repo_name = ?repo ORDER BY created_at DESC LIMIT 1",
                "input": {
                  "mapping": {
                    "parameters": {
                      "repo": "=$activity[Plan].output.p.repo"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnUnknown",
            "name": "ReturnUnknown",
            "description": "ReturnUnknown",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 404,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=string.concat(\"Repository \", $activity[Plan].output.p.repo, \" has not been generated yet.\")"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "CheckXml",
            "name": "CheckXml",
            "description": "Every uploaded file must be well-formed XML",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[Plan].output.p.xml",
              "accumulate": true
            },
            "activity": {
              "ref": "#xmltojson",
              "input": {
                "xmlString": "=$iteration[value]",
                "ordered": false,
                "typeCast": false
              }
            }
          },
          {
            "id": "ReturnInvalidXml",
            "name": "ReturnInvalidXml",
            "description": "ReturnInvalidXml",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=string.concat(\"Invalid XML in the uploaded file: \", $error[CheckXml].message)"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Commit",
            "name": "Commit",
            "description": "Commits only the schema files (template files excluded) in one commit",
            "activity": {
              "ref": "#gitreposcaffolder",
              "input": {
                "authToken": "=$property[\"GITHUB_TOKEN\"]",
                "templateRepoURL": "=$property[\"TEMPLATE_REPO_URL\"]",
                "templateRef": "=$property[\"TEMPLATE_REF\"]",
                "templatePath": "=$activity[FindRepo].Output.records[0].template_name",
                "ignoreEmptyValues": false,
                "replacementMode": "sequential",
                "renamePaths": true,
                "maxTextBytes": 5242880,
                "outputPrefix": "",
                "targetMode": "=(coerce.toString($activity[FindRepo].Output.records[0].target_mode) != \"\") ? coerce.toString($activity[FindRepo].Output.records[0].target_mode) : $property[\"TARGET_MODE\"]",
                "targetRepoURL": "=(string.contains(coerce.toString($activity[FindRepo].Output.records[0].github_url), \"/tree/\")) ? string.substringBefore(coerce.toString($activity[FindRepo].Output.records[0].github_url), \"/tree/\") : ((coerce.toString($activity[FindRepo].Output.records[0].github_url) != \"\") ? coerce.toString($activity[FindRepo].Output.records[0].github_url) : (($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $activity[Plan].output.p.repo) : $property[\"TARGET_REPO_URL\"]))",
                "targetBranch": "=(string.contains(coerce.toString($activity[FindRepo].Output.records[0].github_url), \"/tree/\")) ? string.substringBefore(string.substringAfter(coerce.toString($activity[FindRepo].Output.records[0].github_url), \"/tree/\"), string.concat(\"/\", $activity[Plan].output.p.repo)) : $property[\"TARGET_BRANCH\"]",
                "targetFolder": "=(coerce.toString($activity[FindRepo].Output.records[0].target_mode) == \"newRepo\") ? \"\" : ((coerce.toString($activity[FindRepo].Output.records[0].target_mode) == \"subfolder\") ? $activity[Plan].output.p.repo : (($property[\"TARGET_MODE\"] == \"newRepo\") ? \"\" : $activity[Plan].output.p.repo))",
                "cleanTargetFolder": false,
                "newRepoPrivate": true,
                "newRepoDescription": "=string.concat(\"BWCE integration \", $activity[Plan].output.p.repo)",
                "failIfRepoExists": false,
                "apiBaseURL": "=$property[\"GITHUB_API_URL\"]",
                "commitMessage": "=string.concat(\"Upload schemas: \", $activity[Plan].output.p.repo)",
                "authorName": "=$property[\"GIT_AUTHOR_NAME\"]",
                "authorEmail": "=$property[\"GIT_AUTHOR_EMAIL\"]",
                "dryRun": false,
                "pushRetries": 3,
                "writeStrategy": "auto",
                "timeoutSeconds": 120,
                "replacementList": {
                  "mapping": []
                },
                "excludePatterns": {
                  "mapping": [
                    "*"
                  ]
                },
                "binaryExtensions": {
                  "mapping": []
                },
                "extraFiles": "=$activity[Plan].output.p.files"
              }
            }
          },
          {
            "id": "ReturnDone",
            "name": "ReturnDone",
            "description": "ReturnDone",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "success": true,
                        "repository_name": "=$activity[Plan].output.p.repo",
                        "uploaded_files": "=$activity[Plan].output.p.uploaded_files",
                        "message": "=$activity[Plan].output.p.message",
                        "commit_sha": "=$activity[Commit].commitSHA",
                        "pushed": "=$activity[Commit].pushed",
                        "github_url": "=$activity[Commit].folderURL"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [
            {
              "name": "op",
              "type": "string"
            },
            {
              "name": "content",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"op\": {\"type\": \"string\"}, \"content\": {\"type\": \"object\", \"properties\": {}}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:ikd_GET",
      "data": {
        "name": "ikd_GET",
        "description": "IKD registry export in the reference file format (GET /api/ikd?kind=InterfaceIDs|ScenarioIDs)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ExportIKD",
            "type": "label",
            "label": "StartActivity to ExportIKD"
          },
          {
            "id": 2,
            "from": "ExportIKD",
            "to": "ReturnIKD",
            "type": "label",
            "label": "ExportIKD to ReturnIKD"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ExportIKD",
            "name": "ExportIKD",
            "description": "ExportIKD",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT COALESCE(string_agg(ikd_value || ':' || repo_name || chr(10), '' ORDER BY updated_at, repo_name), '') AS text FROM public.ikd_registry WHERE kind = ?kind",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "kind",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "text",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "8c924913-96f6-51eb-85fa-8bce624f59feSELECT COALESCE(string_agg(ikd_value || ':' || repo_name || chr(10), '' ORDER BY updated_at, repo_name), '') AS text FROM public.ikd_registry WHERE kind = ?kind",
                "input": {
                  "mapping": {
                    "parameters": {
                      "kind": "=coerce.toString($flow.kind)"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"text\": {\"type\": \"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnIKD",
            "name": "ReturnIKD",
            "description": "ReturnIKD",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[ExportIKD].Output.records[0].text",
                      "headers": {
                        "Content-Type": "text/plain; charset=UTF-8"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkV4cG9ydElLRCI6eyJ4IjoyNTAsInkiOjQ1fSwiUmV0dXJuSUtEIjp7IngiOjQ1MCwieSI6NDV9fQ==",
        "metadata": {
          "input": [
            {
              "name": "kind",
              "type": "string"
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:ExtractSpecCore",
      "data": {
        "name": "ExtractSpecCore",
        "description": "NLU extraction shared by /extract and the chat: rules pre-extraction, LLM, JSON clean-up",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "RegexPreExtract",
            "type": "label",
            "label": "StartActivity to RegexPreExtract"
          },
          {
            "id": 2,
            "from": "RegexPreExtract",
            "to": "ExtractWithLLM",
            "type": "label",
            "label": "RegexPreExtract to ExtractWithLLM"
          },
          {
            "id": 3,
            "from": "ExtractWithLLM",
            "to": "CleanJSON",
            "type": "label",
            "label": "ExtractWithLLM to CleanJSON"
          },
          {
            "id": 4,
            "from": "CleanJSON",
            "to": "ParseExtraction",
            "type": "label",
            "label": "CleanJSON to ParseExtraction"
          },
          {
            "id": 5,
            "from": "ParseExtraction",
            "to": "Return",
            "type": "label",
            "label": "ParseExtraction to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "RegexPreExtract",
            "name": "RegexPreExtract",
            "description": "Deterministic regex/NLU pre-extraction: detects high-confidence tokens (IKD IDs, interface verbs, canonical systems, environments) in the raw user message and emits them as signals that anchor the downstream LLM extraction.",
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=coerce.toString($flow.content)",
                "fileName": "rules/nlu-extraction.yaml",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "json",
                "strict": false,
                "disabledRules": {
                  "mapping": []
                },
                "tags": {
                  "mapping": [
                    "nlu"
                  ]
                }
              }
            }
          },
          {
            "id": "ExtractWithLLM",
            "name": "ExtractWithLLM",
            "description": "Uses the Weaviate RAG connector LLM generation to extract a structured integration spec from the free-text message.",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:T9fT53QjdO0Zvprk+rYvs5TgvUAnxg==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0.9999,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": false,
                "hybridAlpha": 0.5,
                "enableLLMGenerate": true,
                "llmProvider": "Ollama",
                "llmBaseURL": "=$property[\"LLM_BASE_URL\"]",
                "llmAPIKey": "",
                "llmModel": "=$property[\"LLM_MODEL\"]",
                "systemPrompt": "=$property[\"EXTRACTION_SYSTEM_PROMPT\"]",
                "maxTokens": 1024,
                "temperature": 0
              },
              "input": {
                "queryText": "=string.concat(coerce.toString($flow.content.message), \" \", coerce.toString($activity[RegexPreExtract].markdown))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 2,
                "systemPrompt": "=$property[\"EXTRACTION_SYSTEM_PROMPT\"]"
              }
            }
          },
          {
            "id": "CleanJSON",
            "name": "CleanJSON",
            "description": "Strips markdown code fences from the LLM answer so it can be parsed as JSON.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "cleaned": "=(string.trim(coerce.toString($flow.content.message), \" \") == \"\") ? \"{}\" : string.replaceAll(string.replaceAll(coerce.toString($activity[ExtractWithLLM].answer), \"```json\", \"\"), \"```\", \"\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseExtraction",
            "name": "ParseExtraction",
            "description": "Parses the cleaned LLM JSON answer into a structured object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[CleanJSON].output.cleaned"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Return",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "extraction": "=$activity[ParseExtraction].jsonObject",
                  "answer": "=$activity[ExtractWithLLM].answer"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIlJlZ2V4UHJlRXh0cmFjdCI6eyJ4IjoyNTAsInkiOjQ1fSwiRXh0cmFjdFdpdGhMTE0iOnsieCI6NDUwLCJ5Ijo0NX0sIkNsZWFuSlNPTiI6eyJ4Ijo2NTAsInkiOjQ1fSwiUGFyc2VFeHRyYWN0aW9uIjp7IngiOjI1MCwieSI6MTk1fSwiUmV0dXJuIjp7IngiOjQ1MCwieSI6MTk1fX0=",
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"message\":{\"type\":\"string\"},\"current_spec\":{\"type\":\"object\",\"properties\":{\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"boolean\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"product_area\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"bw_profile\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"need_secret\":{\"type\":\"boolean\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"github_project\":{\"type\":\"string\"}}}}"
              }
            }
          ],
          "output": [
            {
              "name": "extraction",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"string\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"}}"
              }
            },
            {
              "name": "answer",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"product_area\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"need_secret\": {\"type\": \"boolean\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"github_project\": {\"type\": \"string\"}}}}}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"extraction\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"answer\": {\"type\": \"string\"}}}"
          }
        }
      }
    },
    {
      "id": "flow:K8sOperation",
      "data": {
        "name": "K8sOperation",
        "description": "Runs one Kubernetes operation: resolves the route to the operation, plans the API calls, calls the Kubernetes API and returns a kubectl-style response",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "GetK8s",
            "type": "label",
            "label": "GetOps to GetK8s"
          },
          {
            "id": 3,
            "from": "GetK8s",
            "to": "Facts",
            "type": "label",
            "label": "GetK8s to Facts"
          },
          {
            "id": 4,
            "from": "Facts",
            "to": "Plan",
            "type": "label",
            "label": "Facts to Plan"
          },
          {
            "id": 5,
            "from": "Plan",
            "to": "PlanError",
            "type": "expression",
            "label": "Plan to PlanError",
            "value": "$activity[Plan].output.plan.mode == \"error\""
          },
          {
            "id": 6,
            "from": "Plan",
            "to": "StoreK8s",
            "type": "expression",
            "label": "Plan to StoreK8s",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $activity[Plan].output.plan.op == \"switch\""
          },
          {
            "id": 7,
            "from": "StoreK8s",
            "to": "ReturnImmediate",
            "type": "label",
            "label": "StoreK8s to ReturnImmediate"
          },
          {
            "id": 8,
            "from": "Plan",
            "to": "ReturnImmediate",
            "type": "expression",
            "label": "Plan to ReturnImmediate",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $activity[Plan].output.plan.op != \"switch\""
          },
          {
            "id": 9,
            "from": "Plan",
            "to": "Fetch",
            "type": "expression",
            "label": "Plan to Fetch",
            "value": "$activity[Plan].output.plan.mode == \"fetch\""
          },
          {
            "id": 10,
            "from": "Fetch",
            "to": "Collect",
            "type": "label",
            "label": "Fetch to Collect"
          },
          {
            "id": 11,
            "from": "Collect",
            "to": "Transform",
            "type": "label",
            "label": "Collect to Transform"
          },
          {
            "id": 12,
            "from": "Transform",
            "to": "ReturnOp",
            "type": "label",
            "label": "Transform to ReturnOp"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "APP_OPS",
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
