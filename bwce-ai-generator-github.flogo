                    "isEditable": false
                  },
                  {
                    "FieldName": "unique_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "missing_fields",
                    "Type": "LONGVARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "ready_to_generate",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "31176624-cf06-4f0d-98e4-9e455f85ffd1SELECT session_id, status, source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id, missing_fields, ready_to_generate FROM public.chat_session WHERE session_id = ?session_id;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "session_id": "=$flow.content.session_id"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"string\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"},\"missing_fields\":{\"type\":\"string\"},\"ready_to_generate\":{\"type\":\"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"string\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"},\"missing_fields\":{\"type\":\"string\"},\"ready_to_generate\":{\"type\":\"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "MergeSpec",
            "name": "MergeSpec",
            "description": "Merges newly LLM-extracted fields with the spec stored in the session (extracted value wins when present).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=(array.count($activity[GetSession].Output.records) > 0 && coerce.toString($activity[GetSession].Output.records[0].source_system) != \"\") ? coerce.toString($activity[GetSession].Output.records[0].source_system) : coerce.toString($activity[ExtractSpec].extraction.source_system)",
                    "target_system": "=(array.count($activity[GetSession].Output.records) > 0 && coerce.toString($activity[GetSession].Output.records[0].target_system) != \"\") ? coerce.toString($activity[GetSession].Output.records[0].target_system) : coerce.toString($activity[ExtractSpec].extraction.target_system)",
                    "business_object": "=(array.count($activity[GetSession].Output.records) > 0 && coerce.toString($activity[GetSession].Output.records[0].business_object) != \"\") ? coerce.toString($activity[GetSession].Output.records[0].business_object) : string.trim(string.replaceRegEx(\"\\s+\", string.replaceRegEx(\"(?i)\\b(idocs?|messages?|events?|records?|payloads?|master|data|files?|using|via|through|with|over|http|ems|kafka|rest|soap|sftp|api|queue|topic|service|to|from)\\b\", coerce.toString($activity[ExtractSpec].extraction.business_object), \" \"), \" \"), \" \")",
                    "interface_type": "=(array.count($activity[GetSession].Output.records) > 0 && coerce.toString($activity[GetSession].Output.records[0].interface_type) != \"\") ? coerce.toString($activity[GetSession].Output.records[0].interface_type) : coerce.toString($activity[ExtractSpec].extraction.interface_type)",
                    "template_type": "=(array.count($activity[GetSession].Output.records) > 0 && coerce.toString($activity[GetSession].Output.records[0].template_type) != \"\") ? coerce.toString($activity[GetSession].Output.records[0].template_type) : coerce.toString($activity[ExtractSpec].extraction.template_type)",
                    "cdm": "=(coerce.toString($activity[ExtractSpec].extraction.cdm) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.cdm) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].cdm) : \"\")",
                    "interface_id": "=(coerce.toString($activity[ExtractSpec].extraction.interface_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.interface_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].interface_id) : \"\")",
                    "scenario_id": "=(coerce.toString($activity[ExtractSpec].extraction.scenario_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.scenario_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].scenario_id) : \"\")",
                    "bitbucket_project": "=(coerce.toString($activity[ExtractSpec].extraction.bitbucket_project) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.bitbucket_project) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].bitbucket_project) : \"\")",
                    "email": "=(coerce.toString($activity[ExtractSpec].extraction.email) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.email) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].email) : \"\")",
                    "env": "=(coerce.toString($activity[ExtractSpec].extraction.env) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.env) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].env) : \"\")",
                    "k8s_domain": "=(coerce.toString($activity[ExtractSpec].extraction.k8s_domain) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.k8s_domain) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].k8s_domain) : \"\")",
                    "country_code": "=(coerce.toString($activity[ExtractSpec].extraction.country_code) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.country_code) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].country_code) : \"\")",
                    "unique_id": "=(coerce.toString($activity[ExtractSpec].extraction.unique_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.unique_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].unique_id) : \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ComputeMissing",
            "name": "ComputeMissing",
            "description": "Computes which required fields are still missing, whether the spec is ready, and the next clarifying question to ask.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "p_source_system": "=($activity[MergeSpec].output.source_system == \"\") ? \"\\\"source_system\\\",\" : \"\"",
                    "p_target_system": "=($activity[MergeSpec].output.target_system == \"\") ? \"\\\"target_system\\\",\" : \"\"",
                    "p_business_object": "=($activity[MergeSpec].output.business_object == \"\") ? \"\\\"business_object\\\",\" : \"\"",
                    "p_interface_type": "=($activity[MergeSpec].output.interface_type == \"\") ? \"\\\"interface_type\\\",\" : \"\"",
                    "p_template_type": "",
                    "ready": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\")",
                    "next_q": "=($activity[MergeSpec].output.source_system == \"\") ? \"Which source system should the data come FROM? (e.g. s4hana, wms, salesforce)\" : ($activity[MergeSpec].output.target_system == \"\") ? \"Which target system should the data go TO? (e.g. kafka, ems, rest)\" : ($activity[MergeSpec].output.business_object == \"\") ? \"What business object is this integration about? (e.g. article, invoice, order)\" : ($activity[MergeSpec].output.interface_type == \"\") ? \"What interface type should this be? (pub, sub, or service)\" : ($activity[MergeSpec].output.template_type == \"\") ? \"All required fields collected — ready to generate! I will pick the best-matching template automatically (or name one, e.g. SAP_IDOC_To_KAFKATopic).\" : \"All required fields collected — ready to generate!\""
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"p_source_system\": {\"type\": \"string\"}, \"p_target_system\": {\"type\": \"string\"}, \"p_business_object\": {\"type\": \"string\"}, \"p_interface_type\": {\"type\": \"string\"}, \"p_template_type\": {\"type\": \"string\"}, \"ready\": {\"type\": \"boolean\"}, \"next_q\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"p_source_system\": {\"type\": \"string\"}, \"p_target_system\": {\"type\": \"string\"}, \"p_business_object\": {\"type\": \"string\"}, \"p_interface_type\": {\"type\": \"string\"}, \"p_template_type\": {\"type\": \"string\"}, \"ready\": {\"type\": \"boolean\"}, \"next_q\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
