    {
      "id": "flow:AuthGuard",
      "data": {
        "name": "AuthGuard",
        "description": "Reference auth guard: session cookie / bearer JWT (HS256), X-API-Key admin, roles, 401/403 + audit",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "GetAuth",
            "type": "label",
            "label": "GetOps to GetAuth"
          },
          {
            "id": 3,
            "from": "GetAuth",
            "to": "ReadCredential",
            "type": "label",
            "label": "GetAuth to ReadCredential"
          },
          {
            "id": 4,
            "from": "ReadCredential",
            "to": "VerifySession",
            "type": "label",
            "label": "ReadCredential to VerifySession"
          },
          {
            "id": 5,
            "from": "VerifySession",
            "to": "Facts",
            "type": "label",
            "label": "VerifySession to Facts"
          },
          {
            "id": 6,
            "from": "Facts",
            "to": "Verdict",
            "type": "label",
            "label": "Facts to Verdict"
          },
          {
            "id": 7,
            "from": "Verdict",
            "to": "AuditDenied",
            "type": "expression",
            "label": "Verdict to AuditDenied",
            "value": "$activity[Verdict].output.v.deny == true"
          },
          {
            "id": 8,
            "from": "AuditDenied",
            "to": "Return",
            "type": "label",
            "label": "AuditDenied to Return"
          },
          {
            "id": 9,
            "from": "Verdict",
            "to": "Return",
            "type": "expression",
            "label": "Verdict to Return",
            "value": "$activity[Verdict].output.v.deny != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_AUTH\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetAuth",
            "name": "GetAuth",
            "description": "GetAuth"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "cred": "=array.get(json.jq($flow.headers, $activity[GetOps].output.data.auth.credential), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cred\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"api_key\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cred\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"api_key\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "ReadCredential",
            "name": "ReadCredential",
            "description": "ReadCredential"
          },
          {
            "activity": {
              "ref": "#act_general_jwt",
              "settings": {
                "mode": "Verify"
              },
              "input": {
                "input": {
                  "mapping": {
                    "token": "=$activity[ReadCredential].output.cred.token",
                    "secret": "=$activity[GetAuth].output.data.signing_key",
                    "algorithm": "HS256"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"secret\": {\"type\": \"string\"}, \"algorithm\": {\"type\": \"string\"}, \"header\": {\"type\": \"string\"}, \"payload\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"secret\": {\"type\": \"string\"}, \"algorithm\": {\"type\": \"string\"}, \"header\": {\"type\": \"string\"}, \"payload\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "id": "VerifySession",
            "name": "VerifySession",
            "description": "VerifySession"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "enabled": "=$property[\"AUTH_ENABLED\"]",
                    "trusted": "=$flow.trusted",
                    "admin_only": "=$flow.admin_only",
                    "key": "=$property[\"AUTH_API_KEY\"]",
                    "cred": "=$activity[ReadCredential].output.cred",
                    "valid": "=$activity[VerifySession].valid",
                    "claims": "=$activity[VerifySession].claims"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"enabled\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}, \"admin_only\": {\"type\": \"boolean\"}, \"key\": {\"type\": \"string\"}, \"cred\": {\"type\": \"object\", \"properties\": {}}, \"valid\": {\"type\": \"boolean\"}, \"claims\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"enabled\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}, \"admin_only\": {\"type\": \"boolean\"}, \"key\": {\"type\": \"string\"}, \"cred\": {\"type\": \"object\", \"properties\": {}}, \"valid\": {\"type\": \"boolean\"}, \"claims\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
            "id": "Facts",
            "name": "Facts",
            "description": "Facts"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "v": "=array.get(json.jq($activity[Facts].output, $activity[GetOps].output.data.auth.guard), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"v\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"deny\": {\"type\": \"boolean\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"v\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"deny\": {\"type\": \"boolean\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "Verdict",
            "name": "Verdict",
            "description": "Verdict"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:WriteAudit",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "username": "=$activity[Verdict].output.v.username",
                "display_name": "=$activity[Verdict].output.v.display_name",
                "role": "=$activity[Verdict].output.v.role",
                "ip": "=$activity[Verdict].output.v.ip",
                "mechanism": "=$activity[Verdict].output.v.mechanism",
                "action": "access_denied",
                "path": "=$flow.path",
                "message": "administrator privileges required"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}, \"action\": {\"type\": \"string\"}, \"path\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}, \"action\": {\"type\": \"string\"}, \"path\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "AuditDenied",
            "name": "AuditDenied",
            "description": "AuditDenied"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "ok": "=$activity[Verdict].output.v.ok",
                  "status": "=$activity[Verdict].output.v.status",
                  "body": "=$activity[Verdict].output.v.body",
                  "username": "=$activity[Verdict].output.v.username",
                  "display_name": "=$activity[Verdict].output.v.display_name",
