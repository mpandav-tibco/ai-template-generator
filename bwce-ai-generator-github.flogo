          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT json_build_object('entries', COALESCE(json_agg(json_build_object('timestamp', to_char(e.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'), 'username', e.username, 'displayName', e.display_name, 'role', e.role, 'ip', e.ip, 'action', e.action, 'path', e.path, 'message', e.message, 'mechanism', e.mechanism, 'origin', NULL) ORDER BY e.id DESC), '[]'::json))::text AS doc FROM (SELECT * FROM public.audit_log ORDER BY id DESC LIMIT LEAST(GREATEST(COALESCE(NULLIF(?limit ::text, '')::numeric::int, 200), 1), 2000)) e",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "limit",
                    "Type": "VARCHAR",
                    "Selected": false,
