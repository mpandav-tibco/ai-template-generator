    {
      "id": "flow:MCPGenerateTool",
      "data": {
        "name": "MCPGenerateTool",
        "description": "MCP tool 'generate_code': runs /generate (validation, IKD check, template selection, GitHub publication, registry, notification) and returns its result to the calling agent.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "BuildGenerateArgs",
            "type": "label",
            "label": "StartActivity to BuildGenerateArgs"
          },
          {
            "id": 2,
            "from": "BuildGenerateArgs",
            "to": "GenerateSubflow",
            "type": "label",
            "label": "BuildGenerateArgs to GenerateSubflow"
          },
          {
            "id": 3,
            "from": "GenerateSubflow",
            "to": "BuildGenResult",
            "type": "label",
            "label": "GenerateSubflow to BuildGenResult"
          },
          {
            "id": 4,
            "from": "BuildGenResult",
            "to": "ReturnResult",
            "type": "label",
            "label": "BuildGenResult to ReturnResult"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildGenerateArgs",
            "name": "BuildGenerateArgs",
            "description": "Builds the content object passed to the generate subflow (mirrors the /generate body).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "content": {
                      "spec": "=$flow.arguments.spec",
                      "config_only": "=$flow.arguments.config_only",
                      "target_mode": "=$flow.arguments.target_mode"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"spec\": {\"type\": \"object\", \"properties\": {}}, \"config_only\": {\"type\": \"boolean\"}, \"target_mode\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"spec\": {\"type\": \"object\", \"properties\": {}}, \"config_only\": {\"type\": \"boolean\"}, \"target_mode\": {\"type\": \"string\"}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"spec\": {\"type\": \"object\", \"properties\": {}}, \"config_only\": {\"type\": \"boolean\"}, \"target_mode\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"spec\": {\"type\": \"object\", \"properties\": {}}, \"config_only\": {\"type\": \"boolean\"}, \"target_mode\": {\"type\": \"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "GenerateSubflow",
            "name": "GenerateSubflow",
            "description": "Runs the full generate flow (validate, IKD cross-check, template select, register, scaffold, notify).",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:generate_POST",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "content": "=$activity[BuildGenerateArgs].output.content"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
