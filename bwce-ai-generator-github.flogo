              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              }
            },
            "id": "TokenPlan",
            "name": "TokenPlan",
            "description": "TokenPlan"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:HttpCall",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "method": "=$activity[TokenPlan].output.req.method",
                "url": "=$activity[TokenPlan].output.req.url",
                "headers": "=$activity[TokenPlan].output.req.headers",
                "body": "=$activity[TokenPlan].output.req.body",
                "request_type": "=$activity[TokenPlan].output.req.request_type",
                "insecure": "=$property[\"CODE_REVIEW_VERIFY_SSL\"] == false",
                "ca": "",
                "timeout_ms": 25000
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"insecure\": {\"type\": \"boolean\"}, \"ca\": {\"type\": \"string\"}, \"timeout_ms\": {\"type\": \"integer\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"insecure\": {\"type\": \"boolean\"}, \"ca\": {\"type\": \"string\"}, \"timeout_ms\": {\"type\": \"integer\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "FetchToken",
            "name": "FetchToken",
            "description": "FetchToken"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "call": {
                      "status": "=$activity[FetchToken].status",
                      "text": "=$activity[FetchToken].text",
                      "json": "=$activity[FetchToken].json",
                      "error": "=$activity[FetchToken].error"
                    },
                    "env_userid": "=$property[\"CODE_REVIEW_USERID\"]",
                    "env_usertype": "=$property[\"CODE_REVIEW_USERTYPE\"]",
                    "user": "=$property[\"CODE_REVIEW_USERNAME\"]"
                  }
                }
              },
              "schemas": {
