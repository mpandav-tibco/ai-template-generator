            },
            {
              "name": "github_url",
              "type": "string"
            },
            {
              "name": "clone_url",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"business_object\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"config_only\": {\"type\": \"boolean\"}, \"env\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"repo_name\": {\"type\": \"string\"}, \"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"clone_url\": {\"type\": \"string\"}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {}}"
