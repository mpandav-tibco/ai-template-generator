          {
            "id": "ResolveTemplateName",
            "name": "ResolveTemplateName",
            "description": "Uses the requested template when it is in the catalog, otherwise the best match of the template search, with its score and source",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "template_name": "=(coerce.toString($activity[NormalizeSpec].output.template_type) != \"\" && array.contains($activity[GetCatalog].output.data.template_ids, coerce.toString($activity[NormalizeSpec].output.template_type))) ? coerce.toString($activity[NormalizeSpec].output.template_type) : coerce.toString($activity[SelectTemplate].responseBody.body.suggestions[0].id)",
                    "requested_template": "=coerce.toString($activity[NormalizeSpec].output.template_type)",
                    "match_score": "=coerce.toString($activity[SelectTemplate].responseBody.body.suggestions[0].score)",
                    "template_source": "=(coerce.toString($activity[NormalizeSpec].output.template_type) != \"\" && array.contains($activity[GetCatalog].output.data.template_ids, coerce.toString($activity[NormalizeSpec].output.template_type))) ? \"requested\" : \"vector\""
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"requested_template\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"template_source\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"requested_template\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"template_source\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"requested_template\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"template_source\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"requested_template\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"template_source\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
