    {
      "id": "flow:codereview_token_POST",
      "data": {
        "name": "codereview_token_POST",
        "description": "Fetches/caches the code review session token (POST /api/codereview/token)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 2,
            "from": "Authorize",
            "to": "Deny",
            "type": "expression",
            "label": "Authorize to Deny",
            "value": "$activity[Authorize].ok != true"
          },
          {
            "id": 3,
            "from": "Authorize",
            "to": "Token",
            "type": "expression",
            "label": "Authorize to Token",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 4,
            "from": "Token",
            "to": "ReturnToken",
            "type": "expression",
            "label": "Token to ReturnToken",
            "value": "$activity[Token].ok == true"
          },
          {
            "id": 5,
            "from": "Token",
            "to": "ReturnTokenError",
            "type": "expression",
            "label": "Token to ReturnTokenError",
            "value": "$activity[Token].ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "/api/codereview/token",
                "admin_only": false,
                "trusted": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller (session, bearer token or API key)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Authorize].status",
                  "data": "=$activity[Authorize].body"
                }
              }
            },
            "id": "Deny",
            "name": "Deny",
            "description": "Rejects unauthenticated (401) or non-admin (403) callers"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:CodeReviewToken",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "force": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
