                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "CreateOpsSchema",
            "name": "CreateOpsSchema",
            "description": "Accounts, login attempts, audit log, code review history, IKD registry"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.app_user (username_key, username, display_name, role, password_hash) SELECT lower(?username ::text), ?username ::text, COALESCE(NULLIF(?display_name ::text, ''), ?username ::text), 'admin', crypt(?password ::text, gen_salt('bf', 10)) WHERE ?username ::text <> '' AND ?password ::text <> '' ON CONFLICT (username_key) DO NOTHING RETURNING username",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "username",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "password",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "display_name",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "0220b9e6-a781-56b3-933f-bca1c36e0ecfINSERT INTO public.app_user (username_key, username, display_name, role, password_hash) SELECT lower(?username ::text), ?username ::text, COALESCE(NULLIF(?display_name ::text, ''), ?username ::text), 'admin', crypt(?password ::text, gen_salt('bf', 10)) WHERE ?username ::text <> '' AND ?password ::text <> '' ON CONFLICT (username_key) DO NOTHING RETURNING username",
                "input": {
                  "mapping": {
                    "parameters": {
                      "username": "=$property[\"BOOTSTRAP_ADMIN_USERNAME\"]",
                      "password": "=$property[\"BOOTSTRAP_ADMIN_PASSWORD\"]",
