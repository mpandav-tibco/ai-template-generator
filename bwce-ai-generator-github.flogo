          "components": {
            "schemas": {
              "schema1": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "ok"
                  },
                  "service": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "engine": {
                    "type": "string"
                  }
                }
              },
              "schema2": {
                "type": "object",
                "properties": {
                  "template_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "templates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "interface_types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "cdm": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              },
              "schema3": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "spec": {
                    "type": "object",
                    "properties": {
                      "source_system": {
                        "type": "string",
                        "example": "s4hana"
                      },
                      "target_system": {
                        "type": "string",
                        "example": "kafka"
