          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Token].status",
                  "data": {
                    "mapping": {
                      "detail": "=$activity[Token].error"
                    }
                  }
                }
              }
            },
            "id": "ReturnTokenError",
            "name": "ReturnTokenError",
            "description": "ReturnTokenError"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
