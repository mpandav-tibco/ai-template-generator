            "type": "label",
            "label": "Sign to Audit"
          },
          {
            "id": 13,
            "from": "Audit",
            "to": "ReturnOk",
            "type": "expression",
            "label": "Audit to ReturnOk",
            "value": "$activity[Decide].output.d.ok == true"
          },
          {
            "id": 14,
            "from": "Audit",
            "to": "ReturnFail",
            "type": "expression",
            "label": "Audit to ReturnFail",
            "value": "$activity[Decide].output.d.ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
