            "name": "Outcome",
            "description": "Outcome"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "base": "=$property[\"CODE_REVIEW_BASE_URL\"]",
                    "body": "=$flow.content",
                    "token": {
                      "token": "=$activity[Token2].token",
                      "userid": "=$activity[Token2].userid",
                      "usertype": "=$activity[Token2].usertype"
                    },
                    "cookie": "=$property[\"CODE_REVIEW_COOKIE\"]"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
