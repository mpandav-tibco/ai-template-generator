            "from": "FetchToken",
            "to": "ResultIn",
            "type": "label",
            "label": "FetchToken to ResultIn"
          },
          {
            "id": 9,
            "from": "ResultIn",
            "to": "TokenResult",
            "type": "label",
            "label": "ResultIn to TokenResult"
          },
          {
            "id": 10,
            "from": "TokenResult",
            "to": "StoreToken",
            "type": "expression",
            "label": "TokenResult to StoreToken",
            "value": "$activity[TokenResult].output.r.ok == true"
          },
          {
            "id": 11,
            "from": "TokenResult",
            "to": "ReturnFailed",
            "type": "expression",
            "label": "TokenResult to ReturnFailed",
            "value": "$activity[TokenResult].output.r.ok != true"
          },
          {
            "id": 12,
            "from": "StoreToken",
            "to": "ReturnFetched",
            "type": "label",
            "label": "StoreToken to ReturnFetched"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_CODEREVIEW\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetToken",
            "name": "GetToken",
            "description": "GetToken"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "ok": true,
                  "status": 200,
                  "error": "",
                  "token": "=$activity[GetToken].output.data.token",
                  "userid": "=$activity[GetToken].output.data.userid",
                  "usertype": "=$activity[GetToken].output.data.usertype",
                  "updated_at": "=$activity[GetToken].output.data.updated_at"
                }
              }
            },
            "id": "ReturnCached",
            "name": "ReturnCached",
            "description": "ReturnCached"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "ok": false,
                  "status": 503,
                  "error": "Code review is not configured: set CODE_REVIEW_USERNAME and CODE_REVIEW_PASSWORD."
                }
              }
            },
            "id": "ReturnUnconfigured",
            "name": "ReturnUnconfigured",
            "description": "ReturnUnconfigured"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
