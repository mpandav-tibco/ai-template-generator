    {
      "id": "flow:SetupDatabaseFlow",
      "data": {
        "name": "SetupDatabaseFlow",
        "description": "Database initialization subflow. Reads the schema DDL and creates the PostgreSQL generation_log table if it does not already exist (idempotent).",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadSchemaFile",
            "type": "label",
            "label": "StartActivity to ReadSchemaFile"
          },
          {
            "id": 2,
            "from": "ReadSchemaFile",
            "to": "CreateSchema",
            "type": "label",
            "label": "ReadSchemaFile to CreateSchema"
          },
          {
            "id": 3,
            "from": "CreateSchema",
            "to": "CreateRepoIndex",
            "type": "label",
            "label": "CreateSchema to CreateSessionTable"
          },
          {
            "id": 4,
            "from": "CreateRepoIndex",
            "to": "CreateSessionTable",
            "type": "label",
            "label": "CreateRepoIndex to CreateSessionTable"
          },
          {
            "id": 5,
            "from": "CreateSessionTable",
            "to": "LogDbSetup",
            "type": "label",
            "label": "CreateSessionTable to LogDbSetup"
          },
          {
            "id": 6,
            "from": "LogDbSetup",
            "to": "CreateOpsSchema",
            "type": "label",
            "label": "LogDbSetup to CreateOpsSchema"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadSchemaFile",
            "name": "ReadSchemaFile",
            "description": "Reads the SQL DDL file that defines the generation_log table.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"DB_SCHEMA_FILE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CreateSchema",
            "name": "CreateSchema",
            "description": "Executes the DDL to create the generation_log table if it does not exist (idempotent).",
            "settings": {
              "retryOnError": {
                "count": 5,
                "interval": 3000
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "CREATE TABLE IF NOT EXISTS generation_log (id SERIAL PRIMARY KEY, generation_id VARCHAR(36) NOT NULL UNIQUE DEFAULT gen_random_uuid()::text, repo_name VARCHAR(100) NOT NULL, source_system VARCHAR(50) NOT NULL, target_system VARCHAR(50) NOT NULL, business_object VARCHAR(100) NOT NULL, interface_type VARCHAR(10) NOT NULL CHECK (interface_type IN ('pub','sub','service')), template_type VARCHAR(200), cdm BOOLEAN DEFAULT FALSE, interface_id VARCHAR(50) DEFAULT 'NA', scenario_id VARCHAR(20) DEFAULT '1234', bitbucket_project VARCHAR(50), env VARCHAR(50) DEFAULT 'DEV', email VARCHAR(200), k8s_domain VARCHAR(50) DEFAULT 'cite', status VARCHAR(20) DEFAULT 'GENERATED' CHECK (status IN ('GENERATED','FAILED','DUPLICATE')), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ DEFAULT NOW());",
                "manualmode": false,
                "Fields": [],
                "RuntimeQuery": "",
                "State": "3e3818f3-efe2-406a-bd18-8d1aad91e938CREATE TABLE IF NOT EXISTS generation_log (id SERIAL PRIMARY KEY, generation_id VARCHAR(36) NOT NULL UNIQUE DEFAULT gen_random_uuid()::text, repo_name VARCHAR(100) NOT NULL, source_system VARCHAR(50) NOT NULL, target_system VARCHAR(50) NOT NULL, business_object VARCHAR(100) NOT NULL, interface_type VARCHAR(10) NOT NULL CHECK (interface_type IN ('pub','sub','service')), template_type VARCHAR(200), cdm BOOLEAN DEFAULT FALSE, interface_id VARCHAR(50) DEFAULT 'NA', scenario_id VARCHAR(20) DEFAULT '1234', bitbucket_project VARCHAR(50), env VARCHAR(50) DEFAULT 'DEV', email VARCHAR(200), k8s_domain VARCHAR(50) DEFAULT 'cite', status VARCHAR(20) DEFAULT 'GENERATED' CHECK (status IN ('GENERATED','FAILED','DUPLICATE')), created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ DEFAULT NOW());"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CreateRepoIndex",
            "name": "CreateRepoIndex",
            "description": "Adds a unique index on repo_name (idempotent) so duplicate repos cannot race-insert.",
            "settings": {
              "retryOnError": {
                "count": 5,
                "interval": 3000
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "CREATE UNIQUE INDEX IF NOT EXISTS ux_generation_log_repo_name ON generation_log (repo_name);",
                "manualmode": false,
                "Fields": [],
                "RuntimeQuery": "",
                "State": "f002d2d4-0875-4720-b367-9a9dfe3419f4CREATE UNIQUE INDEX IF NOT EXISTS ux_generation_log_repo_name ON generation_log (repo_name);"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CreateSessionTable",
            "name": "CreateSessionTable",
            "description": "Creates the chat_session table if it does not exist (idempotent), so conversational sessions persist in PostgreSQL.",
            "settings": {
              "retryOnError": {
                "count": 5,
                "interval": 3000
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "CREATE TABLE IF NOT EXISTS public.chat_session (session_id VARCHAR(64) PRIMARY KEY, status VARCHAR(20) DEFAULT 'active', message TEXT DEFAULT '', source_system VARCHAR(50) DEFAULT '', target_system VARCHAR(50) DEFAULT '', business_object VARCHAR(100) DEFAULT '', interface_type VARCHAR(20) DEFAULT '', template_type VARCHAR(200) DEFAULT '', cdm VARCHAR(10) DEFAULT '', interface_id VARCHAR(50) DEFAULT '', scenario_id VARCHAR(20) DEFAULT '', bitbucket_project VARCHAR(50) DEFAULT '', email VARCHAR(200) DEFAULT '', env VARCHAR(50) DEFAULT '', k8s_domain VARCHAR(50) DEFAULT '', country_code VARCHAR(10) DEFAULT '', unique_id VARCHAR(50) DEFAULT '', missing_fields TEXT DEFAULT '[]', ready_to_generate BOOLEAN DEFAULT FALSE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ DEFAULT NOW());",
                "manualmode": false,
                "Fields": [],
                "RuntimeQuery": "",
                "State": "ab3cbbba-9a16-44c4-aefc-0aaa4ed5e22eCREATE TABLE IF NOT EXISTS public.chat_session (session_id VARCHAR(64) PRIMARY KEY, status VARCHAR(20) DEFAULT 'active', message TEXT DEFAULT '', source_system VARCHAR(50) DEFAULT '', target_system VARCHAR(50) DEFAULT '', business_object VARCHAR(100) DEFAULT '', interface_type VARCHAR(20) DEFAULT '', template_type VARCHAR(200) DEFAULT '', cdm VARCHAR(10) DEFAULT '', interface_id VARCHAR(50) DEFAULT '', scenario_id VARCHAR(20) DEFAULT '', bitbucket_project VARCHAR(50) DEFAULT '', email VARCHAR(200) DEFAULT '', env VARCHAR(50) DEFAULT '', k8s_domain VARCHAR(50) DEFAULT '', country_code VARCHAR(10) DEFAULT '', unique_id VARCHAR(50) DEFAULT '', missing_fields TEXT DEFAULT '[]', ready_to_generate BOOLEAN DEFAULT FALSE, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), updated_at TIMESTAMPTZ DEFAULT NOW());"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "activity": {
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[DB-SETUP] PostgreSQL generation_log table initialized\"",
                "logLevel": ""
              },
              "ref": "#log"
            },
            "id": "LogDbSetup",
            "name": "LogDbSetup",
            "description": "Logs that the PostgreSQL generation_log table is initialized."
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "DO $$ BEGIN CREATE TABLE IF NOT EXISTS public.code_review_history (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), repo_name TEXT, product_name TEXT, version TEXT, checkbwdesign BOOLEAN, status TEXT NOT NULL, error TEXT, links JSONB NOT NULL DEFAULT '[]', master_html TEXT, app_html TEXT); CREATE TABLE IF NOT EXISTS public.ikd_registry (kind TEXT NOT NULL, ikd_value TEXT NOT NULL, repo_name TEXT NOT NULL, updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), PRIMARY KEY (kind, repo_name)); DELETE FROM public.code_review_history WHERE id <= (SELECT max(id) - 500 FROM public.code_review_history); END $$",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [],
                "RuntimeQuery": "",
                "State": "716bcb8e-d583-54d5-a57b-8494d490d942DO $$ BEGIN CREATE TABLE IF NOT EXISTS public.code_review_history (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), repo_name TEXT, product_name TEXT, version TEXT, checkbwdesign BOOLEAN, status TEXT NOT NULL, error TEXT, links JSONB NOT NULL DEFAULT '[]', master_html TEXT, app_html TEXT); CREATE TABLE IF NOT EXISTS public.ikd_registry (kind TEXT NOT NULL, ikd_value TEXT NOT NULL, repo_name TEXT NOT NULL, updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), PRIMARY KEY (kind, repo_name)); DELETE FROM public.code_review_history WHERE id <= (SELECT max(id) - 500 FROM public.code_review_history); END $$"
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "CreateOpsSchema",
            "name": "CreateOpsSchema",
            "description": "Code review history and IKD registry tables"
          }
        ],
