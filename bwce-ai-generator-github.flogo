    {
      "id": "flow:api_templates_suggest_POST",
      "data": {
        "name": "api_templates_suggest_POST",
        "description": "Ranks catalog templates for a spec (POST /api/templates/suggest); also used by /generate",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "SuggestTemplates",
            "type": "label",
            "label": "StartActivity to SuggestTemplates"
          },
          {
            "id": 2,
            "from": "SuggestTemplates",
            "to": "ReplySuggest",
            "type": "label",
            "label": "SuggestTemplates to ReplySuggest"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "SuggestTemplates",
            "name": "SuggestTemplates",
            "description": "Vector search over the template catalog",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:6mtK6zYLT8J40cTPaJ4U4icfb9RXxg==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": true,
                "hybridAlpha": 0.25,
                "enableLLMGenerate": false,
                "llmProvider": "Ollama",
                "llmBaseURL": "=$property[\"LLM_BASE_URL\"]",
                "llmAPIKey": "",
                "llmModel": "=$property[\"LLM_MODEL\"]",
                "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so.",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=string.concat(coerce.toString($flow.source_system), \" to \", coerce.toString($flow.target_system), \" \", coerce.toString($flow.business_object), \" \", coerce.toString($flow.interface_type), \" \", coerce.toString($flow.query))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 5
              }
            }
          },
          {
            "id": "ReplySuggest",
