                "State": "a0e80431-287e-5448-b64c-0fd62c5a6376SELECT json_build_object('entries', COALESCE(json_agg(json_build_object('timestamp', to_char(e.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'), 'username', e.username, 'displayName', e.display_name, 'role', e.role, 'ip', e.ip, 'action', e.action, 'path', e.path, 'message', e.message, 'mechanism', e.mechanism, 'origin', NULL) ORDER BY e.id DESC), '[]'::json))::text AS doc FROM (SELECT * FROM public.audit_log ORDER BY id DESC LIMIT LEAST(GREATEST(COALESCE(NULLIF(?limit ::text, '')::numeric::int, 200), 1), 2000)) e",
                "input": {
