                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"result\": {\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing_fields\": {\"type\": \"array\", \"items\": {}}, \"message\": {\"type\": \"string\"}}}}}"
