      "id": "flow:api_chat/init_POST",
      "data": {
        "name": "api_chat/init_POST",
        "description": "Starts a conversation (POST /api/chat/init): new session id and greeting, stored in PostgreSQL (chat_session).",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "CreateSession",
            "type": "label",
            "label": "Log_API to CreateSession"
          },
          {
            "id": 2,
            "from": "CreateSession",
            "to": "StoreSession",
            "type": "label",
