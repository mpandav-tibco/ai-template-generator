              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"d\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"locked\": {\"type\": \"boolean\"}, \"reset_window\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"audit_action\": {\"type\": \"string\"}, \"audit_message\": {\"type\": \"string\"}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"claims\": {\"type\": \"string\"}, \"cookie_suffix\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"d\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"locked\": {\"type\": \"boolean\"}, \"reset_window\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"audit_action\": {\"type\": \"string\"}, \"audit_message\": {\"type\": \"string\"}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"claims\": {\"type\": \"string\"}, \"cookie_suffix\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "Decide",
            "name": "Decide",
            "description": "Decide"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.login_attempt (username_key, failures, first_failed_at) VALUES (lower(?username ::text), 1, now()) ON CONFLICT (username_key) DO UPDATE SET failures = CASE WHEN ?reset ::text = 'true' THEN 1 ELSE public.login_attempt.failures + 1 END, first_failed_at = CASE WHEN ?reset ::text = 'true' THEN now() ELSE public.login_attempt.first_failed_at END RETURNING failures",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "username",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "reset",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "19a451d1-5ab7-5b44-a962-84c8d5e97e28INSERT INTO public.login_attempt (username_key, failures, first_failed_at) VALUES (lower(?username ::text), 1, now()) ON CONFLICT (username_key) DO UPDATE SET failures = CASE WHEN ?reset ::text = 'true' THEN 1 ELSE public.login_attempt.failures + 1 END, first_failed_at = CASE WHEN ?reset ::text = 'true' THEN now() ELSE public.login_attempt.first_failed_at END RETURNING failures",
                "input": {
                  "mapping": {
                    "parameters": {
                      "username": "=$activity[Decide].output.d.username",
                      "reset": "=coerce.toString($activity[Decide].output.d.reset_window)"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                },
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"reset\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"reset\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "RecordFailure",
            "name": "RecordFailure",
            "description": "RecordFailure"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "DELETE FROM public.login_attempt WHERE username_key = lower(?username ::text) RETURNING username_key",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "username",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
