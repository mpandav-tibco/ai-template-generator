            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}, \"product\": {\"type\": \"string\"}, \"version\": {\"type\": \"string\"}, \"checkbwdesign\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"links\": {\"type\": \"array\", \"items\": {}}, \"master\": {\"type\": \"string\"}, \"app\": {\"type\": \"string\"}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {}}"
          }
        }
      }
    },
    {
      "id": "flow:codereview_token_POST",
      "data": {
        "name": "codereview_token_POST",
        "description": "Fetches/caches the code review session token (POST /api/codereview/token)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Token",
            "type": "label",
            "label": "StartActivity to Token"
          },
          {
            "id": 2,
            "from": "Token",
            "to": "ReturnToken",
            "type": "expression",
            "label": "Token to ReturnToken",
            "value": "$activity[Token].ok == true"
          },
          {
            "id": 3,
            "from": "Token",
            "to": "ReturnTokenError",
            "type": "expression",
            "label": "Token to ReturnTokenError",
            "value": "$activity[Token].ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Token",
            "name": "Token",
            "description": "Token",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:CodeReviewToken",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "force": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnToken",
            "name": "ReturnToken",
            "description": "ReturnToken",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "success": true,
                        "userid": "=$activity[Token].userid",
                        "usertype": "=$activity[Token].usertype",
                        "token_cached": true,
                        "updated_at": "=$activity[Token].updated_at",
                        "message": "Code review session token is ready."
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "ReturnTokenError",
            "name": "ReturnTokenError",
            "description": "ReturnTokenError",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Token].status",
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=$activity[Token].error"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6NTl9LCJUb2tlbiI6eyJ4IjozNTAsInkiOjUwfSwiUmV0dXJuVG9rZW4iOnsieCI6NjAwLCJ5Ijo1MH0sIlJldHVyblRva2VuRXJyb3IiOnsieCI6NjAwLCJ5IjoyMDB9fQ==",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:codereview_run_POST",
      "data": {
        "name": "codereview_run_POST",
        "description": "Runs a code review (POST /api/codereview/run): token, one retry with a fresh token, history",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "ReadRun",
            "type": "label",
            "label": "GetOps to ReadRun"
          },
          {
            "id": 3,
            "from": "ReadRun",
            "to": "ReturnBad",
            "type": "expression",
            "label": "ReadRun to ReturnBad",
            "value": "$activity[ReadRun].output.err != \"\""
          },
          {
            "id": 4,
            "from": "ReadRun",
            "to": "Token1",
            "type": "expression",
            "label": "ReadRun to Token1",
            "value": "$activity[ReadRun].output.err == \"\""
          },
          {
            "id": 5,
            "from": "Token1",
            "to": "HistTokenFail",
            "type": "expression",
            "label": "Token1 to HistTokenFail",
            "value": "$activity[Token1].ok != true"
          },
          {
            "id": 6,
            "from": "HistTokenFail",
            "to": "ReturnTokenFail",
            "type": "label",
            "label": "HistTokenFail to ReturnTokenFail"
          },
          {
            "id": 7,
            "from": "Token1",
            "to": "Run1In",
            "type": "expression",
            "label": "Token1 to Run1In",
            "value": "$activity[Token1].ok == true"
          },
          {
            "id": 8,
            "from": "Run1In",
            "to": "Run1Plan",
            "type": "label",
            "label": "Run1In to Run1Plan"
          },
          {
            "id": 9,
            "from": "Run1Plan",
            "to": "Attempt1",
            "type": "label",
            "label": "Run1Plan to Attempt1"
          },
          {
            "id": 10,
            "from": "Attempt1",
            "to": "Token2",
            "type": "expression",
            "label": "Attempt1 to Token2",
            "value": "($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400)"
          },
          {
            "id": 11,
            "from": "Token2",
            "to": "Run2In",
            "type": "label",
            "label": "Token2 to Run2In"
          },
          {
            "id": 12,
            "from": "Run2In",
            "to": "Run2Plan",
            "type": "label",
            "label": "Run2In to Run2Plan"
          },
          {
            "id": 13,
            "from": "Run2Plan",
            "to": "Attempt2",
            "type": "label",
            "label": "Run2Plan to Attempt2"
          },
          {
            "id": 14,
            "from": "Attempt2",
            "to": "Outcome",
            "type": "label",
            "label": "Attempt2 to Outcome"
          },
          {
            "id": 15,
            "from": "Outcome",
            "to": "RunResult",
            "type": "label",
            "label": "Outcome to RunResult"
          },
          {
            "id": 16,
            "from": "RunResult",
            "to": "HistOk",
            "type": "expression",
            "label": "RunResult to HistOk",
            "value": "$activity[RunResult].output.r.ok == true"
          },
          {
            "id": 17,
            "from": "HistOk",
            "to": "ReturnRun",
            "type": "label",
            "label": "HistOk to ReturnRun"
          },
          {
            "id": 18,
            "from": "RunResult",
            "to": "HistFail",
            "type": "expression",
            "label": "RunResult to HistFail",
            "value": "$activity[RunResult].output.r.ok != true"
          },
          {
            "id": 19,
            "from": "HistFail",
            "to": "ReturnRunError",
            "type": "label",
            "label": "HistFail to ReturnRunError"
          },
          {
            "id": 20,
            "from": "Attempt1",
            "to": "Outcome",
            "type": "expression",
            "label": "Attempt1 to Outcome",
            "value": "$activity[Attempt1].error == \"\" && $activity[Attempt1].status < 400"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "APP_OPS",
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"k8s\": {\"type\": \"object\", \"properties\": {\"prelude\": {\"type\": \"string\"}, \"route\": {\"type\": \"string\"}, \"routes\": {\"type\": \"object\"}, \"init\": {\"type\": \"string\"}, \"ops\": {\"type\": \"object\"}}}, \"schemas\": {\"type\": \"object\", \"properties\": {\"wrapper_template\": {\"type\": \"string\"}, \"plan\": {\"type\": \"string\"}}}, \"codereview\": {\"type\": \"object\", \"properties\": {\"token_request\": {\"type\": \"string\"}, \"token_result\": {\"type\": \"string\"}, \"run_check\": {\"type\": \"string\"}, \"run_request\": {\"type\": \"string\"}, \"run_result\": {\"type\": \"string\"}, \"netdebug\": {\"type\": \"string\"}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\"}, \"render\": {\"type\": \"string\"}}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"k8s\": {\"type\": \"object\", \"properties\": {\"prelude\": {\"type\": \"string\"}, \"route\": {\"type\": \"string\"}, \"routes\": {\"type\": \"object\"}, \"init\": {\"type\": \"string\"}, \"ops\": {\"type\": \"object\"}}}, \"schemas\": {\"type\": \"object\", \"properties\": {\"wrapper_template\": {\"type\": \"string\"}, \"plan\": {\"type\": \"string\"}}}, \"codereview\": {\"type\": \"object\", \"properties\": {\"token_request\": {\"type\": \"string\"}, \"token_result\": {\"type\": \"string\"}, \"run_check\": {\"type\": \"string\"}, \"run_request\": {\"type\": \"string\"}, \"run_result\": {\"type\": \"string\"}, \"netdebug\": {\"type\": \"string\"}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"templates\": {\"type\": \"array\"}, \"render\": {\"type\": \"string\"}}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReadRun",
            "name": "ReadRun",
            "description": "ReadRun",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "err": "=coerce.toString(array.get(json.jq($flow.content, $activity[GetOps].output.data.codereview.run_check), 0))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"err\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnBad",
            "name": "ReturnBad",
            "description": "ReturnBad",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=$activity[ReadRun].output.err"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Token1",
            "name": "Token1",
            "description": "Token1",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:CodeReviewToken",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "force": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "HistTokenFail",
            "name": "HistTokenFail",
            "description": "HistTokenFail",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:RecordCodeReview",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "repo": "=coerce.toString($flow.content.repoName)",
                "product": "=coerce.toString($flow.content.productName)",
                "version": "=coerce.toString($flow.content.version)",
                "checkbwdesign": "=$flow.content.checkbwdesign == true",
                "status": "failed",
                "error": "=string.concat(\"Token fetch failed: \", $activity[Token1].error)"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}, \"product\": {\"type\": \"string\"}, \"version\": {\"type\": \"string\"}, \"checkbwdesign\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"links\": {\"type\": \"array\", \"items\": {}}, \"master\": {\"type\": \"string\"}, \"app\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}, \"product\": {\"type\": \"string\"}, \"version\": {\"type\": \"string\"}, \"checkbwdesign\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"links\": {\"type\": \"array\", \"items\": {}}, \"master\": {\"type\": \"string\"}, \"app\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnTokenFail",
            "name": "ReturnTokenFail",
            "description": "ReturnTokenFail",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Token1].status",
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=$activity[Token1].error"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Run1In",
            "name": "Run1In",
            "description": "Run1In",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "base": "=$property[\"CODE_REVIEW_BASE_URL\"]",
                    "body": "=$flow.content",
                    "token": {
                      "token": "=$activity[Token1].token",
                      "userid": "=$activity[Token1].userid",
                      "usertype": "=$activity[Token1].usertype"
                    },
                    "cookie": "=$property[\"CODE_REVIEW_COOKIE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Run1Plan",
            "name": "Run1Plan",
            "description": "Run1Plan",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "req": "=array.get(json.jq($activity[Run1In].output, $activity[GetOps].output.data.codereview.run_request), 0)"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"req\": {\"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Attempt1",
            "name": "Attempt1",
            "description": "Attempt1",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:CodeReviewRequest",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "method": "=$activity[Run1Plan].output.req.method",
                "url": "=$activity[Run1Plan].output.req.url",
                "headers": "=$activity[Run1Plan].output.req.headers",
                "body": "=$activity[Run1Plan].output.req.body",
                "request_type": "=$activity[Run1Plan].output.req.request_type",
                "probe": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"probe\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"method\": {\"type\": \"string\"}, \"url\": {\"type\": \"string\"}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"any\"}, \"request_type\": {\"type\": \"string\"}, \"probe\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Token2",
            "name": "Token2",
            "description": "Retry once with a refreshed token (token may have expired)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
