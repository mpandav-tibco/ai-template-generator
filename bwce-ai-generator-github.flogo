    {
      "id": "flow:codereview_token_POST",
      "data": {
        "name": "codereview_token_POST",
        "description": "Fetches/caches the code review session token (POST /api/codereview/token)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Token",
            "type": "label",
            "label": "StartActivity to Token"
          },
          {
            "id": 2,
            "from": "Token",
            "to": "ReturnToken",
            "type": "expression",
            "label": "Token to ReturnToken",
            "value": "$activity[Token].ok == true"
          },
          {
            "id": 3,
            "from": "Token",
            "to": "ReturnTokenError",
            "type": "expression",
            "label": "Token to ReturnTokenError",
            "value": "$activity[Token].ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:CodeReviewToken",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "force": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Token",
            "name": "Token",
            "description": "Token"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "success": true,
                        "userid": "=$activity[Token].userid",
                        "usertype": "=$activity[Token].usertype",
                        "token_cached": true,
                        "updated_at": "=$activity[Token].updated_at",
                        "message": "Code review session token is ready."
                      }
                    }
                  }
                }
              }
            },
            "id": "ReturnToken",
            "name": "ReturnToken",
            "description": "ReturnToken"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Token].status",
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "detail": "=$activity[Token].error"
                      }
                    }
                  }
                }
              }
            },
            "id": "ReturnTokenError",
            "name": "ReturnTokenError",
            "description": "ReturnTokenError"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6NTl9LCJUb2tlbiI6eyJ4IjozNTAsInkiOjUwfSwiUmV0dXJuVG9rZW4iOnsieCI6NjAwLCJ5Ijo1MH0sIlJldHVyblRva2VuRXJyb3IiOnsieCI6NjAwLCJ5IjoyMDB9fQ==",
