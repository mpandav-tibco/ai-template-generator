    {
      "id": "flow:TemplateIngestionFlow",
      "data": {
        "name": "TemplateIngestionFlow",
        "description": "Loads BWCE templates into the Weaviate vector database. Ensures the target collection exists, then ingests template documents with embeddings to power semantic template selection.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetTemplates",
            "type": "label",
            "label": "StartActivity to GetTemplates"
          },
          {
            "id": 2,
            "from": "GetTemplates",
            "to": "CheckCollection",
            "type": "label",
            "label": "GetTemplates to CheckCollection"
          },
          {
            "id": 3,
            "from": "CheckCollection",
            "to": "CreateCollection",
            "type": "label",
            "label": "CheckCollection to CreateCollection"
          },
          {
            "id": 4,
            "from": "CreateCollection",
            "to": "IngestTemplates",
            "type": "label",
            "label": "CreateCollection to IngestTemplates"
          },
          {
            "id": 5,
            "from": "IngestTemplates",
            "to": "LogIngestionComplete",
            "type": "label",
            "label": "IngestTemplates to LogIngestionComplete"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetTemplates",
            "name": "GetTemplates",
            "description": "Reads the template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_CONFIG\"",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "CheckCollection",
            "name": "CheckCollection",
            "description": "Lists existing Weaviate collections to check whether the template collection already exists.",
            "activity": {
              "ref": "#listCollections",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924"
              }
            }
          },
          {
            "id": "CreateCollection",
            "name": "CreateCollection",
            "description": "Creates the Weaviate template collection with the correct vector schema if it is missing.",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924"
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestTemplates",
            "name": "IngestTemplates",
            "description": "Ingests template documents into the Weaviate collection, generating embeddings for semantic search.",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "enableChunking": false,
                "chunkStrategy": "heading",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:wukaPGIllUhjTMG/HRxNq/0skMlRNg==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "documents": "=$activity[GetTemplates].output.data.templates"
              }
            }
          },
          {
            "id": "LogIngestionComplete",
            "name": "LogIngestionComplete",
            "description": "Logs that templates have been ingested into the vector database.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[INGESTION] Templates ingested into VectorDB collection.\"",
                "logLevel": ""
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkdldFRlbXBsYXRlcyI6eyJ4IjoyNTAsInkiOjQ1fSwiQ2hlY2tDb2xsZWN0aW9uIjp7IngiOjQ1MCwieSI6NDV9LCJDcmVhdGVDb2xsZWN0aW9uIjp7IngiOjY1MCwieSI6NDV9LCJJbmdlc3RUZW1wbGF0ZXMiOnsieCI6MjUwLCJ5IjoxOTV9LCJMb2dJbmdlc3Rpb25Db21wbGV0ZSI6eyJ4Ijo0NTAsInkiOjE5NX19",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ScaffoldArtifactsFlow",
      "data": {
        "name": "ScaffoldArtifactsFlow",
        "description": "Generates the integration from the template library and publishes it to the shared GitHub repository in one commit",
        "links": [
          {
            "id": 1,
            "from": "ScaffoldRepo",
            "to": "ReturnScaffold",
            "type": "label",
            "label": "ScaffoldRepo to ReturnScaffold"
          },
          {
            "id": 2,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 3,
            "from": "GetOps",
            "to": "BuildScaffoldRequest",
            "type": "label",
            "label": "GetOps to BuildScaffoldRequest"
          },
          {
            "id": 4,
            "from": "BuildScaffoldRequest",
            "to": "RenderCICD",
            "type": "label",
            "label": "BuildScaffoldRequest to RenderCICD"
          },
          {
            "id": 5,
            "from": "RenderCICD",
            "to": "ScaffoldRepo",
            "type": "label",
            "label": "RenderCICD to ScaffoldRepo"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "input": {
                "input": {
                  "mapping": {
                    "replacement_list": [
                      {
                        "token": "BWCEInterfaceID",
                        "value": "=$flow.interface_id"
                      },
                      {
                        "token": "BWCEScenarioID",
                        "value": "=$flow.scenario_id"
                      },
                      {
                        "token": "BWCESourceSystem",
                        "value": "=$flow.source_system"
                      },
                      {
                        "token": "BWCETargetSystem",
                        "value": "=$flow.target_system"
                      },
                      {
                        "token": "BWCERepoName",
                        "value": "=$flow.repo_name"
                      },
                      {
                        "token": "BWCEComponentType",
                        "value": "=$flow.interface_type"
                      },
                      {
                        "token": "BWCEServiceName",
                        "value": "=string.replaceAll($flow.repo_name, \"-\", \"\")"
                      },
                      {
                        "token": "SourceSystemName",
                        "value": "=$flow.source_system"
                      },
                      {
                        "token": "TargetSystemName",
                        "value": "=$flow.target_system"
                      },
                      {
                        "token": "InterfaceType",
                        "value": "=$flow.interface_type"
                      },
                      {
                        "token": "SystemName",
                        "value": "=$flow.source_system"
                      },
                      {
                        "token": "systemname",
                        "value": "=$flow.source_system"
                      },
                      {
                        "token": "ObjectName",
                        "value": "=$flow.business_object"
                      },
                      {
                        "token": "objectname",
                        "value": "=$flow.business_object"
                      },
                      {
                        "token": "=string.concat($flow.template_name, \".module\")",
                        "value": "=string.concat($flow.repo_name, \".module\")"
                      },
                      {
                        "token": "=string.concat(string.toLower($flow.template_name), \".module\")",
                        "value": "=string.concat($flow.repo_name, \".module\")"
                      },
                      {
                        "token": "=string.concat($flow.template_name, \".parent\")",
                        "value": "=string.concat($flow.repo_name, \".parent\")"
                      },
                      {
                        "token": "=string.concat(string.toLower($flow.template_name), \".parent\")",
                        "value": "=string.concat($flow.repo_name, \".parent\")"
                      },
                      {
                        "token": "=$flow.template_name",
                        "value": "=$flow.repo_name"
                      },
                      {
                        "token": "=string.toLower($flow.template_name)",
                        "value": "=$flow.repo_name"
                      },
                      {
                        "token": "input_template",
                        "value": "=$flow.repo_name"
                      },
                      {
                        "token": "D:\\BWCE\\Framework\\ExceptionLookup.csv",
                        "value": "/resources/addons/exceptionLookup/ExceptionLookup.csv"
                      },
                      {
                        "token": "=(string.contains($flow.interface_type, \"pub\")) ? \"SystemName.Inbound\" : \"\"",
                        "value": "SystemName.Outbound"
                      },
                      {
                        "token": "=(string.contains($flow.interface_type, \"pub\")) ? \"SystemName_ObjectName_CDM_SUB\" : \"\"",
                        "value": "SystemName_ObjectName_cdm_PUB"
                      },
                      {
                        "token": "=(string.contains($flow.interface_type, \"pub\")) ? \"SystemName_ObjectName_Sub\" : \"\"",
                        "value": "SystemName_ObjectName_Pub"
                      },
                      {
                        "token": "=($flow.cdm == true) ? \"\" : \"SystemName_ObjectName_CDM\"",
                        "value": "SystemName_ObjectName"
                      }
                    ],
                    "exclude_patterns": [
                      "=($flow.config_only == true) ? \"*\" : \"__pycache__/\"",
                      "*.pyc"
                    ],
                    "extra_files": [
                      {
                        "path": "configs/generation.properties",
                        "content": "=string.concat(\"repository_name=\", $flow.repo_name, \"\\n\", \"template_type=\", $flow.template_name, \"\\n\", \"interface_type=\", $flow.interface_type, \"\\n\", \"source_system=\", $flow.source_system, \"\\n\", \"target_system=\", $flow.target_system, \"\\n\", \"business_object=\", $flow.business_object, \"\\n\", \"interface_id=\", $flow.interface_id, \"\\n\", \"scenario_id=\", $flow.scenario_id, \"\\n\", \"environment=\", $flow.env, \"\\n\", \"bw_profile=\", $flow.bw_profile, \"\\n\", \"k8s_domain=\", $flow.k8s_domain, \"\\n\", \"need_secret=\", coerce.toString($flow.need_secret), \"\\n\")"
                      },
                      {
                        "path": "configs/generation-metadata.json",
                        "content": "=string.concat(\"{\\n\", \"  \\\"repository_name\\\": \\\"\", $flow.repo_name, \"\\\",\\n\", \"  \\\"template_type\\\": \\\"\", $flow.template_name, \"\\\",\\n\", \"  \\\"interface_type\\\": \\\"\", $flow.interface_type, \"\\\",\\n\", \"  \\\"source_system\\\": \\\"\", $flow.source_system, \"\\\",\\n\", \"  \\\"target_system\\\": \\\"\", $flow.target_system, \"\\\",\\n\", \"  \\\"business_object\\\": \\\"\", $flow.business_object, \"\\\",\\n\", \"  \\\"interface_id\\\": \\\"\", $flow.interface_id, \"\\\",\\n\", \"  \\\"scenario_id\\\": \\\"\", $flow.scenario_id, \"\\\",\\n\", \"  \\\"environment\\\": \\\"\", $flow.env, \"\\\",\\n\", \"  \\\"bw_profile\\\": \\\"\", $flow.bw_profile, \"\\\",\\n\", \"  \\\"k8s_domain\\\": \\\"\", $flow.k8s_domain, \"\\\",\\n\", \"  \\\"need_secret\\\": \\\"\", coerce.toString($flow.need_secret), \"\\\",\\n\", \"  \\\"generated_at\\\": \\\"\", datetime.currentDatetime(), \"\\\"\\n}\")"
                      }
                    ],
                    "cicd": {
                      "enabled": "=$flow.config_only != true && $property[\"GENERATE_CICD\"] == true",
                      "templates": "=$activity[GetOps].output.data.cicd.templates",
                      "vars": {
                        "repo": "=$flow.repo_name",
                        "template_type": "=$flow.template_name",
                        "environment": "=$flow.env",
                        "bw_profile": "=$flow.bw_profile",
                        "interface_id": "=$flow.interface_id",
                        "scenario_id": "=$flow.scenario_id",
                        "source_system": "=$flow.source_system",
                        "target_system": "=$flow.target_system",
                        "k8s_domain": "=$flow.k8s_domain",
                        "need_secret": "=$flow.need_secret",
                        "object_name": "=$flow.business_object",
                        "interface_type": "=$flow.interface_type"
                      }
                    }
                  }
                }
              },
              "ref": "#mapper",
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"replacement_list\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"value\": {\"type\": \"string\"}}}}, \"exclude_patterns\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"extra_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"enabled\": {\"type\": \"boolean\"}, \"templates\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"vars\": {\"type\": \"object\", \"properties\": {}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"replacement_list\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"value\": {\"type\": \"string\"}}}}, \"exclude_patterns\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"extra_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}}}, \"cicd\": {\"type\": \"object\", \"properties\": {\"enabled\": {\"type\": \"boolean\"}, \"templates\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"vars\": {\"type\": \"object\", \"properties\": {}}}}}}"
                  }
                }
              }
            },
            "id": "BuildScaffoldRequest",
            "name": "BuildScaffoldRequest",
            "description": "Builds the template token map (same rules as the reference generator) and the generated config files"
          },
          {
            "activity": {
              "input": {
                "authToken": "=$property[\"GITHUB_TOKEN\"]",
                "templateRepoURL": "=$property[\"TEMPLATE_REPO_URL\"]",
                "templateRef": "=$property[\"TEMPLATE_REF\"]",
                "templatePath": "=$flow.template_name",
                "replacementList": "=$activity[BuildScaffoldRequest].output.replacement_list",
                "ignoreEmptyValues": false,
                "replacementMode": "sequential",
                "renamePaths": true,
                "excludePatterns": "=$activity[BuildScaffoldRequest].output.exclude_patterns",
                "binaryExtensions": [],
                "maxTextBytes": 5242880,
                "outputPrefix": "=string.concat(\"code/\", $flow.repo_name)",
                "extraFiles": "=array.merge($activity[BuildScaffoldRequest].output.extra_files, $activity[RenderCICD].output.files)",
                "targetMode": "=$property[\"TARGET_MODE\"]",
                "targetRepoURL": "=($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $flow.repo_name) : $property[\"TARGET_REPO_URL\"]",
                "targetBranch": "=$property[\"TARGET_BRANCH\"]",
                "targetFolder": "=($property[\"TARGET_MODE\"] == \"newRepo\") ? \"\" : $flow.repo_name",
                "cleanTargetFolder": "=$flow.config_only == false",
                "newRepoPrivate": true,
                "newRepoDescription": "=string.concat(\"BWCE integration \", $flow.repo_name, \" (template \", $flow.template_name, \")\")",
                "failIfRepoExists": false,
                "apiBaseURL": "=$property[\"GITHUB_API_URL\"]",
                "commitMessage": "=string.concat(\"Generate repo: \", $flow.repo_name)",
                "authorName": "=$property[\"GIT_AUTHOR_NAME\"]",
                "authorEmail": "=$property[\"GIT_AUTHOR_EMAIL\"]",
                "dryRun": false,
                "pushRetries": 3,
                "writeStrategy": "auto",
                "timeoutSeconds": 120
              },
              "ref": "#act_gitreposcaffolder"
            },
            "id": "ScaffoldRepo",
            "name": "ScaffoldRepo",
            "description": "Applies the token map to the template and commits code + configs to GitHub in one commit"
          },
          {
            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "folder_url": "=$activity[ScaffoldRepo].folderURL",
                  "repo_url": "=$activity[ScaffoldRepo].repoURL",
                  "commit_sha": "=$activity[ScaffoldRepo].commitSHA",
                  "pushed": "=$activity[ScaffoldRepo].pushed",
                  "write_mode": "=$activity[ScaffoldRepo].writeMode",
                  "template_commit": "=$activity[ScaffoldRepo].templateCommit",
                  "files_total": "=$activity[ScaffoldRepo].filesTotal",
                  "files_modified": "=$activity[ScaffoldRepo].filesModified",
                  "paths_renamed": "=$activity[ScaffoldRepo].pathsRenamed",
                  "duration_ms": "=$activity[ScaffoldRepo].durationMs"
                }
              }
            },
            "id": "ReturnScaffold",
            "name": "ReturnScaffold",
            "description": "Returns the GitHub location and generation statistics"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "files": "=array.get(json.jq($activity[BuildScaffoldRequest].output.cicd, $activity[GetOps].output.data.cicd.render), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                }
              }
            },
            "id": "RenderCICD",
            "name": "RenderCICD",
            "description": "Renders .github/workflows/ci.yml, Jenkinsfile, k8s/deployment-<env>.yaml, config/runtime-<env>.json"
          }
        ],
