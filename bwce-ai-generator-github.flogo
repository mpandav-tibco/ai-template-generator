                "summary": "api_chat/init_POST",
                "operationId": "post_api_chat_init",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
