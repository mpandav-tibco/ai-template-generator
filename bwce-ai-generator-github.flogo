            "/k8s/{resource}": {
              "get": {
                "operationId": "k8s_GET",
                "summary": "Cluster health, current context, status overview, or a resource list",
                "tags": [
                  "Kubernetes"
                ],
                "parameters": [
                  {
                    "name": "resource",
                    "in": "path",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "enum": [
                        "health",
                        "context",
                        "status",
                        "deployments",
                        "pods",
                        "services",
                        "events"
                      ]
                    }
                  },
                  {
                    "name": "app_label",
                    "in": "query",
                    "required": false,
                    "description": "status: label value of `app`",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "label_selector",
                    "in": "query",
                    "required": false,
                    "description": "deployments, pods, services",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "limit",
                    "in": "query",
                    "required": false,
                    "description": "events: newest N (1-1000)",
                    "schema": {
                      "type": "integer",
                      "default": 10
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Operation result (kubectl-style fields; success and timestamp always present)",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/K8sResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "404": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "502": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "503": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
