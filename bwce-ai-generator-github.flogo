    {
      "id": "flow:StartupFlow",
      "data": {
        "name": "StartupFlow",
        "description": "Application bootstrap: loads the template registry, IKD ids, operations programs and Kubernetes contexts into shared data, creates or upgrades the PostgreSQL tables, then ingests the templates into Weaviate.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadTemplateRegistry",
            "type": "label",
            "label": "StartActivity to ReadTemplateRegistry"
          },
          {
            "id": 2,
            "from": "ReadTemplateRegistry",
            "to": "ParseTemplateRegistry",
            "type": "label",
            "label": "ReadTemplateRegistry to ParseTemplateRegistry"
          },
          {
            "id": 3,
            "from": "ParseTemplateRegistry",
            "to": "StoreConfigToSharedData",
            "type": "label",
            "label": "ParseTemplateRegistry to StoreConfigToSharedData"
          },
          {
            "id": 4,
            "from": "StoreConfigToSharedData",
            "to": "ReadIKDInterfaces",
            "type": "label",
            "label": "StoreConfigToSharedData to ReadIKDInterfaces"
          },
          {
            "id": 5,
            "from": "ReadIKDInterfaces",
            "to": "ParseIKDInterfaces",
            "type": "label",
            "label": "ReadIKDInterfaces to ParseIKDInterfaces"
          },
          {
            "id": 6,
            "from": "ParseIKDInterfaces",
            "to": "ReadIKDScenarios",
            "type": "label",
            "label": "ParseIKDInterfaces to ReadIKDScenarios"
          },
          {
            "id": 7,
            "from": "ReadIKDScenarios",
            "to": "ParseIKDScenarios",
            "type": "label",
            "label": "ReadIKDScenarios to ParseIKDScenarios"
          },
          {
            "id": 8,
            "from": "ParseIKDScenarios",
            "to": "StoreIKD",
            "type": "label",
            "label": "ParseIKDScenarios to StoreIKD"
          },
          {
            "id": 9,
            "from": "StoreIKD",
            "to": "ReadOps",
            "type": "label",
            "label": "StoreIKD to ReadOps"
          },
          {
            "id": 10,
            "from": "ReadOps",
            "to": "ParseOps",
            "type": "label",
            "label": "ReadOps to ParseOps"
          },
          {
            "id": 11,
            "from": "ParseOps",
            "to": "StoreOps",
            "type": "label",
            "label": "ParseOps to StoreOps"
          },
          {
            "id": 12,
            "from": "StoreOps",
            "to": "K8sConfig",
            "type": "label",
            "label": "StoreOps to K8sConfig"
          },
          {
            "id": 13,
            "from": "K8sConfig",
            "to": "K8sInit",
            "type": "label",
            "label": "K8sConfig to K8sInit"
          },
          {
            "id": 14,
            "from": "K8sInit",
            "to": "StoreK8s",
            "type": "label",
            "label": "K8sInit to StoreK8s"
          },
          {
            "id": 15,
            "from": "StoreK8s",
            "to": "CreateSchema",
            "type": "label",
            "label": "StoreK8s to CreateSchema"
          },
          {
            "id": 16,
            "from": "CreateSchema",
            "to": "CreateCollection",
            "type": "label",
            "label": "CreateSchema to CreateCollection"
          },
          {
            "id": 17,
            "from": "CreateCollection",
            "to": "IngestTemplates",
            "type": "label",
            "label": "CreateCollection to IngestTemplates"
          },
