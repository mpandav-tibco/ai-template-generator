                "content": "=$activity[BuildGenerateArgs].output.content",
                "trusted": true
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {}}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {}}, \"headers\": {\"type\": \"object\", \"properties\": {}}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"result\": {\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"duplicate\": {\"type\": \"boolean\"}, \"shell_command\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"result\": {\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"duplicate\": {\"type\": \"boolean\"}, \"shell_command\": {\"type\": \"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildGenResult",
