                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "ikd_rows",
                    "Type": "INTEGER",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
