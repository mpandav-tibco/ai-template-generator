                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/schema5"
                        }
                      }
                    }
                  }
                },
                "description": "Handles one turn of the conversational spec-building flow (POST /api/chat/message). Uses an LLM to extract integration fields from the user's message, checks spec completeness, and asks the next clarifying question.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
