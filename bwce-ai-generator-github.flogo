              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[CreateSession].output"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIkNyZWF0ZVNlc3Npb24iOnsieCI6NDUwLCJ5Ijo0NX0sIlN0b3JlU2Vzc2lvbiI6eyJ4Ijo2NTAsInkiOjQ1fSwiUmVwbHlfdG9fQVBJIjp7IngiOjI1MCwieSI6MTk1fX0=",
