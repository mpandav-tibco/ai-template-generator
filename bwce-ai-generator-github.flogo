                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}"
