          {
            "id": "SelectTemplate",
            "name": "SelectTemplate",
            "description": "Runs a semantic (RAG) vector search over the Weaviate template collection to pick the best-matching BWCE template for the spec.",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:P1PSaOKsv2tWeKymdaotN92DcLbXgw==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": true,
                "hybridAlpha": 0.25,
                "enableLLMGenerate": false,
                "llmProvider": "Ollama",
                "llmBaseURL": "=$property[\"LLM_BASE_URL\"]",
                "llmAPIKey": "",
                "llmModel": "=$property[\"LLM_MODEL\"]",
                "systemPrompt": "You are a helpful assistant. Answer the question using only the provided context. If the context does not contain enough information, say so.",
                "maxTokens": 1024,
                "temperature": 0.1
              },
              "input": {
                "queryText": "=string.concat($activity[NormalizeSpec].output.source_system, \" to \", $activity[NormalizeSpec].output.target_system, \" \", $activity[NormalizeSpec].output.business_object, \" \", $activity[NormalizeSpec].output.interface_type, \" \", $activity[NormalizeSpec].output.template_type, \" \", coerce.toString($flow.content.context))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 3
              }
            }
          },
          {
            "id": "ResolveTemplateName",
            "name": "ResolveTemplateName",
            "description": "Resolves the actual template selected by the Weaviate vector search (sourceDocuments[0].id) and exposes it alongside the requested template_type. Falls back to the requested template when no match is returned.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "template_name": "=(coerce.toString($activity[NormalizeSpec].output.template_type) != \"\" && array.contains($activity[GetCatalog].output.data.template_ids, coerce.toString($activity[NormalizeSpec].output.template_type))) ? coerce.toString($activity[NormalizeSpec].output.template_type) : coerce.toString($activity[SelectTemplate].sourceDocuments[0].id)",
                    "requested_template": "=coerce.toString($activity[NormalizeSpec].output.template_type)",
                    "match_score": "=coerce.toString($activity[SelectTemplate].sourceDocuments[0].score)",
                    "template_source": "=(coerce.toString($activity[NormalizeSpec].output.template_type) != \"\" && array.contains($activity[GetCatalog].output.data.template_ids, coerce.toString($activity[NormalizeSpec].output.template_type))) ? \"requested\" : \"vector\""
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"template_name\": {\"type\": \"string\"}, \"requested_template\": {\"type\": \"string\"}, \"match_score\": {\"type\": \"string\"}, \"template_source\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
