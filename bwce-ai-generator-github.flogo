        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIkNyZWF0ZVNlc3Npb24iOnsieCI6NDUwLCJ5Ijo0NX0sIlN0b3JlU2Vzc2lvbiI6eyJ4Ijo2NTAsInkiOjQ1fSwiUmVwbHlfdG9fQVBJIjp7IngiOjI1MCwieSI6MTk1fX0=",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] api_chat/init_POST failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
            },
            {
              "id": "BuildError",
              "name": "BuildError",
              "description": "Builds the structured HTTP 500 error body from the flow error.",
              "activity": {
                "ref": "#mapper",
                "input": {
                  "input": {
                    "mapping": {
                      "success": false,
                      "error": "INTERNAL_ERROR",
                      "message": "=coerce.toString($error.message)",
                      "activity": "=coerce.toString($error.activity)",
                      "code": "=coerce.toString($error.code)"
                    }
                  }
                },
                "schemas": {
                  "output": {
                    "output": {
                      "type": "json",
                      "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}",
                      "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the structured error body.",
              "activity": {
                "ref": "#actreply",
                "input": {
                  "reply": {
                    "mapping": {
                      "code": 500,
                      "data": "=$activity[BuildError].output"
                    }
                  }
                },
                "schemas": {
                  "input": {
                    "reply": {
                      "type": "json",
                      "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                      "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            }
          ],
          "links": [
            {
              "id": 5,
              "from": "LogError",
              "to": "BuildError",
              "type": "label",
              "label": "LogError to BuildError"
            },
            {
              "id": 6,
              "from": "BuildError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object"
            },
            {
              "name": "headers",
              "type": "object"
            },
            {
              "name": "trusted",
              "type": "boolean"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:api_chat/message_POST",
      "data": {
        "name": "api_chat/message_POST",
        "description": "Handles one turn of the conversational spec-building flow (POST /api/chat/message). Uses an LLM to extract integration fields from the user's message, checks spec completeness, and asks the next clarifying question.",
        "links": [
          {
            "id": 1,
            "from": "Log_API",
            "to": "GetSession",
            "type": "label",
            "label": "Log_API to GetSession"
          },
          {
            "id": 2,
            "from": "MergeSpec",
            "to": "ComputeMissing",
            "type": "label",
            "label": "MergeSpec to ComputeMissing"
          },
          {
            "id": 3,
            "from": "ComputeMissing",
            "to": "ParseMissing",
            "type": "label",
            "label": "ComputeMissing to ParseMissing"
          },
          {
            "id": 4,
            "from": "ParseMissing",
            "to": "BuildChatResponse",
            "type": "label",
            "label": "ParseMissing to BuildChatResponse"
          },
          {
            "id": 5,
            "from": "BuildChatResponse",
            "to": "SaveSession",
            "type": "label",
            "label": "BuildChatResponse to SaveSession"
          },
          {
            "id": 6,
            "from": "SaveSession",
            "to": "ReplyChat",
            "type": "label",
            "label": "SaveSession to ReplyChat"
          },
          {
            "id": 7,
            "from": "GetSession",
            "to": "ExtractSpec",
            "type": "label",
            "label": "GetSession to ExtractSpec"
          },
          {
            "id": 8,
            "from": "ExtractSpec",
            "to": "MergeSpec",
            "type": "label",
            "label": "ExtractSpec to MergeSpec"
          },
          {
            "id": 9,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 10,
            "from": "Authorize",
            "to": "Log_API",
            "type": "expression",
            "label": "Authorize to Log_API",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 11,
            "from": "Authorize",
            "to": "RejectAuth",
            "type": "expression",
            "label": "Authorize to RejectAuth",
            "value": "$activity[Authorize].ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the incoming chat message.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[CHAT] Processing chat message\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "GetSession",
            "name": "GetSession",
            "description": "Loads the conversation session row from the PostgreSQL chat_session table by session id.",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 1000
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT session_id, status, source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id, missing_fields, ready_to_generate FROM public.chat_session WHERE session_id = ?session_id;",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "session_id",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "status",
