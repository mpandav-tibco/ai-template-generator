            "from": "Decide",
            "to": "Audit",
            "type": "expression",
            "label": "Decide to Audit",
            "value": "$activity[Decide].output.d.locked == true"
          },
          {
            "id": 8,
            "from": "Decide",
            "to": "RecordFailure",
            "type": "expression",
            "label": "Decide to RecordFailure",
            "value": "$activity[Decide].output.d.ok != true && $activity[Decide].output.d.locked != true"
          },
          {
            "id": 9,
            "from": "RecordFailure",
            "to": "Audit",
            "type": "label",
            "label": "RecordFailure to Audit"
          },
          {
            "id": 10,
            "from": "Decide",
            "to": "ClearAttempts",
            "type": "expression",
            "label": "Decide to ClearAttempts",
            "value": "$activity[Decide].output.d.ok == true"
          },
          {
            "id": 11,
            "from": "ClearAttempts",
            "to": "Sign",
            "type": "label",
            "label": "ClearAttempts to Sign"
          },
          {
