              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"r\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"r\": {\"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}}}"
