                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/CodeReviewRunRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Review result",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/CodeReviewRunResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "502": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
