            "name": "ReturnProbe",
            "description": "Returns the response of Probe",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "status": "=$activity[Probe].statusCode",
                  "text": "=$activity[Probe].responseBody.data",
                  "json": "=array.get(json.jq(coerce.toObject($activity[Probe].responseBody), \"try ((.data // \\\"\\\") | fromjson) catch null\"), 0)",
                  "content_type": "=array.get(json.jq(coerce.toObject($activity[Probe].headers), \".[\\\"Content-Type\\\"] // \\\"\\\"\"), 0)",
                  "elapsed_ms": "=$activity[Probe].responseTimeInMilliSec",
