    {
      "id": "flow:WriteAudit",
      "data": {
        "name": "WriteAudit",
        "description": "Appends an audit entry and keeps the newest 2000 (reference audit log retention)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "InsertAudit",
            "type": "label",
            "label": "StartActivity to InsertAudit"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "WITH ins AS (INSERT INTO public.audit_log (username, display_name, role, ip, action, path, message, mechanism) VALUES (?username, ?display_name, ?role, ?ip, ?action, ?path, ?message, ?mechanism) RETURNING id) DELETE FROM public.audit_log WHERE id <= (SELECT id FROM ins) - 2000 RETURNING id",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "username",
                    "Type": "VARCHAR",
                    "Selected": false,
