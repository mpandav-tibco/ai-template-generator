    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Model Context Protocol (MCP) server. Exposes the generator's capabilities as MCP tools (extract_spec, generate_code, list_templates) so AI assistants and agents can drive integration generation.",
      "settings": {
        "serverName": "bwce-ai-generator",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": "",
        "oauthIssuer": "",
        "oauthJWKSURL": "",
        "oauthAudience": "",
        "oauthAuthorizationServers": "",
        "oauthRequiredScopes": "",
        "oauthResourceURL": ""
      },
      "id": "MCPServer",
      "handlers": [
        {
          "description": "MCP tool 'extract_spec'. Wraps the extract flow so AI agents can turn a natural-language description into a structured BWCE spec.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "extract_spec",
            "handlerDescription": "Extract BWCE integration spec from natural language description",
            "toolTitle": "",
            "readOnlyToolHint": "True",
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": "False",
            "scope": ""
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPExtractSpecTool"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "reply": {
            "outputSchema": ""
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}",
                "fe_metadata": "{\r\n  \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"audience\": {\r\n      \"type\": \"array\",\r\n      \"items\": {\r\n        \"type\": \"string\"\r\n      }\r\n    },\r\n    \"priority\": {\r\n      \"type\": \"number\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n  }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\", \"description\": \"Free-text description of the integration\"}, \"current_spec\": {\"type\": \"object\", \"description\": \"Spec collected so far (optional)\", \"properties\": {}}}, \"required\": [\"message\"]}",
                "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\", \"description\": \"Free-text description of the integration\"}, \"current_spec\": {\"type\": \"object\", \"description\": \"Spec collected so far (optional)\", \"properties\": {}}}, \"required\": [\"message\"]}"
              }
            }
          },
          "name": "MCPExtractSpecTool"
        },
        {
          "description": "MCP tool 'generate_code': runs /generate (validation, IKD check, template selection, GitHub publication, registry, notification) and returns its result to the calling agent.",
