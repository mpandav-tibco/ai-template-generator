                "RuntimeQuery": "",
                "State": "09ad4998-770d-55b1-8036-f783c492d105INSERT INTO public.ikd_registry (kind, ikd_value, repo_name) SELECT t.k, t.v, ?repo ::text FROM (VALUES ('InterfaceIDs', ?iid ::text), ('ScenarioIDs', ?sid ::text)) AS t(k, v) WHERE ?config_only <> 'true' AND t.v <> '' ON CONFLICT (kind, repo_name) DO UPDATE SET ikd_value = EXCLUDED.ikd_value, updated_at = now() RETURNING kind",
                "input": {
                  "mapping": {
