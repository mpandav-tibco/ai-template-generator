  "resources": [
    {
      "id": "flow:health_GET",
      "data": {
        "name": "health_GET",
        "description": "Health-check endpoint (GET /health). Returns service status so load balancers and monitoring probes can verify the generator is running.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "Reply_to_API",
            "type": "label",
            "label": "Log_API to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs that a health check was requested.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[HEALTH] Health check requested\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns HTTP 200 with service status confirming the generator is healthy.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "status": "healthy",
                        "version": "1.0.0",
                        "service": "bwce-ai-generator",
                        "engine": "TIBCO Flogo"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIlJlcGx5X3RvX0FQSSI6eyJ4Ijo0NTEsInkiOjQ1fX0=",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "output": "{\"type\": \"object\", \"title\": \"Outputs\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": false
      }
    },
    {
      "id": "flow:api_templates_GET",
      "data": {
        "name": "api_templates_GET",
        "description": "Lists available BWCE integration templates (GET /api/templates) from the cached template registry.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "GetTemplateList",
            "type": "label",
            "label": "Log_API to GetTemplateList"
          },
          {
            "id": 3,
            "from": "GetTemplateList",
            "to": "Reply_to_API",
            "type": "label",
            "label": "GetTemplateList to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the templates-listing request.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[TEMPLATES] Listing available templates\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "GetTemplateList",
            "name": "GetTemplateList",
            "description": "Reads the cached template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object",
                "objectSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"templates\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"interface_types\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"cdm\": {\n            \"type\": \"boolean\"\n          }\n        }\n      }\n    },\n    \"aliases\": {\n      \"type\": \"object\"\n    }\n  }\n}"
              },
              "input": {
                "key": "\"APP_CONFIG\""
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"exist\":{\"type\":\"boolean\"},\"data\":{\"type\":\"object\",\"properties\":{\"templates\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"interface_types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"cdm\":{\"type\":\"boolean\"}}}},\"aliases\":{\"type\":\"object\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"exist\":{\"type\":\"boolean\"},\"data\":{\"type\":\"object\",\"properties\":{\"templates\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"interface_types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"cdm\":{\"type\":\"boolean\"}}}},\"aliases\":{\"type\":\"object\"}}}}}"
                  }
                },
                "settings": {
                  "objectSchema": "schema://AppConfig"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns the list of available templates to the caller.",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[GetTemplateList].output.data"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIkdldFRlbXBsYXRlTGlzdCI6eyJ4Ijo0NTAsInkiOjQ1fSwiUmVwbHlfdG9fQVBJIjp7IngiOjY1MCwieSI6NDV9fQ==",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] api_templates_GET failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
