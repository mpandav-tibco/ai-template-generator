                      }
                    }
                  },
                  "500": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/chat/reset": {
              "post": {
                "operationId": "api_chat/reset_POST",
                "summary": "Reset a conversation",
                "tags": [
                  "Chat"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
