            "activity": {
              "input": {
                "mappings": []
              },
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "response": "=$activity[BuildGenResult].output.response"
                }
              }
            }
          }
        ],
        "fe_metadata": "",
