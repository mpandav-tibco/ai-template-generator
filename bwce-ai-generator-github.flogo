                      "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                      "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the error (activity, code, message)",
              "activity": {
                "ref": "#actreturn",
                "settings": {
                  "mappings": {
                    "code": 500,
                    "responseBody": {
                      "mapping": {
                        "body": {
                          "success": false,
                          "error": "INTERNAL_ERROR",
                          "message": "=coerce.toString($error.message)",
                          "activity": "=coerce.toString($error.activity)",
                          "code": "=coerce.toString($error.code)"
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "links": [
            {
              "id": 4,
              "from": "LogError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"session_id\":{\"type\":\"string\"}}"
              }
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"session_id\": {\"type\": \"string\"}}}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:extract_POST",
      "data": {
        "name": "extract_POST",
        "description": "Extracts a structured BWCE integration spec from a free-text description (POST /extract) with the LLM and reports any missing required fields.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ExtractSpec",
            "type": "label",
            "label": "Log_API to ExtractSpec"
          },
          {
            "id": 2,
            "from": "ExtractSpec",
            "to": "MergeSpec",
            "type": "label",
            "label": "ExtractSpec to MergeSpec"
          },
          {
            "id": 3,
            "from": "MergeSpec",
            "to": "BuildExtractResponse",
            "type": "label",
            "label": "MergeSpec to BuildExtractResponse"
          },
          {
            "id": 4,
            "from": "BuildExtractResponse",
            "to": "ReturnSpec",
            "type": "label",
            "label": "BuildExtractResponse to ReturnSpec"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ExtractSpec",
            "name": "ExtractSpec",
            "description": "Shared NLU extraction (ExtractSpecCore)",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:ExtractSpecCore",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "content": "=$flow.content"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"product_area\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"need_secret\": {\"type\": \"boolean\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"github_project\": {\"type\": \"string\"}}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"product_area\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"need_secret\": {\"type\": \"boolean\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"github_project\": {\"type\": \"string\"}}}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"extraction\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"answer\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"extraction\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"answer\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "MergeSpec",
            "name": "MergeSpec",
            "description": "Merges the LLM-extracted fields with the caller's current_spec (extracted value wins when present).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=(isDefined($flow.content.current_spec.source_system) && coerce.toString($flow.content.current_spec.source_system) != \"\") ? coerce.toString($flow.content.current_spec.source_system) : coerce.toString($activity[ExtractSpec].extraction.source_system)",
                    "target_system": "=(isDefined($flow.content.current_spec.target_system) && coerce.toString($flow.content.current_spec.target_system) != \"\") ? coerce.toString($flow.content.current_spec.target_system) : coerce.toString($activity[ExtractSpec].extraction.target_system)",
                    "business_object": "=(string.trim(string.replaceRegEx(\"\\s+\", string.replaceRegEx(\"(?i)\\b(idocs?|messages?|events?|records?|payloads?|master|data|files?|using|via|through|with|over|http|ems|kafka|rest|soap|sftp|api|queue|topic|service|to|from)\\b\", coerce.toString($activity[ExtractSpec].extraction.business_object), \" \"), \" \"), \" \") != \"\") ? string.trim(string.replaceRegEx(\"\\s+\", string.replaceRegEx(\"(?i)\\b(idocs?|messages?|events?|records?|payloads?|master|data|files?|using|via|through|with|over|http|ems|kafka|rest|soap|sftp|api|queue|topic|service|to|from)\\b\", coerce.toString($activity[ExtractSpec].extraction.business_object), \" \"), \" \"), \" \") : (isDefined($flow.content.current_spec.business_object) ? coerce.toString($flow.content.current_spec.business_object) : \"\")",
                    "interface_type": "=(coerce.toString($activity[ExtractSpec].extraction.interface_type) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.interface_type) : (isDefined($flow.content.current_spec.interface_type) ? coerce.toString($flow.content.current_spec.interface_type) : \"\")",
                    "template_type": "=(coerce.toString($activity[ExtractSpec].extraction.template_type) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.template_type) : (isDefined($flow.content.current_spec.template_type) ? coerce.toString($flow.content.current_spec.template_type) : \"\")",
                    "cdm": "=(coerce.toString($activity[ExtractSpec].extraction.cdm) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.cdm) : (isDefined($flow.content.current_spec.cdm) ? coerce.toString($flow.content.current_spec.cdm) : \"\")",
                    "interface_id": "=(coerce.toString($activity[ExtractSpec].extraction.interface_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.interface_id) : (isDefined($flow.content.current_spec.interface_id) ? coerce.toString($flow.content.current_spec.interface_id) : \"\")",
                    "scenario_id": "=(coerce.toString($activity[ExtractSpec].extraction.scenario_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.scenario_id) : (isDefined($flow.content.current_spec.scenario_id) ? coerce.toString($flow.content.current_spec.scenario_id) : \"\")",
                    "bitbucket_project": "=(coerce.toString($activity[ExtractSpec].extraction.bitbucket_project) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.bitbucket_project) : (isDefined($flow.content.current_spec.bitbucket_project) ? coerce.toString($flow.content.current_spec.bitbucket_project) : \"\")",
                    "email": "=(coerce.toString($activity[ExtractSpec].extraction.email) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.email) : (isDefined($flow.content.current_spec.email) ? coerce.toString($flow.content.current_spec.email) : \"\")",
                    "env": "=(coerce.toString($activity[ExtractSpec].extraction.env) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.env) : (isDefined($flow.content.current_spec.env) ? coerce.toString($flow.content.current_spec.env) : \"\")",
                    "k8s_domain": "=(coerce.toString($activity[ExtractSpec].extraction.k8s_domain) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.k8s_domain) : (isDefined($flow.content.current_spec.k8s_domain) ? coerce.toString($flow.content.current_spec.k8s_domain) : \"\")",
                    "country_code": "=(coerce.toString($activity[ExtractSpec].extraction.country_code) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.country_code) : (isDefined($flow.content.current_spec.country_code) ? coerce.toString($flow.content.current_spec.country_code) : \"\")",
                    "unique_id": "=(coerce.toString($activity[ExtractSpec].extraction.unique_id) != \"\") ? coerce.toString($activity[ExtractSpec].extraction.unique_id) : (isDefined($flow.content.current_spec.unique_id) ? coerce.toString($flow.content.current_spec.unique_id) : \"\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildExtractResponse",
            "name": "BuildExtractResponse",
            "description": "Assembles the /extract response: merged spec, readiness, missing required fields, and a human message.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "spec": {
                      "source_system": "=string.toUpper($activity[MergeSpec].output.source_system)",
                      "target_system": "=string.toUpper($activity[MergeSpec].output.target_system)",
                      "business_object": "=$activity[MergeSpec].output.business_object",
                      "interface_type": "=$activity[MergeSpec].output.interface_type",
                      "template_type": "=$activity[MergeSpec].output.template_type",
                      "cdm": "=$activity[MergeSpec].output.cdm",
                      "interface_id": "=$activity[MergeSpec].output.interface_id",
                      "scenario_id": "=$activity[MergeSpec].output.scenario_id",
                      "bitbucket_project": "=$activity[MergeSpec].output.bitbucket_project",
                      "email": "=$activity[MergeSpec].output.email",
                      "env": "=$activity[MergeSpec].output.env",
                      "k8s_domain": "=$activity[MergeSpec].output.k8s_domain",
                      "country_code": "=$activity[MergeSpec].output.country_code",
                      "unique_id": "=$activity[MergeSpec].output.unique_id"
                    },
                    "ready_to_generate": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\")",
                    "missing": {
                      "source_system": "=($activity[MergeSpec].output.source_system == \"\")",
                      "target_system": "=($activity[MergeSpec].output.target_system == \"\")",
                      "business_object": "=($activity[MergeSpec].output.business_object == \"\")",
                      "interface_type": "=($activity[MergeSpec].output.interface_type == \"\")",
                      "template_type": "=($activity[MergeSpec].output.template_type == \"\")"
                    },
                    "message": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\") ? \"All required fields captured — ready to generate.\" : \"Some required fields are still missing. Please provide the missing values.\"",
                    "raw_answer": "=coerce.toString($activity[ExtractSpec].answer)"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnSpec",
            "name": "ReturnSpec",
            "description": "Returns the extracted spec (REST reply and MCP extract_spec result)",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[BuildExtractResponse].output"
                    }
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkV4dHJhY3RTcGVjIjp7IngiOjI1MCwieSI6NDV9LCJNZXJnZVNwZWMiOnsieCI6NDUwLCJ5Ijo0NX0sIkJ1aWxkRXh0cmFjdFJlc3BvbnNlIjp7IngiOjY1MCwieSI6NDV9LCJSZXR1cm5TcGVjIjp7IngiOjI1MCwieSI6MTk1fX0=",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] extract_POST failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                },
                "schemas": {
                  "input": {
                    "dynamicLogFields": {
                      "type": "json",
                      "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
                      "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the error (activity, code, message)",
              "activity": {
                "ref": "#actreturn",
                "settings": {
                  "mappings": {
                    "code": 500,
                    "responseBody": {
                      "mapping": {
                        "body": {
                          "success": false,
                          "error": "INTERNAL_ERROR",
                          "message": "=coerce.toString($error.message)",
                          "activity": "=coerce.toString($error.activity)",
                          "code": "=coerce.toString($error.code)"
                        }
                      }
                    }
                  }
                }
              }
            }
          ],
          "links": [
            {
              "id": 5,
              "from": "LogError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ],
          "fe_metadata": "eyJMb2dFcnJvciI6eyJ4IjoyNTAsInkiOjE1MH0sIlJlcGx5RXJyb3IiOnsieCI6NjUwLCJ5IjozNTB9fQ=="
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"message\":{\"type\":\"string\"},\"current_spec\":{\"type\":\"object\",\"properties\":{\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"boolean\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"product_area\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"bw_profile\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"need_secret\":{\"type\":\"boolean\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"github_project\":{\"type\":\"string\"}}}}"
              }
            }
          ],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "responseBody",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"body\":{\"type\":\"any\"},\"headers\":{\"type\":\"object\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"message\": {\"type\": \"string\"}, \"current_spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"product_area\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"need_secret\": {\"type\": \"boolean\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"github_project\": {\"type\": \"string\"}}}}}}}",
            "output": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:generate_POST",
      "data": {
        "name": "generate_POST",
        "description": "Generates a BWCE integration repository from a spec (POST /generate): validation rules, IKD cross-check and duplicate check, template selection (the requested template or hybrid search), code generation and GitHub publication in one commit, registry and IKD registration, team e-mail.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "DeriveNaming",
            "type": "label",
            "label": "Log_API to DeriveNaming"
          },
          {
            "id": 2,
            "from": "DeriveNaming",
            "to": "NormalizeSpec",
            "type": "label",
            "label": "DeriveNaming to NormalizeSpec"
          },
          {
            "id": 3,
            "from": "NormalizeSpec",
            "to": "ValidateSpec",
            "type": "label",
            "label": "NormalizeSpec to ValidateSpec"
          },
          {
            "id": 4,
            "from": "ValidateSpec",
            "to": "GetIKD",
            "type": "expression",
            "label": "Spec valid (0 errors)",
            "value": "$activity[ValidateSpec].errorCount == 0"
          },
          {
            "id": 5,
            "from": "GetIKD",
            "to": "CrossCheckIKD",
            "type": "label",
            "label": "GetIKDScenarios to CrossCheckIKD"
          },
          {
            "id": 6,
            "from": "CrossCheckIKD",
            "to": "BuildIKDErrorResponse",
            "type": "expression",
            "label": "IKD invalid",
            "value": "$activity[CrossCheckIKD].output.ikd_valid == false"
          },
          {
            "id": 7,
            "from": "BuildIKDErrorResponse",
            "to": "ReturnIKDError",
            "type": "label",
            "label": "BuildIKDErrorResponse to ReturnIKDError"
          },
          {
            "id": 8,
            "from": "CrossCheckIKD",
            "to": "CheckDuplicate",
            "type": "expression",
            "label": "CrossCheckIKD to CheckDuplicate",
            "value": "$activity[CrossCheckIKD].output.ikd_valid == true"
          },
          {
            "id": 9,
            "from": "CheckDuplicate",
            "to": "SelectTemplate",
            "type": "expression",
            "label": "No duplicate or config-only",
            "value": "array.count($activity[CheckDuplicate].Output.records) == 0 || $activity[NormalizeSpec].output.config_only == true"
          },
          {
            "id": 10,
            "from": "SelectTemplate",
            "to": "GetCatalog",
            "type": "label",
            "label": "SelectTemplate to GetCatalog"
          },
          {
            "id": 11,
            "from": "GetCatalog",
            "to": "ResolveTemplateName",
            "type": "label",
            "label": "GetCatalog to ResolveTemplateName"
          },
          {
            "id": 12,
            "from": "ResolveTemplateName",
            "to": "ScaffoldArtifacts",
            "type": "label",
            "label": "ResolveTemplateName to ScaffoldArtifacts"
          },
          {
            "id": 13,
            "from": "ScaffoldArtifacts",
            "to": "RegisterGeneration",
            "type": "label",
            "label": "ScaffoldArtifacts to RegisterGeneration"
          },
          {
            "id": 14,
            "from": "RegisterGeneration",
            "to": "RegisterIKD",
            "type": "label",
            "label": "RegisterGeneration to RegisterIKD"
          },
          {
            "id": 15,
            "from": "RegisterIKD",
            "to": "NotifyTeam",
            "type": "label",
            "label": "RegisterIKD to NotifyTeam"
          },
          {
            "id": 16,
            "from": "NotifyTeam",
            "to": "BuildGenerateResponse",
            "type": "label",
            "label": "NotifyTeam to BuildGenerateResponse"
          },
          {
            "id": 17,
            "from": "BuildGenerateResponse",
            "to": "ReturnGenerate",
            "type": "label",
            "label": "BuildGenerateResponse to ReturnGenerate"
          },
          {
            "id": 18,
            "from": "CheckDuplicate",
            "to": "BuildDuplicateResponse",
            "type": "expression",
            "label": "Duplicate (full generate only)",
            "value": "array.count($activity[CheckDuplicate].Output.records) > 0 && $activity[NormalizeSpec].output.config_only == false"
          },
          {
            "id": 19,
            "from": "BuildDuplicateResponse",
            "to": "ReturnDuplicate",
            "type": "label",
            "label": "BuildDuplicateResponse to ReturnDuplicate"
          },
          {
            "id": 20,
            "from": "ValidateSpec",
            "to": "BuildValidationError",
            "type": "expression",
            "label": "Spec invalid",
            "value": "$activity[ValidateSpec].errorCount > 0"
          },
          {
            "id": 21,
            "from": "BuildValidationError",
            "to": "ReturnValidationError",
            "type": "label",
            "label": "BuildValidationError to ReturnValidationError"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "DeriveNaming",
            "name": "DeriveNaming",
            "description": "Derives the repository naming parts (product-area prefix, interface type, suffixes) from the spec",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "product_area": "=(coerce.toString($flow.content.spec.product_area) != \"\") ? string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) : string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \"))",
                    "repo_prefix": "=(coerce.toString($flow.content.spec.product_area) != \"\") ? ((string.startsWith(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\")) ? ((string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csddistribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd-distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd_distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-csd-sourcing\") ? \"incsdsourcing-\" : ((string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-tsi-siam\" || string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")) == \"product_area-tsi_siam\") ? \"intsisiam-\" : ((string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\") != \"\") ? string.concat(\"in\", string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.product_area), \" \")), \"product_area-\"), \"-\") : \"\"))) : \"\") : ((string.startsWith(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\")) ? ((string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csddistribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd-distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd_distribution\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-csd-sourcing\") ? \"incsdsourcing-\" : ((string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-tsi-siam\" || string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")) == \"product_area-tsi_siam\") ? \"intsisiam-\" : ((string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\") != \"\") ? string.concat(\"in\", string.substringAfter(string.toLower(string.trim(coerce.toString($flow.content.spec.github_project), \" \")), \"product_area-\"), \"-\") : \"\"))) : \"\")",
                    "repo_itype": "=(string.startsWith(string.toUpper(coerce.toString($flow.content.spec.template_type)), \"REST_SERVICE\") || string.startsWith(string.toUpper(coerce.toString($flow.content.spec.template_type)), \"SOAP_SERVICE\")) ? \"service\" : string.toLower(string.trim(coerce.toString($flow.content.spec.interface_type), \" \"))",
                    "business_object": "=(number.len(string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\")) > 40) ? string.substring(string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\"), 0, 40) : string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \")), \"---\"), \"---\")",
                    "unique_suffix": "=(string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"1none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"\") ? string.concat(\"-\", string.toLower(coerce.toString($flow.content.spec.unique_id))) : \"\"",
                    "country_suffix": "=(string.toLower(coerce.toString($flow.content.spec.country_code)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"1none\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"\") ? string.concat(\"-\", string.substringBefore(string.concat(string.toLower(coerce.toString($flow.content.spec.country_code)), \"---\"), \"---\")) : \"\""
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "NormalizeSpec",
            "name": "NormalizeSpec",
            "description": "Normalises the incoming spec: lowercases/trims identifiers and applies safe defaults (scenario_id=1234, env=DEV, k8s_domain=cite, bw_profile=default, interface_id/country_code/unique_id=NA).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.source_system), \" \")), \"---\"), \"---\")",
                    "target_system": "=string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.target_system), \" \")), \"---\"), \"---\")",
                    "business_object": "=$activity[DeriveNaming].output.business_object",
                    "interface_type": "=string.toLower(string.trim(coerce.toString($flow.content.spec.interface_type), \" \"))",
                    "template_type": "=coerce.toString($flow.content.spec.template_type)",
                    "bitbucket_project": "=coerce.toString($flow.content.spec.bitbucket_project)",
                    "email": "=(string.trim(coerce.toString($flow.content.spec.email), \" \") != \"\") ? string.trim(coerce.toString($flow.content.spec.email), \" \") : \"NA\"",
                    "cdm": "=$flow.content.spec.cdm == true",
                    "need_secret": "=$flow.content.spec.need_secret == true",
                    "interface_id": "=(coerce.toString($flow.content.spec.interface_id) != \"\") ? coerce.toString($flow.content.spec.interface_id) : \"NA\"",
                    "scenario_id": "=(coerce.toString($flow.content.spec.scenario_id) != \"\") ? coerce.toString($flow.content.spec.scenario_id) : \"1234\"",
                    "env": "=(coerce.toString($flow.content.spec.env) != \"\") ? coerce.toString($flow.content.spec.env) : \"DEV\"",
                    "k8s_domain": "=(coerce.toString($flow.content.spec.k8s_domain) != \"\") ? coerce.toString($flow.content.spec.k8s_domain) : \"cite\"",
                    "bw_profile": "=(coerce.toString($flow.content.spec.bw_profile) != \"\") ? coerce.toString($flow.content.spec.bw_profile) : \"default\"",
                    "country_code": "=(coerce.toString($flow.content.spec.country_code) != \"\") ? coerce.toString($flow.content.spec.country_code) : \"NA\"",
                    "unique_id": "=(coerce.toString($flow.content.spec.unique_id) != \"\") ? coerce.toString($flow.content.spec.unique_id) : \"NA\"",
                    "country_suffix": "=$activity[DeriveNaming].output.country_suffix",
                    "unique_suffix": "=$activity[DeriveNaming].output.unique_suffix",
                    "generation_id": "=utils.uuid()",
                    "config_only": "=$flow.content.config_only == true",
                    "product_area": "=$activity[DeriveNaming].output.product_area",
                    "repo_prefix": "=$activity[DeriveNaming].output.repo_prefix",
                    "repo_itype": "=$activity[DeriveNaming].output.repo_itype",
                    "repo_name": "=string.trim(string.replaceRegEx(\"-+\", string.replaceRegEx(\"[^a-z0-9-]+\", string.concat($activity[DeriveNaming].output.repo_prefix, string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.source_system), \" \")), \"---\"), \"---\"), \"-\", $activity[DeriveNaming].output.business_object, \"-\", string.substringBefore(string.concat(string.toLower(string.trim(coerce.toString($flow.content.spec.target_system), \" \")), \"---\"), \"---\"), $activity[DeriveNaming].output.unique_suffix, $activity[DeriveNaming].output.country_suffix, \"-\", $activity[DeriveNaming].output.repo_itype), \"-\"), \"-\"), \"-\")",
                    "target_mode": "=(string.toLower(coerce.toString($flow.content.target_mode)) == \"newrepo\") ? \"newRepo\" : ((string.toLower(coerce.toString($flow.content.target_mode)) == \"subfolder\") ? \"subfolder\" : $property[\"TARGET_MODE\"])"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"need_secret\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"config_only\": {\"type\": \"boolean\"}, \"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"repo_name\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"need_secret\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"config_only\": {\"type\": \"boolean\"}, \"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"repo_name\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"need_secret\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"config_only\": {\"type\": \"boolean\"}, \"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"repo_name\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"boolean\"}, \"need_secret\": {\"type\": \"boolean\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"bw_profile\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}, \"config_only\": {\"type\": \"boolean\"}, \"product_area\": {\"type\": \"string\"}, \"repo_prefix\": {\"type\": \"string\"}, \"repo_itype\": {\"type\": \"string\"}, \"repo_name\": {\"type\": \"string\"}, \"country_suffix\": {\"type\": \"string\"}, \"unique_suffix\": {\"type\": \"string\"}, \"generation_id\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ValidateSpec",
            "name": "ValidateSpec",
            "description": "Validates the incoming spec against required-field rules before generation.",
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=coerce.toString($activity[NormalizeSpec].output)",
                "fileName": "rules/spec-validation.yaml",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "json",
                "strict": true,
                "disabledRules": {
                  "mapping": [
                    "required_template_type"
                  ]
                },
                "tags": {
                  "mapping": [
                    "validation"
                  ]
                }
              }
            }
          },
          {
            "id": "GetIKD",
            "name": "GetIKD",
            "description": "Loads the valid IKD interface and scenario ids (APP_IKD) for the cross-check",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "APP_IKD",
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"interfaces\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"scenarios\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"exist\": {\"type\": \"boolean\"}, \"data\": {\"type\": \"object\", \"properties\": {\"interfaces\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"scenarios\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "CrossCheckIKD",
            "name": "CrossCheckIKD",
            "description": "Cross-checks the requested interface_id and scenario_id against the IKD registries (loaded into shared data at startup). Empty/absent IDs are treated as valid; otherwise the ID must exist in the registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "interface_id_valid": "=$activity[NormalizeSpec].output.interface_id == \"\" || array.contains($activity[GetIKD].output.data.interfaces, $activity[NormalizeSpec].output.interface_id)",
                    "scenario_id_valid": "=$activity[NormalizeSpec].output.scenario_id == \"\" || array.contains($activity[GetIKD].output.data.scenarios, $activity[NormalizeSpec].output.scenario_id)",
                    "ikd_valid": "=($activity[NormalizeSpec].output.interface_id == \"\" || array.contains($activity[GetIKD].output.data.interfaces, $activity[NormalizeSpec].output.interface_id)) && ($activity[NormalizeSpec].output.scenario_id == \"\" || array.contains($activity[GetIKD].output.data.scenarios, $activity[NormalizeSpec].output.scenario_id))"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://IKDCheck"
                },
                "output": {
                  "output": "schema://IKDCheck"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildIKDErrorResponse",
            "name": "BuildIKDErrorResponse",
            "description": "Builds a validation-error response when the interface_id and/or scenario_id are not registered in the IKD registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": false,
                    "error": "IKD_VALIDATION_FAILED",
                    "message": "=string.concat(\"IKD validation failed. interface_id='\", $activity[NormalizeSpec].output.interface_id, \"', scenario_id='\", $activity[NormalizeSpec].output.scenario_id, \"'. One or both are not present in the IKD registry.\")",
                    "interface_id_valid": "=$activity[CrossCheckIKD].output.interface_id_valid",
                    "scenario_id_valid": "=$activity[CrossCheckIKD].output.scenario_id_valid",
                    "interface_id": "=$activity[NormalizeSpec].output.interface_id",
                    "scenario_id": "=$activity[NormalizeSpec].output.scenario_id"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://IKDErrorResponse"
                },
                "output": {
                  "output": "schema://IKDErrorResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnIKDError",
            "name": "ReturnIKDError",
            "description": "Returns 400 when the interface or scenario id is not in the IKD registry",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[BuildIKDErrorResponse].output"
                    }
                  }
                }
              }
            }
          },
