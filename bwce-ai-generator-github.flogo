            "/k8s/deployments/{name}/{action}": {
              "post": {
                "operationId": "k8s_deployment_action_POST",
                "summary": "Scale or restart a deployment",
                "tags": [
                  "Kubernetes"
                ],
                "parameters": [
                  {
                    "name": "name",
                    "in": "path",
                    "required": true,
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "action",
                    "in": "path",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "enum": [
                        "scale",
                        "restart"
                      ]
                    }
                  }
                ],
                "requestBody": {
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/K8sScaleRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Operation result (kubectl-style fields; success and timestamp always present)",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/K8sResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "404": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "502": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "503": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/k8s/context/switch": {
              "post": {
                "operationId": "k8s_context_switch_POST",
                "summary": "Switch the active Kubernetes context",
                "tags": [
                  "Kubernetes"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/K8sContextSwitch"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Operation result (kubectl-style fields; success and timestamp always present)",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/K8sResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {
            "schemas": {
              "ErrorResponse": {
                "type": "object",
                "properties": {
                  "detail": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              },
              "HealthResponse": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "ok"
                  },
                  "service": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "engine": {
                    "type": "string"
                  }
                }
              },
              "IntegrationSpec": {
                "type": "object",
                "properties": {
                  "source_system": {
                    "type": "string",
                    "example": "s4hana"
                  },
                  "target_system": {
                    "type": "string",
                    "example": "kafka"
                  },
                  "business_object": {
                    "type": "string",
                    "example": "article"
                  },
                  "interface_type": {
                    "type": "string",
                    "enum": [
                      "pub",
                      "sub",
                      "service"
                    ]
                  },
                  "template_type": {
                    "type": "string",
                    "example": "REST_SERVICE_To_KAFKATopic"
                  },
                  "cdm": {
                    "type": "boolean",
                    "default": false
                  },
                  "interface_id": {
                    "type": "string",
                    "default": "NA"
                  },
                  "scenario_id": {
                    "type": "string",
                    "default": "1234"
                  },
                  "product_area": {
                    "type": "string"
                  },
                  "env": {
                    "type": "string",
                    "default": "DEV"
                  },
                  "bw_profile": {
                    "type": "string",
                    "default": "default"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "k8s_domain": {
                    "type": "string",
                    "default": "cite"
                  },
                  "need_secret": {
                    "type": "boolean",
                    "default": false
                  },
                  "country_code": {
                    "type": "string",
                    "default": "NA"
                  },
                  "unique_id": {
                    "type": "string",
                    "default": "NA"
                  }
                }
              },
              "ChatInitResponse": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "spec": {
                    "$ref": "#/components/schemas/IntegrationSpec"
                  }
                }
              },
              "ChatMessageRequest": {
                "type": "object",
                "required": [
                  "session_id",
                  "message"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string",
                    "example": "publish S4HANA article IDocs to a Kafka topic"
                  }
                }
              },
              "ChatMessageResponse": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "spec": {
                    "$ref": "#/components/schemas/IntegrationSpec"
                  },
                  "missing_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ready_to_generate": {
                    "type": "boolean"
                  }
                }
              },
              "ChatResetRequest": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  }
                }
              },
              "ChatResetResponse": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              },
              "TemplateListResponse": {
                "type": "object",
                "properties": {
                  "template_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "templates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "interface_types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "cdm": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              },
              "SuggestRequest": {
                "type": "object",
                "properties": {
                  "source_system": {
                    "type": "string"
                  },
                  "target_system": {
                    "type": "string"
                  },
                  "business_object": {
                    "type": "string"
                  },
                  "interface_type": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string",
                    "description": "Free text of the conversation"
                  }
                }
              },
              "SuggestResponse": {
                "type": "object",
                "properties": {
                  "suggestions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "score": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "ExtractRequest": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "from wms to Demandware for salesorder sub"
                  },
                  "current_spec": {
                    "$ref": "#/components/schemas/IntegrationSpec"
                  }
                }
              },
              "ExtractResponse": {
                "type": "object",
                "properties": {
                  "extracted_fields": {
                    "$ref": "#/components/schemas/IntegrationSpec"
                  },
                  "missing_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "confidence": {
                    "type": "number"
                  }
                }
              },
              "GenerateRequest": {
                "type": "object",
                "required": [
                  "spec"
                ],
                "properties": {
                  "spec": {
                    "$ref": "#/components/schemas/IntegrationSpec"
                  },
                  "config_only": {
                    "type": "boolean",
                    "default": false,
                    "description": "Refresh configs/ only and keep the code"
                  },
                  "context": {
                    "type": "string",
                    "description": "Conversation text used for template selection"
                  }
                }
              },
              "GenerateResponse": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "duplicate": {
                    "type": "boolean"
                  },
                  "repo_name": {
                    "type": "string",
                    "example": "s4hana-article-kafka-pub"
                  },
                  "repo_url": {
                    "type": "string"
                  },
                  "github_url": {
                    "type": "string"
                  },
                  "template_name": {
                    "type": "string"
                  },
                  "generation_id": {
                    "type": "string"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "TrackerResponse": {
                "type": "object",
                "properties": {
                  "target_mode": {
                    "type": "string"
                  },
                  "target_repo_url": {
                    "type": "string"
                  },
                  "target_branch": {
                    "type": "string"
                  },
                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "SchemaFile": {
                "type": "object",
                "required": [
                  "filename",
                  "content"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "example": "Article.xsd"
                  },
                  "content": {
                    "type": "string",
                    "description": "File text"
                  }
                }
              },
              "SchemaUploadRequest": {
                "type": "object",
                "required": [
                  "repository_name"
                ],
                "properties": {
                  "repository_name": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string",
                    "description": "source / target"
                  },
                  "content": {
                    "type": "string",
                    "description": "source / target"
                  },
                  "source_schemas": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SchemaFile"
                    },
                    "description": "batch"
                  },
                  "target_schemas": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SchemaFile"
                    },
                    "description": "batch"
                  }
                }
              },
              "SchemaUploadResponse": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "repository_name": {
                    "type": "string"
                  },
                  "uploaded_files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "message": {
                    "type": "string"
                  },
                  "github_url": {
                    "type": "string"
                  }
                }
              },
              "CodeReviewTokenResponse": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "userid": {
                    "type": "string"
                  },
                  "usertype": {
                    "type": "string"
                  },
                  "token_cached": {
                    "type": "boolean"
                  },
                  "updated_at": {
                    "type": "string"
                  }
                }
              },
              "CodeReviewRunRequest": {
                "type": "object",
                "required": [
                  "repoName",
                  "productName",
                  "version"
                ],
                "properties": {
                  "repoName": {
                    "type": "string"
                  },
                  "productName": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "checkbwdesign": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "CodeReviewRunResponse": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "repoName": {
                    "type": "string"
                  },
                  "productName": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "checkbwdesign": {
                    "type": "boolean"
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "CodeReviewHistoryResponse": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer"
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "K8sContextSwitch": {
                "type": "object",
                "required": [
                  "context"
                ],
                "properties": {
                  "context": {
                    "type": "string"
                  }
                }
              },
              "K8sScaleRequest": {
                "type": "object",
                "properties": {
                  "replicas": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Required for scale"
                  }
                }
              },
              "K8sResponse": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "success": {
                    "type": "boolean"
                  },
                  "timestamp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      {
        "protocol": "http",
        "port": "8081",
        "title": "MCPServer",
        "type": "public"
      }
    ],
    "flogoVersion": "2.26.5"
  }
}