    {
      "id": "flow:CodeReviewToken",
      "data": {
        "name": "CodeReviewToken",
        "description": "Code review session token: cached, fetched from getsession.jsp when missing or forced",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetToken",
            "type": "label",
            "label": "StartActivity to GetToken"
          },
          {
            "id": 2,
            "from": "GetToken",
            "to": "ReturnCached",
            "type": "expression",
            "label": "GetToken to ReturnCached",
            "value": "$flow.force != true && $activity[GetToken].output.exist == true"
          },
          {
            "id": 3,
            "from": "GetToken",
            "to": "ReturnUnconfigured",
            "type": "expression",
            "label": "GetToken to ReturnUnconfigured",
            "value": "($flow.force == true || $activity[GetToken].output.exist != true) && ($property[\"CODE_REVIEW_USERNAME\"] == \"\" || $property[\"CODE_REVIEW_PASSWORD\"] == \"\")"
          },
          {
            "id": 4,
            "from": "GetToken",
            "to": "GetOps",
            "type": "expression",
            "label": "GetToken to GetOps",
            "value": "($flow.force == true || $activity[GetToken].output.exist != true) && $property[\"CODE_REVIEW_USERNAME\"] != \"\" && $property[\"CODE_REVIEW_PASSWORD\"] != \"\""
          },
          {
            "id": 5,
            "from": "GetOps",
            "to": "TokenIn",
            "type": "label",
            "label": "GetOps to TokenIn"
          },
          {
            "id": 6,
            "from": "TokenIn",
            "to": "TokenPlan",
            "type": "label",
            "label": "TokenIn to TokenPlan"
          },
          {
            "id": 7,
            "from": "TokenPlan",
            "to": "FetchToken",
            "type": "label",
            "label": "TokenPlan to FetchToken"
          },
          {
            "id": 8,
            "from": "FetchToken",
            "to": "ResultIn",
            "type": "label",
            "label": "FetchToken to ResultIn"
          },
          {
            "id": 9,
            "from": "ResultIn",
            "to": "TokenResult",
            "type": "label",
            "label": "ResultIn to TokenResult"
          },
          {
            "id": 10,
            "from": "TokenResult",
            "to": "StoreToken",
            "type": "expression",
            "label": "TokenResult to StoreToken",
            "value": "$activity[TokenResult].output.r.ok == true"
          },
          {
            "id": 11,
            "from": "StoreToken",
            "to": "ReturnFetched",
            "type": "label",
            "label": "StoreToken to ReturnFetched"
          },
          {
            "id": 12,
            "from": "TokenResult",
            "to": "ReturnFailed",
            "type": "expression",
            "label": "TokenResult to ReturnFailed",
            "value": "$activity[TokenResult].output.r.ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetToken",
            "name": "GetToken",
            "description": "GetToken",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "APP_CODEREVIEW",
                "input": {
                  "mapping": {}
                }
              },
              "schemas": {
                "output": {
