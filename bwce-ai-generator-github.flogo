                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"d\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
            "id": "Debug",
            "name": "Debug",
            "description": "Debug"
