                "fe_metadata": "[{\"code\": 200, \"responseType\": \"object\", \"responseSchema\": \"{\\\"type\\\": \\\"object\\\", \\\"additionalProperties\\\": true, \\\"properties\\\": {\\\"success\\\": {\\\"type\\\": \\\"boolean\\\"}, \\\"timestamp\\\": {\\\"type\\\": \\\"string\\\"}}}\"}, {\"code\": 400, \"responseType\": \"object\", \"responseSchema\": \"{\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"detail\\\": {\\\"type\\\": \\\"string\\\"}, \\\"error\\\": {\\\"type\\\": \\\"string\\\"}, \\\"code\\\": {\\\"type\\\": \\\"string\\\"}}}\"}, {\"code\": 404, \"responseType\": \"object\", \"responseSchema\": \"{\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"detail\\\": {\\\"type\\\": \\\"string\\\"}, \\\"error\\\": {\\\"type\\\": \\\"string\\\"}, \\\"code\\\": {\\\"type\\\": \\\"string\\\"}}}\"}, {\"code\": 502, \"responseType\": \"object\", \"responseSchema\": \"{\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"detail\\\": {\\\"type\\\": \\\"string\\\"}, \\\"error\\\": {\\\"type\\\": \\\"string\\\"}, \\\"code\\\": {\\\"type\\\": \\\"string\\\"}}}\"}, {\"code\": 503, \"responseType\": \"object\", \"responseSchema\": \"{\\\"type\\\": \\\"object\\\", \\\"properties\\\": {\\\"detail\\\": {\\\"type\\\": \\\"string\\\"}, \\\"error\\\": {\\\"type\\\": \\\"string\\\"}, \\\"code\\\": {\\\"type\\\": \\\"string\\\"}}}\"}]"
