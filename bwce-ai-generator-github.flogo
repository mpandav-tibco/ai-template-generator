                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"p\": {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"string\"}, \"repo\": {\"type\": \"string\"}, \"xml\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"uploaded_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"message\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"p\": {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"string\"}, \"repo\": {\"type\": \"string\"}, \"xml\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"uploaded_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"message\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"p\": {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"string\"}, \"repo\": {\"type\": \"string\"}, \"xml\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"uploaded_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"message\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}}}}}"
                  }
