                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"content\": {\"type\": \"object\", \"properties\": {\"spec\": {\"type\": \"object\", \"properties\": {}}, \"config_only\": {\"type\": \"boolean\"}}}}}"
                  }
