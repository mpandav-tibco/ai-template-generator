    {
      "id": "flow:schemas_upload_POST",
      "data": {
        "name": "schemas_upload_POST",
        "description": "Uploads schemas into a generated repository's module: XSD to code/<repo>/<repo>.module/Schemas, WSDL and OpenAPI/Swagger to code/<repo>/<repo>.module/Service Descriptors (POST /api/schemas/upload/{source|target|batch})",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
          {
            "id": 2,
            "from": "GetOps",
            "to": "PlanIn",
            "type": "label",
            "label": "GetOps to PlanIn"
          },
          {
            "id": 3,
            "from": "PlanIn",
            "to": "Plan",
            "type": "label",
            "label": "PlanIn to Plan"
          },
          {
            "id": 4,
            "from": "Plan",
            "to": "ReturnBad",
            "type": "expression",
            "label": "Plan to ReturnBad",
            "value": "$activity[Plan].output.p.error != \"\""
          },
          {
            "id": 5,
            "from": "Plan",
            "to": "FindRepo",
            "type": "expression",
            "label": "Plan to FindRepo",
            "value": "$activity[Plan].output.p.error == \"\""
          },
          {
            "id": 6,
            "from": "FindRepo",
            "to": "ReturnUnknown",
            "type": "expression",
            "label": "FindRepo to ReturnUnknown",
            "value": "array.count($activity[FindRepo].Output.records) == 0"
          },
          {
            "id": 7,
            "from": "FindRepo",
            "to": "CheckXml",
            "type": "expression",
            "label": "FindRepo to CheckXml",
            "value": "array.count($activity[FindRepo].Output.records) > 0"
          },
          {
            "id": 8,
            "from": "CheckXml",
            "to": "ReturnInvalidXml",
            "type": "error",
            "label": "CheckXml to ReturnInvalidXml"
          },
          {
            "id": 9,
            "from": "CheckXml",
            "to": "Commit",
            "type": "label",
            "label": "CheckXml to Commit"
          },
          {
            "id": 10,
            "from": "Commit",
            "to": "ReturnDone",
            "type": "label",
            "label": "Commit to ReturnDone"
          }
        ],
        "tasks": [
