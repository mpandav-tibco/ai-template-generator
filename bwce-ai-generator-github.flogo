            "to": "GetTemplates",
            "type": "label",
            "label": "StartActivity to GetTemplates"
          },
          {
            "id": 2,
            "from": "GetTemplates",
            "to": "BuildListResult",
            "type": "label",
            "label": "GetTemplates to BuildListResult"
          },
          {
            "id": 3,
            "from": "BuildListResult",
            "to": "ReturnTemplates",
            "type": "label",
            "label": "BuildListResult to ReturnTemplates"
          }
        ],
        "tasks": [
          {
