            }
          },
          {
            "id": "Return",
            "name": "Return",
            "description": "Returns the HTTP response",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[K8s].code",
                  "responseBody": "=$activity[K8s].responseBody"
                }
              }
            }
