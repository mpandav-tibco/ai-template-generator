                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/schema2"
                        }
                      }
                    }
                  }
                },
                "description": "Starts a new conversational session (POST /api/chat/init). Creates an empty spec, allocates a session id, and stores the session in shared memory.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema3"
                      }
                    }
                  }
                }
              }
