                "input": {
                  "mapping": {
                    "r": "=array.get(json.jq($activity[Outcome].output, $activity[GetOps].output.data.codereview.run_result), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
