    {
      "id": "flow:k8s_api",
      "data": {
        "name": "k8s_api",
        "description": "Kubernetes operations: one data-driven pipeline for every /k8s endpoint (programs in APP_OPS.k8s)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 2,
            "from": "Authorize",
            "to": "Deny",
            "type": "expression",
            "label": "Authorize to Deny",
            "value": "$activity[Authorize].ok != true"
          },
          {
            "id": 3,
            "from": "Authorize",
            "to": "GetOps",
            "type": "expression",
            "label": "Authorize to GetOps",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 4,
            "from": "GetOps",
            "to": "GetK8s",
            "type": "label",
            "label": "GetOps to GetK8s"
          },
          {
            "id": 5,
            "from": "GetK8s",
            "to": "Facts",
            "type": "label",
            "label": "GetK8s to Facts"
          },
          {
            "id": 6,
            "from": "Facts",
            "to": "Plan",
            "type": "label",
            "label": "Facts to Plan"
          },
          {
            "id": 7,
            "from": "Plan",
            "to": "PlanError",
            "type": "expression",
            "label": "Plan to PlanError",
            "value": "$activity[Plan].output.plan.mode == \"error\""
          },
          {
            "id": 8,
            "from": "Plan",
            "to": "StoreK8s",
            "type": "expression",
            "label": "Plan to StoreK8s",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $flow.op == \"switch\""
          },
          {
            "id": 9,
            "from": "StoreK8s",
            "to": "AuditSwitch",
            "type": "label",
            "label": "StoreK8s to AuditSwitch"
          },
          {
            "id": 10,
            "from": "AuditSwitch",
            "to": "ReturnImmediate",
            "type": "label",
            "label": "AuditSwitch to ReturnImmediate"
          },
          {
            "id": 11,
            "from": "Plan",
            "to": "ReturnImmediate",
            "type": "expression",
            "label": "Plan to ReturnImmediate",
            "value": "$activity[Plan].output.plan.mode == \"immediate\" && $flow.op != \"switch\""
          },
          {
            "id": 12,
            "from": "Plan",
            "to": "Fetch",
            "type": "expression",
            "label": "Plan to Fetch",
            "value": "$activity[Plan].output.plan.mode == \"fetch\""
          },
          {
            "id": 13,
            "from": "Fetch",
            "to": "Collect",
            "type": "label",
            "label": "Fetch to Collect"
          },
          {
            "id": 14,
            "from": "Collect",
            "to": "Transform",
            "type": "label",
            "label": "Collect to Transform"
          },
          {
            "id": 15,
            "from": "Transform",
            "to": "AuditOp",
            "type": "expression",
            "label": "Transform to AuditOp",
            "value": "$activity[Plan].output.plan.audit != \"\" && $activity[Transform].output.out.code == 200"
          },
          {
            "id": 16,
            "from": "AuditOp",
            "to": "ReturnOp",
            "type": "label",
            "label": "AuditOp to ReturnOp"
          },
          {
            "id": 17,
            "from": "Transform",
            "to": "ReturnOp",
            "type": "expression",
            "label": "Transform to ReturnOp",
            "value": "$activity[Plan].output.plan.audit == \"\" || $activity[Transform].output.out.code != 200"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "=$flow.path",
                "admin_only": "=$flow.op == \"scale\" || $flow.op == \"restart\" || $flow.op == \"switch\"",
                "trusted": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller (session, bearer token or API key)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Authorize].status",
                  "data": "=$activity[Authorize].body"
                }
              }
            },
            "id": "Deny",
            "name": "Deny",
            "description": "Rejects unauthenticated (401) or non-admin (403) callers"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_OPS\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_K8S\"",
                "input": {
                  "mapping": {}
                }
              }
            },
            "id": "GetK8s",
            "name": "GetK8s",
            "description": "GetK8s"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "op": "=$flow.op",
                    "query": "=$flow.query",
                    "params": "=$flow.params",
                    "body": "=$flow.content",
                    "ctx": "=$activity[GetK8s].output.data.active",
                    "contexts": "=$activity[GetK8s].output.data.contexts",
                    "k8s": "=$activity[GetOps].output.data.k8s"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"op\": {\"type\": \"string\"}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"ctx\": {\"type\": \"object\", \"properties\": {}}, \"contexts\": {\"type\": \"object\", \"properties\": {}}, \"k8s\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"op\": {\"type\": \"string\"}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"ctx\": {\"type\": \"object\", \"properties\": {}}, \"contexts\": {\"type\": \"object\", \"properties\": {}}, \"k8s\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
            "id": "Facts",
            "name": "Facts",
            "description": "Facts"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "plan": "=array.get(json.jq($activity[Facts].output, $activity[GetOps].output.data.k8s.route), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"plan\": {\"type\": \"object\", \"properties\": {\"mode\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}, \"error_body\": {\"type\": \"object\", \"properties\": {}}, \"req\": {\"type\": \"object\", \"properties\": {}}, \"audit\": {\"type\": \"string\"}, \"audit_message\": {\"type\": \"string\"}, \"program\": {\"type\": \"string\"}, \"immediate\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}, \"calls\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"plan\": {\"type\": \"object\", \"properties\": {\"mode\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}, \"error_code\": {\"type\": \"integer\"}, \"error_body\": {\"type\": \"object\", \"properties\": {}}, \"req\": {\"type\": \"object\", \"properties\": {}}, \"audit\": {\"type\": \"string\"}, \"audit_message\": {\"type\": \"string\"}, \"program\": {\"type\": \"string\"}, \"immediate\": {\"type\": \"object\", \"properties\": {}}, \"active\": {\"type\": \"object\", \"properties\": {}}, \"calls\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}}}"
                  }
                }
              }
            },
            "id": "Plan",
            "name": "Plan",
            "description": "Plan"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Plan].output.plan.error_code",
                  "data": "=$activity[Plan].output.plan.error_body"
                }
              }
            },
            "id": "PlanError",
            "name": "PlanError",
            "description": "PlanError"
          },
          {
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "=\"APP_K8S\"",
                "input": {
                  "mapping": {
                    "data": {
                      "contexts": "=$activity[GetK8s].output.data.contexts",
                      "active": "=$activity[Plan].output.plan.active"
                    }
                  }
                }
              }
            },
            "id": "StoreK8s",
            "name": "StoreK8s",
            "description": "Switches the active context"
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:WriteAudit",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "username": "=$activity[Authorize].username",
                "display_name": "=$activity[Authorize].display_name",
                "role": "=$activity[Authorize].role",
                "ip": "=$activity[Authorize].ip",
                "mechanism": "=$activity[Authorize].mechanism",
                "action": "=$activity[Plan].output.plan.audit",
                "path": "=$flow.path",
                "message": "=$activity[Plan].output.plan.audit_message"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
