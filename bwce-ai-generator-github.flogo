    {
      "id": "flow:RecordCodeReview",
      "data": {
        "name": "RecordCodeReview",
        "description": "Appends a code review run to the history (keeps the newest 500)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "InsertHistory",
            "type": "label",
            "label": "StartActivity to InsertHistory"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "WITH ins AS (INSERT INTO public.code_review_history (repo_name, product_name, version, checkbwdesign, status, error, links, master_html, app_html) VALUES (?repo, ?product, ?version, ?checkbwdesign = 'true', ?status, NULLIF(?error, ''), COALESCE(NULLIF(?links, ''), '[]')::jsonb, NULLIF(?master, ''), NULLIF(?app, '')) RETURNING id) DELETE FROM public.code_review_history WHERE id <= (SELECT id FROM ins) - 500 RETURNING id",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "product",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
