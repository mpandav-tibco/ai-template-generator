    {
      "id": "flow:auth_login_POST",
      "data": {
        "name": "auth_login_POST",
        "description": "Local account login (POST /api/login): lockout, bcrypt check, HS256 session cookie, audit",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetOps",
            "type": "label",
            "label": "StartActivity to GetOps"
          },
