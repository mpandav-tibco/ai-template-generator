                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}, \"action\": {\"type\": \"string\"}, \"path\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}, \"action\": {\"type\": \"string\"}, \"path\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}}}}}"
