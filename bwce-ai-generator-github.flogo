  "name": "bwce-ai-generator-github",
  "description": "AI-powered accelerator that generates TIBCO BusinessWorks Container Edition (BWCE) integration repositories from natural-language requirements. Exposes a REST API and an MCP server; uses an LLM to extract a structured integration spec through conversation, selects the best-matching template via Weaviate vector search, and records each generation in PostgreSQL.",
  "version": "1.0.0",
  "type": "flogo:app",
  "appModel": "1.1.1",
  "tags": [],
  "triggers": [
    {
      "ref": "#rest_1",
      "name": "tibco-wi-rest",
      "description": "AI-powered accelerator that generates TIBCO BWCE integration repositories through natural language conversation",
      "settings": {
        "port": 9999,
        "APISpecUpdate": true,
        "swagger": "spec://9fa13808-932f-485a-94b0-2ccbe0cb3547",
        "swaggerVersion": "v3",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "BWCEAIIntegrationGenerator",
      "handlers": [
