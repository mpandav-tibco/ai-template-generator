                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnNotFound",
            "name": "ReturnNotFound",
            "description": "Returns 404 when the repository is not in the registry",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 404,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "success": false,
                        "error": "NOT_FOUND",
                        "detail": "=string.concat(\"Repository \", coerce.toString($flow.params.repo_name), \" is not in the generation registry.\")"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "Plan",
            "name": "Plan",
            "description": "Where the repository lives: stored location, else the TARGET_* properties",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "repo_name": "=$activity[FindEntry].Output.records[0].repo_name",
                    "template_name": "=coerce.toString($activity[FindEntry].Output.records[0].template_name)",
                    "target_mode": "=(coerce.toString($activity[FindEntry].Output.records[0].target_mode) != \"\") ? coerce.toString($activity[FindEntry].Output.records[0].target_mode) : $property[\"TARGET_MODE\"]",
                    "github_url": "=(coerce.toString($activity[FindEntry].Output.records[0].github_url) != \"\") ? coerce.toString($activity[FindEntry].Output.records[0].github_url) : (($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $activity[FindEntry].Output.records[0].repo_name) : string.concat($property[\"TARGET_REPO_URL\"], \"/tree/\", $property[\"TARGET_BRANCH\"], \"/\", $activity[FindEntry].Output.records[0].repo_name))",
                    "repo_url": "=(string.contains(coerce.toString($activity[FindEntry].Output.records[0].github_url), \"/tree/\")) ? string.substringBefore(coerce.toString($activity[FindEntry].Output.records[0].github_url), \"/tree/\") : ((coerce.toString($activity[FindEntry].Output.records[0].github_url) != \"\") ? coerce.toString($activity[FindEntry].Output.records[0].github_url) : (($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $activity[FindEntry].Output.records[0].repo_name) : $property[\"TARGET_REPO_URL\"]))",
                    "branch": "=(string.contains(coerce.toString($activity[FindEntry].Output.records[0].github_url), \"/tree/\")) ? string.substringBefore(string.substringAfter(coerce.toString($activity[FindEntry].Output.records[0].github_url), \"/tree/\"), string.concat(\"/\", $activity[FindEntry].Output.records[0].repo_name)) : $property[\"TARGET_BRANCH\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"repo_url\": {\"type\": \"string\"}, \"branch\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"repo_url\": {\"type\": \"string\"}, \"branch\": {\"type\": \"string\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"repo_url\": {\"type\": \"string\"}, \"branch\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"repo_name\": {\"type\": \"string\"}, \"template_name\": {\"type\": \"string\"}, \"target_mode\": {\"type\": \"string\"}, \"github_url\": {\"type\": \"string\"}, \"repo_url\": {\"type\": \"string\"}, \"branch\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "RemoveFolder",
            "name": "RemoveFolder",
            "description": "Deletes the repository's folder from the shared repository in one commit (empty file set + cleanTargetFolder)",
            "activity": {
              "ref": "#gitreposcaffolder",
              "input": {
                "authToken": "=$property[\"GITHUB_TOKEN\"]",
                "templateRepoURL": "=$property[\"TEMPLATE_REPO_URL\"]",
                "templateRef": "=$property[\"TEMPLATE_REF\"]",
                "templatePath": "=$activity[Plan].output.template_name",
                "ignoreEmptyValues": false,
                "replacementMode": "sequential",
                "renamePaths": true,
                "maxTextBytes": 5242880,
                "outputPrefix": "",
                "targetMode": "subfolder",
                "targetRepoURL": "=$activity[Plan].output.repo_url",
                "targetBranch": "=$activity[Plan].output.branch",
                "targetFolder": "=$activity[Plan].output.repo_name",
                "cleanTargetFolder": true,
                "newRepoPrivate": true,
                "newRepoDescription": "",
                "failIfRepoExists": false,
                "apiBaseURL": "=$property[\"GITHUB_API_URL\"]",
                "commitMessage": "=string.concat(\"Cleanup repo: \", $activity[Plan].output.repo_name)",
                "authorName": "=$property[\"GIT_AUTHOR_NAME\"]",
                "authorEmail": "=$property[\"GIT_AUTHOR_EMAIL\"]",
                "dryRun": false,
                "pushRetries": 3,
                "writeStrategy": "auto",
                "timeoutSeconds": 120,
                "replacementList": {
                  "mapping": []
                },
                "excludePatterns": {
                  "mapping": [
                    "*"
                  ]
                },
                "binaryExtensions": {
                  "mapping": []
                },
                "extraFiles": {
                  "mapping": []
                }
              }
            }
          },
          {
            "id": "DeleteRows",
            "name": "DeleteRows",
            "description": "Removes the generation and IKD registry rows",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "WITH g AS (DELETE FROM public.generation_log WHERE repo_name = ?repo RETURNING repo_name), i AS (DELETE FROM public.ikd_registry WHERE repo_name IN (SELECT repo_name FROM g) RETURNING 1) SELECT (SELECT count(*) FROM g)::int AS registry_rows, (SELECT count(*) FROM i)::int AS ikd_rows",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
