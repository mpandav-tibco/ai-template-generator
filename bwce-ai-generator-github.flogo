                  },
                  {
                    "FieldName": "role",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "ip",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "action",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "path",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "message",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "mechanism",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "7a9e4732-5f78-53f4-8e61-eeaed63f3b1fWITH ins AS (INSERT INTO public.audit_log (username, display_name, role, ip, action, path, message, mechanism) VALUES (?username, ?display_name, ?role, ?ip, ?action, ?path, ?message, ?mechanism) RETURNING id) DELETE FROM public.audit_log WHERE id <= (SELECT id FROM ins) - 2000 RETURNING id",
                "input": {
                  "mapping": {
                    "parameters": {
                      "username": "=coerce.toString($flow.username)",
                      "display_name": "=coerce.toString($flow.display_name)",
                      "role": "=coerce.toString($flow.role)",
                      "ip": "=coerce.toString($flow.ip)",
