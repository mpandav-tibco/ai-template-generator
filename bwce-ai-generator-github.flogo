                  },
                  {
                    "FieldName": "app",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "06468b80-f8a9-5085-b62b-5831b074b95fWITH ins AS (INSERT INTO public.code_review_history (repo_name, product_name, version, checkbwdesign, status, error, links, master_html, app_html) VALUES (?repo, ?product, ?version, ?checkbwdesign = 'true', ?status, NULLIF(?error, ''), COALESCE(NULLIF(?links, ''), '[]')::jsonb, NULLIF(?master, ''), NULLIF(?app, '')) RETURNING id) DELETE FROM public.code_review_history WHERE id <= (SELECT id FROM ins) - 500 RETURNING id",
                "input": {
