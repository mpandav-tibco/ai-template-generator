    {
      "id": "flow:static_GET",
      "data": {
        "name": "static_GET",
        "description": "Serves a static file from disk (UI, docs, OpenAPI); public files skip the auth guard",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadFile",
            "type": "expression",
            "label": "StartActivity to ReadFile",
            "value": "$flow.public == true"
          },
          {
            "id": 2,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "expression",
            "label": "StartActivity to Authorize",
            "value": "$flow.public != true"
          },
          {
            "id": 3,
            "from": "Authorize",
            "to": "ReadFile",
            "type": "expression",
            "label": "Authorize to ReadFile",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 4,
            "from": "Authorize",
            "to": "Deny",
            "type": "expression",
            "label": "Authorize to Deny",
            "value": "$activity[Authorize].ok != true"
          },
          {
            "id": 5,
            "from": "ReadFile",
            "to": "ReturnFile",
            "type": "label",
            "label": "ReadFile to ReturnFile"
          }
        ],
