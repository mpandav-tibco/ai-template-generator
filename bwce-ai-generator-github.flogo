                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"definitions\": {}, \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"registry_rows\": {\"type\": \"number\"}, \"ikd_rows\": {\"type\": \"number\"}}}}}}"
