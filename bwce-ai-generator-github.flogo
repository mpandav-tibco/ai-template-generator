                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/schema7"
                        }
                      }
                    }
                  }
                },
                "description": "Resets a conversation (POST /api/chat/reset) by deleting the stored session so the user can start over.",
