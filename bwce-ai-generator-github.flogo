            "description": "Run2Plan",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "req": "=array.get(json.jq($activity[Run2In].output, $activity[GetOps].output.data.codereview.run_request), 0)"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
