              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "/api/auth/diagnostics",
                "admin_only": true,
                "trusted": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller (session, bearer token or API key)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Authorize].status",
                  "data": "=$activity[Authorize].body"
                }
              }
            },
            "id": "Deny",
            "name": "Deny",
            "description": "Rejects unauthenticated (401) or non-admin (403) callers"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "auth_enabled": "=$property[\"AUTH_ENABLED\"]",
                      "sso_enabled": false,
                      "tenant_configured": false,
                      "signing_key_source": "=$property[\"SESSION_SIGNING_KEY\"] != \"\" ? \"SESSION_SIGNING_KEY\" : \"generated at startup\"",
                      "api_key_source": "=$property[\"AUTH_API_KEY\"] != \"\" ? \"AUTH_API_KEY\" : \"not set\"",
                      "https_enabled": "=$property[\"HTTPS_ENABLED\"]",
                      "session_ttl_seconds": "=$property[\"SESSION_TTL_SECONDS\"]",
                      "login_max_attempts": "=$property[\"AUTH_LOGIN_MAX_ATTEMPTS\"]",
                      "login_lockout_seconds": "=$property[\"AUTH_LOGIN_LOCKOUT_SECONDS\"]",
                      "mcp_auth_type": "=$property[\"MCP_AUTH_TYPE\"]",
                      "public_paths": [
                        "/",
                        "/api/login",
                        "/api/logout",
                        "/api/session",
                        "/health"
                      ],
                      "admin_only_paths": [
                        "/api/users",
                        "/api/auth/diagnostics",
                        "/k8s/context/switch",
                        "/k8s/deployments/{name}/scale",
                        "/k8s/deployments/{name}/restart"
                      ]
                    }
                  }
                }
              }
            },
            "id": "ReturnDiagnostics",
            "name": "ReturnDiagnostics",
            "description": "ReturnDiagnostics"
          }
