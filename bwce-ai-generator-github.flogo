                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"call\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"error\": {\"type\": \"string\"}}}, \"env_userid\": {\"type\": \"string\"}, \"env_usertype\": {\"type\": \"string\"}, \"user\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"call\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"error\": {\"type\": \"string\"}}}, \"env_userid\": {\"type\": \"string\"}, \"env_usertype\": {\"type\": \"string\"}, \"user\": {\"type\": \"string\"}}}"
