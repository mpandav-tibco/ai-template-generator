                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "force": true
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Run2In",
            "name": "Run2In",
            "description": "Run2In",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "base": "=$property[\"CODE_REVIEW_BASE_URL\"]",
                    "body": "=$flow.content",
                    "token": {
                      "token": "=$activity[Token2].token",
                      "userid": "=$activity[Token2].userid",
                      "usertype": "=$activity[Token2].usertype"
                    },
                    "cookie": "=$property[\"CODE_REVIEW_COOKIE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"base\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"token\": {\"type\": \"object\", \"properties\": {\"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}}}, \"cookie\": {\"type\": \"string\"}}}"
