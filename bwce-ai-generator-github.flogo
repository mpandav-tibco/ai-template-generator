                    "config_only": "=$activity[NormalizeSpec].output.config_only",
                    "github_url": "=$activity[ScaffoldArtifacts].folder_url",
                    "repo_url": "=$activity[ScaffoldArtifacts].repo_url",
                    "commit_sha": "=$activity[ScaffoldArtifacts].commit_sha",
                    "pushed": "=$activity[ScaffoldArtifacts].pushed",
                    "write_mode": "=$activity[ScaffoldArtifacts].write_mode",
                    "template_commit": "=$activity[ScaffoldArtifacts].template_commit",
                    "files_total": "=$activity[ScaffoldArtifacts].files_total",
                    "files_modified": "=$activity[ScaffoldArtifacts].files_modified",
                    "paths_renamed": "=$activity[ScaffoldArtifacts].paths_renamed",
                    "scaffold_ms": "=$activity[ScaffoldArtifacts].duration_ms",
                    "template_source": "=$activity[ResolveTemplateName].output.template_source",
                    "product_area": "=$activity[NormalizeSpec].output.product_area",
                    "code_path": "=string.concat($activity[NormalizeSpec].output.repo_name, \"/code/\", $activity[NormalizeSpec].output.repo_name)",
                    "target_mode": "=$activity[NormalizeSpec].output.target_mode"
                  }
                }
              },
              "schemas": {
                "input": {
