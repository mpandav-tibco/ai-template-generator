                ],
                "RuntimeQuery": "",
                "State": "819b2f80-7b07-5db5-9b4b-0d12ea2a7bb4DELETE FROM public.login_attempt WHERE username_key = lower(?username ::text) RETURNING username_key",
                "input": {
                  "mapping": {
                    "parameters": {
                      "username": "=$activity[Decide].output.d.username"
