                      }
                    }
                  }
                }
              }
            },
            "/api/templates": {
              "get": {
                "operationId": "api_templates_GET",
                "summary": "List the BWCE templates in the library",
                "tags": [
                  "Templates"
                ],
                "responses": {
                  "200": {
                    "description": "Templates",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/TemplateListResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/templates/suggest": {
              "post": {
                "operationId": "api_templates_suggest_POST",
                "summary": "Rank templates for a partial spec (semantic search)",
                "tags": [
                  "Templates"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/SuggestRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Ranked templates",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/SuggestResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/extract": {
              "post": {
                "operationId": "extract_POST",
                "summary": "One-shot extraction of the integration spec from free text",
                "tags": [
                  "Generation"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ExtractRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Extracted fields",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ExtractResponse"
                        }
                      }
                    }
                  },
                  "500": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/generate": {
              "post": {
                "operationId": "generate_POST",
                "summary": "Generate the repository from a complete spec and publish it to GitHub",
                "tags": [
                  "Generation"
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/GenerateRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Generation result",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/GenerateResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Validation errors",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/GenerateResponse"
                        }
                      }
                    }
                  },
                  "409": {
                    "description": "Repository already generated",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/GenerateResponse"
                        }
                      }
                    }
                  },
                  "500": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/tracker": {
              "get": {
                "operationId": "api_tracker_GET",
                "summary": "Generation history",
                "tags": [
                  "Generation"
                ],
                "responses": {
                  "200": {
                    "description": "Generated repositories",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/TrackerResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/ikd": {
              "get": {
                "operationId": "ikd_GET",
                "summary": "IKD registry export (\"<id>:<repository>\" lines)",
                "tags": [
                  "Generation"
                ],
                "parameters": [
                  {
                    "name": "kind",
                    "in": "query",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "enum": [
                        "InterfaceIDs",
                        "ScenarioIDs"
                      ]
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "One entry per line",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/schemas/upload/{kind}": {
              "post": {
                "operationId": "schemas_upload_POST",
                "summary": "Commit XSD/WSDL schemas into a generated repository",
                "description": "`source` and `target` take one file (`filename` + `content`); `batch` takes `source_schemas` and `target_schemas`.",
                "tags": [
                  "Schemas"
                ],
                "parameters": [
                  {
                    "name": "kind",
                    "in": "path",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "enum": [
                        "source",
                        "target",
                        "batch"
                      ]
                    }
                  }
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/SchemaUploadRequest"
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Committed",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/SchemaUploadResponse"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  },
                  "404": {
                    "description": "Error",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ErrorResponse"
                        }
                      }
                    }
                  }
                }
              }
            },
            "/api/codereview/token": {
              "post": {
                "operationId": "codereview_token_POST",
