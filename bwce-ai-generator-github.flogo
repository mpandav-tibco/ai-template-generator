                    "isEditable": false
                  },
                  {
                    "FieldName": "github_url",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  },
                  {
                    "FieldName": "target_mode",
                    "Type": "VARCHAR",
                    "Selected": true,
                    "Parameter": false,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "8b39a46a-a9c3-5cdc-8ed5-dd6750764035SELECT repo_name, template_name, github_url, target_mode FROM public.generation_log WHERE repo_name = ?repo",
                "input": {
