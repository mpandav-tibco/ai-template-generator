    {
      "id": "flow:api_tracker_repo_DELETE",
      "data": {
        "name": "api_tracker_repo_DELETE",
        "description": "Cleans up a generated repository (DELETE /api/tracker/{repo_name}): deletes its folder from the shared repository in one commit and its registry and IKD rows; a repository of its own is kept on GitHub.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "FindEntry",
            "type": "expression",
            "label": "Valid repository name",
            "value": "string.replaceRegEx(\"^[A-Za-z0-9][A-Za-z0-9._-]*$\", coerce.toString($flow.params.repo_name), \"\") == \"\""
          },
          {
            "id": 2,
            "from": "StartActivity",
            "to": "ReturnBadName",
            "type": "expression",
            "label": "Invalid repository name",
            "value": "string.replaceRegEx(\"^[A-Za-z0-9][A-Za-z0-9._-]*$\", coerce.toString($flow.params.repo_name), \"\") != \"\""
          },
          {
            "id": 3,
            "from": "FindEntry",
            "to": "ReturnNotFound",
            "type": "expression",
            "label": "Not registered",
            "value": "array.count($activity[FindEntry].Output.records) == 0"
          },
          {
            "id": 4,
            "from": "FindEntry",
            "to": "Plan",
            "type": "expression",
            "label": "Registered",
            "value": "array.count($activity[FindEntry].Output.records) > 0"
          },
          {
            "id": 5,
            "from": "Plan",
            "to": "RemoveFolder",
            "type": "expression",
            "label": "Folder in the shared repository",
            "value": "$activity[Plan].output.target_mode == \"subfolder\""
          },
          {
            "id": 6,
            "from": "Plan",
            "to": "DeleteRowsKept",
            "type": "expression",
            "label": "Repository of its own",
            "value": "$activity[Plan].output.target_mode != \"subfolder\""
          },
          {
            "id": 7,
            "from": "RemoveFolder",
            "to": "DeleteRows",
            "type": "label",
            "label": "RemoveFolder to DeleteRows"
          },
          {
            "id": 8,
            "from": "DeleteRowsKept",
            "to": "BuildKept",
            "type": "label",
            "label": "DeleteRowsKept to BuildKept"
          },
          {
            "id": 9,
            "from": "DeleteRows",
            "to": "BuildRemoved",
            "type": "label",
            "label": "DeleteRows to BuildRemoved"
          },
          {
            "id": 10,
            "from": "BuildKept",
            "to": "ReturnKept",
            "type": "label",
            "label": "BuildKept to ReturnKept"
          },
          {
            "id": 11,
            "from": "BuildRemoved",
            "to": "ReturnRemoved",
            "type": "label",
            "label": "BuildRemoved to ReturnRemoved"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReturnBadName",
            "name": "ReturnBadName",
            "description": "Returns 400 for a value that is not a repository name",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "responseBody": {
                    "mapping": {
                      "body": {
                        "success": false,
                        "error": "INVALID_NAME",
                        "detail": "=string.concat(\"Invalid repository name '\", coerce.toString($flow.params.repo_name), \"'. Allowed: letters, digits, '.', '_' and '-'.\")"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "FindEntry",
            "name": "FindEntry",
            "description": "Looks the repository up in the generation registry",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT repo_name, template_name, github_url, target_mode FROM public.generation_log WHERE repo_name = ?repo",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
                    "Type": "VARCHAR",
