            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "b": "=array.get(json.jq($flow.content, $activity[GetOps].output.data.auth.body), 0)",
                    "cred": "=array.get(json.jq($flow.headers, $activity[GetOps].output.data.auth.credential), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"b\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"password\": {\"type\": \"string\"}}}, \"cred\": {\"type\": \"object\", \"properties\": {\"ip\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"b\": {\"type\": \"object\", \"properties\": {\"username\": {\"type\": \"string\"}, \"password\": {\"type\": \"string\"}}}, \"cred\": {\"type\": \"object\", \"properties\": {\"ip\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "ReadLogin",
            "name": "ReadLogin",
            "description": "ReadLogin"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT json_build_object('username', u.username, 'display_name', u.display_name, 'role', u.role, 'password_ok', (u.password_hash IS NOT NULL AND c.h = u.password_hash), 'failures', COALESCE(a.failures, 0), 'failed_age', COALESCE(floor(EXTRACT(EPOCH FROM now() - a.first_failed_at)), 0))::text AS doc FROM (SELECT lower(?username ::text) AS k) q LEFT JOIN public.app_user u ON u.username_key = q.k LEFT JOIN public.login_attempt a ON a.username_key = q.k CROSS JOIN LATERAL (SELECT crypt(?password ::text, COALESCE(u.password_hash, gen_salt('bf', 10))) AS h) c",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "username",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  },
                  {
                    "FieldName": "password",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "a34ae61c-24db-5f76-80ed-1b753fff67b1SELECT json_build_object('username', u.username, 'display_name', u.display_name, 'role', u.role, 'password_ok', (u.password_hash IS NOT NULL AND c.h = u.password_hash), 'failures', COALESCE(a.failures, 0), 'failed_age', COALESCE(floor(EXTRACT(EPOCH FROM now() - a.first_failed_at)), 0))::text AS doc FROM (SELECT lower(?username ::text) AS k) q LEFT JOIN public.app_user u ON u.username_key = q.k LEFT JOIN public.login_attempt a ON a.username_key = q.k CROSS JOIN LATERAL (SELECT crypt(?password ::text, COALESCE(u.password_hash, gen_salt('bf', 10))) AS h) c",
                "input": {
                  "mapping": {
                    "parameters": {
                      "username": "=$activity[ReadLogin].output.b.username",
                      "password": "=$activity[ReadLogin].output.b.password"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
