              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"force\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"error\": {\"type\": \"string\"}, \"token\": {\"type\": \"string\"}, \"userid\": {\"type\": \"string\"}, \"usertype\": {\"type\": \"string\"}, \"updated_at\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Token2",
            "name": "Token2",
            "description": "Retry once with a refreshed token (token may have expired)"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "call": {
                      "status": "=($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400) ? $activity[Attempt2].status : $activity[Attempt1].status",
                      "text": "=($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400) ? $activity[Attempt2].text : $activity[Attempt1].text",
                      "error": "=($activity[Attempt1].error != \"\" || $activity[Attempt1].status >= 400) ? $activity[Attempt2].error : $activity[Attempt1].error"
                    },
                    "body": "=$flow.content"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"call\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}, \"body\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"call\": {\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"error\": {\"type\": \"string\"}}}, \"body\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                }
              }
            },
