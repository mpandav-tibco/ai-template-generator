              "type": "boolean"
            },
            {
              "name": "env",
              "type": "string"
            },
            {
              "name": "generation_id",
              "type": "string"
            },
            {
              "name": "interface_type",
              "type": "string"
            },
            {
              "name": "match_score",
              "type": "string"
            },
