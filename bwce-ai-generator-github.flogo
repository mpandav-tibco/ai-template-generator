    {
      "id": "flow:K8sRequest",
      "data": {
        "name": "K8sRequest",
        "description": "Calls the Kubernetes API with the REST Invoke activity (GET or PATCH); TLS from K8S_INSECURE and K8S_CA_CERT. Never fails: a transport error comes back in `error` with status 0",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Get",
            "type": "expression",
            "label": "StartActivity to Get",
            "value": "$flow.method != \"PATCH\""
          },
          {
            "id": 2,
            "from": "Get",
            "to": "ReturnGet",
            "type": "label",
            "label": "Get to ReturnGet"
          },
          {
            "id": 3,
            "from": "Get",
            "to": "Failed",
            "type": "error",
            "label": "Get to Failed"
          },
          {
            "id": 4,
            "from": "StartActivity",
            "to": "Patch",
            "type": "expression",
            "label": "StartActivity to Patch",
            "value": "$flow.method == \"PATCH\""
          },
          {
            "id": 5,
            "from": "Patch",
            "to": "ReturnPatch",
            "type": "label",
            "label": "Patch to ReturnPatch"
          },
          {
            "id": 6,
            "from": "Patch",
            "to": "Failed",
            "type": "error",
