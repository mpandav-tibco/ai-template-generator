    {
      "id": "flow:api_chat/init_POST",
      "data": {
        "name": "api_chat/init_POST",
        "description": "Starts a new conversational session (POST /api/chat/init). Creates an empty spec, allocates a session id, and stores the session in shared memory.",
        "links": [
          {
            "id": 1,
            "from": "Log_API",
            "to": "CreateSession",
            "type": "label",
            "label": "Log_API to CreateSession"
          },
          {
            "id": 2,
            "from": "CreateSession",
            "to": "StoreSession",
            "type": "label",
            "label": "CreateSession to StoreSession"
          },
          {
            "id": 3,
            "from": "StoreSession",
            "to": "Reply_to_API",
            "type": "label",
            "label": "StoreSession to Reply_to_API"
          },
          {
            "id": 4,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 5,
            "from": "Authorize",
            "to": "Log_API",
            "type": "expression",
            "label": "Authorize to Log_API",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 6,
            "from": "Authorize",
            "to": "RejectAuth",
            "type": "expression",
            "label": "Authorize to RejectAuth",
            "value": "$activity[Authorize].ok != true"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs that a new chat session is being initialized.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[CHAT-INIT] Initializing new chat session\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "CreateSession",
            "name": "CreateSession",
            "description": "Builds a new, empty session object with a fresh session id and blank spec.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "session_id": "=utils.uuid()",
                    "status": "active",
                    "message": "Hello! I can help you generate a BWCE integration repository. Describe your integration requirement in plain English.",
                    "missing_fields": [],
                    "ready_to_generate": false
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://SessionState"
                },
                "output": {
                  "output": "schema://SessionState"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "StoreSession",
            "name": "StoreSession",
            "description": "Persists the new session in the PostgreSQL chat_session table (upsert by session_id).",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 1000
              }
            },
            "activity": {
              "ref": "#insert",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "INSERT INTO public.chat_session(session_id, status, message) VALUES (?session_id, ?status, ?message) ON CONFLICT (session_id) DO UPDATE SET status = EXCLUDED.status, message = EXCLUDED.message, updated_at = NOW();",
                "manualmode": false,
                "Fields": [
                  {
                    "FieldName": "session_id",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "status",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  },
                  {
                    "FieldName": "message",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false,
                    "Value": true
                  }
                ],
                "RuntimeQuery": "",
                "State": "7d49bc1d-0c1a-4fe5-870e-1819abd2aad1INSERT INTO public.chat_session(session_id, status, message) VALUES (?session_id, ?status, ?message) ON CONFLICT (session_id) DO UPDATE SET status = EXCLUDED.status, message = EXCLUDED.message, updated_at = NOW();",
                "input": {
                  "mapping": {
                    "values": [
                      {
                        "session_id": "=$activity[CreateSession].output.session_id",
                        "status": "=$activity[CreateSession].output.status",
                        "message": "=$activity[CreateSession].output.message"
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}},\"parameters\":{\"type\":\"object\",\"properties\":{}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}},\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns the new session id and initial greeting to the client.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[CreateSession].output"
                  }
                }
              }
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "/api/chat/init",
                "admin_only": false,
                "trusted": "=$flow.trusted"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller"
          },
          {
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "code": "=$activity[Authorize].status",
                    "data": "=$activity[Authorize].body"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
