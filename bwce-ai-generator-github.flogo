          {
            "id": "CreateCollection",
            "name": "CreateCollection",
            "description": "Creates the Weaviate template collection unless it exists",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924"
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestTemplates",
            "name": "IngestTemplates",
            "description": "Ingests template documents into the Weaviate collection, generating embeddings for semantic search.",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "enableChunking": false,
                "chunkStrategy": "heading",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:Ps/QiweK4loMaJ15qYwHlYgnUuImug==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "documents": "=$activity[ParseTemplateRegistry].jsonObject.templates"
              }
            }
          },
          {
            "id": "LogStartupComplete",
            "name": "LogStartupComplete",
            "description": "Logs that startup completed and how many templates were ingested",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "=string.concat(\"[STARTUP] ready: \", coerce.toString(array.count($activity[ParseTemplateRegistry].jsonObject.templates)), \" templates in \", $property[\"VECTOR_COLLECTION\"])",
                "logLevel": ""
              },
              "schemas": {
                "input": {
                  "dynamicLogFields": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"fields\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}}}",
