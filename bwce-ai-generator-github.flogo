          {
            "id": "BuildDuplicateResponse",
            "name": "BuildDuplicateResponse",
            "description": "Builds an idempotent response indicating the repository already exists, echoing the existing registration id and status from the registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "duplicate": true,
                    "repo_name": "=$activity[NormalizeSpec].output.repo_name",
                    "message": "Repository already exists in the generation registry; returning the existing registration (idempotent, no new repository was scaffolded).",
                    "existing_status": "=$activity[CheckDuplicate].Output.records[0].status",
                    "existing_generation_id": "=$activity[CheckDuplicate].Output.records[0].generation_id",
                    "shell_command": "=(coerce.toString($activity[CheckDuplicate].Output.records[0].github_url) != \"\") ? ((string.contains(coerce.toString($activity[CheckDuplicate].Output.records[0].github_url), \"/tree/\")) ? string.concat(\"git clone \", string.substringBefore(coerce.toString($activity[CheckDuplicate].Output.records[0].github_url), \"/tree/\"), \".git\") : string.concat(\"git clone \", coerce.toString($activity[CheckDuplicate].Output.records[0].github_url), \".git\")) : (($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat(\"git clone \", $property[\"TARGET_OWNER_URL\"], \"/\", $activity[NormalizeSpec].output.repo_name, \".git\") : string.concat(\"git clone \", $property[\"TARGET_REPO_URL\"], \".git\"))",
                    "github_url": "=(coerce.toString($activity[CheckDuplicate].Output.records[0].github_url) != \"\") ? coerce.toString($activity[CheckDuplicate].Output.records[0].github_url) : (($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $activity[NormalizeSpec].output.repo_name) : string.concat($property[\"TARGET_REPO_URL\"], \"/tree/\", $property[\"TARGET_BRANCH\"], \"/\", $activity[NormalizeSpec].output.repo_name))",
                    "target_mode": "=(coerce.toString($activity[CheckDuplicate].Output.records[0].target_mode) != \"\") ? coerce.toString($activity[CheckDuplicate].Output.records[0].target_mode) : $property[\"TARGET_MODE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://DuplicateResponse"
                },
                "output": {
                  "output": "schema://DuplicateResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnDuplicate",
            "name": "ReturnDuplicate",
            "description": "Returns the existing registration (idempotent; nothing is regenerated)",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[BuildDuplicateResponse].output"
                    }
                  }
                }
              }
            }
          },
