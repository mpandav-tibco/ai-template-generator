                "State": "899d8e03-5d9a-4b09-bf97-308838332f28INSERT INTO public.generation_log(generation_id, repo_name, source_system, target_system, business_object, interface_type, template_type, template_name, cdm, need_secret, interface_id, scenario_id, bitbucket_project, env, email, k8s_domain, country_code, unique_id, status)\n\tVALUES (?generation_id, ?repo_name, ?source_system, ?target_system, ?business_object, ?interface_type, ?template_type, ?template_name, ?cdm, ?need_secret, ?interface_id, ?scenario_id, ?bitbucket_project, ?env, ?email, ?k8s_domain, ?country_code, ?unique_id, ?status) ON CONFLICT (repo_name) DO NOTHING;",
