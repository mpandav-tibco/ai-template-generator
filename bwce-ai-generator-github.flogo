            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:K8sOperation",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "route": "=string.concat(\"GET /k8s/\", $flow.params.resource)",
                "query": "=$flow.query",
                "params": "=$flow.params"
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"route\": {\"type\": \"string\"}, \"content\": {\"type\": \"object\", \"properties\": {}}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"route\": {\"type\": \"string\"}, \"content\": {\"type\": \"object\", \"properties\": {}}, \"query\": {\"type\": \"object\", \"properties\": {}}, \"params\": {\"type\": \"object\", \"properties\": {}}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"code\": {\"type\": \"integer\"}, \"responseBody\": {\"type\": \"object\", \"properties\": {\"body\": {\"type\": \"any\"}, \"headers\": {\"type\": \"object\"}}}}}"
                  }
                }
              },
