            "to": "Return",
            "type": "label",
            "label": "Result to Return"
          },
          {
            "id": 4,
            "from": "Invoke",
            "to": "Failed",
            "type": "error",
            "label": "Invoke to Failed"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#act_general_rest",
              "output": {
                "configureResponseCodes": false,
                "throwError": false,
                "responseType": "text/plain",
                "responseOutput": "JSON Object"
              },
              "schemas": {
                "input": {
                  "dynamicRequestHeaders": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"Header\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"value\": {\"type\": \"string\"}}, \"required\": [\"name\", \"value\"]}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"Header\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"value\": {\"type\": \"string\"}}, \"required\": [\"name\", \"value\"]}}}}"
                  },
                  "body": {
                    "type": "json",
                    "value": "{\"type\": \"any\"}",
                    "fe_metadata": "{\"type\": \"any\"}"
                  }
                },
                "output": {
                  "responseBody": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"data\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "input": {
                "swagger": "",
                "authorization": false,
                "authorizationConn": "",
                "serviceName": "",
                "serviceMetadata": {},
                "resourcePath": "",
                "Method": "=$flow.method",
                "Uri": "=$flow.url",
                "requestType": "=$flow.request_type",
                "Use certificate for verification": "=$flow.ca != \"\"",
                "mutualAuth": false,
                "Client Certificate": "",
                "Client Key": "",
                "Server Certificate": "=$flow.ca",
                "disableSSLVerification": "=$flow.insecure",
                "disableKeepAlives": false,
                "followRedirects": false,
                "Timeout": "=$flow.timeout_ms",
                "proxy": "",
                "host": "",
                "serviceUrl": "",
                "queryParams": {},
                "pathParams": {},
                "headers": {},
                "dynamicRequestHeaders": "=$flow.headers",
                "body": "=$flow.body",
                "multipartFormData": {},
                "multipartForm": {}
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Invoke",
            "name": "Invoke",
            "description": "Sends the request (method, URL, headers, body and TLS options come from the caller)"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "status": "=coerce.toInt($activity[Invoke].statusCode)",
                    "text": "=array.get(json.jq(coerce.toObject($activity[Invoke].responseBody), \".data // \\\"\\\"\"), 0)",
                    "json": "=array.get(json.jq(coerce.toObject($activity[Invoke].responseBody), \"try ((.data // \\\"\\\") | fromjson) catch null\"), 0)",
                    "content_type": "=array.get(json.jq(coerce.toObject($activity[Invoke].headers), \".[\\\"Content-Type\\\"] // \\\"\\\"\"), 0)",
                    "elapsed_ms": "=coerce.toInt($activity[Invoke].responseTimeInMilliSec)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"status\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}, \"json\": {\"type\": \"any\"}, \"content_type\": {\"type\": \"string\"}, \"elapsed_ms\": {\"type\": \"integer\"}}}"
                  }
                }
              }
            },
            "id": "Result",
