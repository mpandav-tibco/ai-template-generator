            "id": "GetOps",
            "name": "GetOps",
            "description": "GetOps"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "op": "=$flow.op",
                    "body": "=$flow.content",
                    "tpl": "=$activity[GetOps].output.data.schemas.wrapper_template"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"op\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"tpl\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"op\": {\"type\": \"string\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"tpl\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "id": "PlanIn",
            "name": "PlanIn",
            "description": "PlanIn"
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "p": "=array.get(json.jq($activity[PlanIn].output, $activity[GetOps].output.data.schemas.plan), 0)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"p\": {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"string\"}, \"repo\": {\"type\": \"string\"}, \"xml\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"uploaded_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"message\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"p\": {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"string\"}, \"repo\": {\"type\": \"string\"}, \"xml\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"uploaded_files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}, \"message\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "id": "Plan",
            "name": "Plan",
            "description": "Plan"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "data": {
                    "mapping": {
                      "detail": "=$activity[Plan].output.p.error"
                    }
                  }
                }
              }
            },
            "id": "ReturnBad",
            "name": "ReturnBad",
            "description": "ReturnBad"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT template_name FROM public.generation_log WHERE repo_name = ?repo ORDER BY created_at DESC LIMIT 1",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "repo",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "fd648c4e-22ae-5384-95bf-2b2d29015b29SELECT template_name FROM public.generation_log WHERE repo_name = ?repo ORDER BY created_at DESC LIMIT 1",
                "input": {
                  "mapping": {
                    "parameters": {
                      "repo": "=$activity[Plan].output.p.repo"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                },
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"repo\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "FindRepo",
            "name": "FindRepo",
            "description": "The repository must have been generated (its template is needed for the commit)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 404,
                  "data": {
                    "mapping": {
                      "detail": "=string.concat(\"Repository \", $activity[Plan].output.p.repo, \" has not been generated yet.\")"
                    }
                  }
                }
              }
            },
            "id": "ReturnUnknown",
            "name": "ReturnUnknown",
            "description": "ReturnUnknown"
          },
          {
            "activity": {
              "ref": "#act_general_xmltojson",
              "input": {
                "xmlString": "=$iteration[value]",
                "ordered": false,
                "typeCast": false
              }
            },
            "id": "CheckXml",
            "name": "CheckXml",
            "description": "Every uploaded file must be well-formed XML",
            "type": "iterator",
            "settings": {
              "iterate": "=$activity[Plan].output.p.xml",
              "accumulate": true
            }
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 400,
                  "data": {
                    "mapping": {
                      "detail": "=string.concat(\"Invalid XSD file: \", $error[CheckXml].message)"
                    }
                  }
                }
              }
            },
            "id": "ReturnInvalidXml",
            "name": "ReturnInvalidXml",
            "description": "ReturnInvalidXml"
          },
          {
            "activity": {
              "ref": "#act_gitreposcaffolder",
              "input": {
                "authToken": "=$property[\"GITHUB_TOKEN\"]",
                "templateRepoURL": "=$property[\"TEMPLATE_REPO_URL\"]",
                "templateRef": "=$property[\"TEMPLATE_REF\"]",
                "templatePath": "=$activity[FindRepo].Output.records[0].template_name",
                "replacementList": [],
                "ignoreEmptyValues": false,
                "replacementMode": "sequential",
                "renamePaths": true,
                "excludePatterns": [
                  "*"
                ],
                "binaryExtensions": [],
                "maxTextBytes": 5242880,
                "outputPrefix": "",
                "extraFiles": "=$activity[Plan].output.p.files",
                "targetMode": "=$property[\"TARGET_MODE\"]",
                "targetRepoURL": "=($property[\"TARGET_MODE\"] == \"newRepo\") ? string.concat($property[\"TARGET_OWNER_URL\"], \"/\", $activity[Plan].output.p.repo) : $property[\"TARGET_REPO_URL\"]",
                "targetBranch": "=$property[\"TARGET_BRANCH\"]",
                "targetFolder": "=($property[\"TARGET_MODE\"] == \"newRepo\") ? \"\" : $activity[Plan].output.p.repo",
                "cleanTargetFolder": false,
                "newRepoPrivate": true,
                "newRepoDescription": "=string.concat(\"BWCE integration \", $activity[Plan].output.p.repo)",
                "failIfRepoExists": false,
                "apiBaseURL": "=$property[\"GITHUB_API_URL\"]",
                "commitMessage": "=string.concat(\"Upload schemas: \", $activity[Plan].output.p.repo)",
                "authorName": "=$property[\"GIT_AUTHOR_NAME\"]",
                "authorEmail": "=$property[\"GIT_AUTHOR_EMAIL\"]",
                "dryRun": false,
                "pushRetries": 3,
                "writeStrategy": "auto",
                "timeoutSeconds": 120
              }
            },
            "id": "Commit",
            "name": "Commit",
            "description": "Commits only the schema files (template files excluded) in one commit"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "data": {
                    "mapping": {
                      "success": true,
                      "repository_name": "=$activity[Plan].output.p.repo",
                      "uploaded_files": "=$activity[Plan].output.p.uploaded_files",
                      "message": "=$activity[Plan].output.p.message",
                      "commit_sha": "=$activity[Commit].commitSHA",
                      "pushed": "=$activity[Commit].pushed",
                      "github_url": "=$activity[Commit].folderURL"
                    }
                  }
                }
              }
            },
            "id": "ReturnDone",
            "name": "ReturnDone",
            "description": "ReturnDone"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "op",
              "type": "string"
            },
            {
              "name": "content",
              "type": "object"
            },
            {
              "name": "headers",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ikd_GET",
      "data": {
        "name": "ikd_GET",
        "description": "IKD registry export in the reference file format (GET /api/ikd?kind=InterfaceIDs|ScenarioIDs)",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Authorize",
            "type": "label",
            "label": "StartActivity to Authorize"
          },
          {
            "id": 2,
            "from": "Authorize",
            "to": "Deny",
            "type": "expression",
            "label": "Authorize to Deny",
            "value": "$activity[Authorize].ok != true"
          },
          {
            "id": 3,
            "from": "Authorize",
            "to": "ExportIKD",
            "type": "expression",
            "label": "Authorize to ExportIKD",
            "value": "$activity[Authorize].ok == true"
          },
          {
            "id": 4,
            "from": "ExportIKD",
            "to": "ReturnIKD",
            "type": "label",
            "label": "ExportIKD to ReturnIKD"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:AuthGuard",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "headers": "=$flow.headers",
                "path": "/api/ikd",
                "admin_only": false,
                "trusted": false
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"headers\": {\"type\": \"object\", \"properties\": {}}, \"path\": {\"type\": \"string\"}, \"admin_only\": {\"type\": \"boolean\"}, \"trusted\": {\"type\": \"boolean\"}}}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"ok\": {\"type\": \"boolean\"}, \"status\": {\"type\": \"integer\"}, \"body\": {\"type\": \"object\", \"properties\": {}}, \"username\": {\"type\": \"string\"}, \"display_name\": {\"type\": \"string\"}, \"role\": {\"type\": \"string\"}, \"mechanism\": {\"type\": \"string\"}, \"ip\": {\"type\": \"string\"}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "Authorize",
            "name": "Authorize",
            "description": "Authenticates the caller (session, bearer token or API key)"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": "=$activity[Authorize].status",
                  "data": "=$activity[Authorize].body"
                }
              }
            },
            "id": "Deny",
            "name": "Deny",
            "description": "Rejects unauthenticated (401) or non-admin (403) callers"
          },
          {
            "activity": {
              "ref": "#query",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "SELECT COALESCE(string_agg(ikd_value || ':' || repo_name || chr(10), '' ORDER BY updated_at, repo_name), '') AS text FROM public.ikd_registry WHERE kind = ?kind",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [
                  {
                    "FieldName": "kind",
                    "Type": "VARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "RuntimeQuery": "",
                "State": "8c924913-96f6-51eb-85fa-8bce624f59feSELECT COALESCE(string_agg(ikd_value || ':' || repo_name || chr(10), '' ORDER BY updated_at, repo_name), '') AS text FROM public.ikd_registry WHERE kind = ?kind",
                "input": {
                  "mapping": {
                    "parameters": {
                      "kind": "=coerce.toString($flow.kind)"
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}",
                    "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"records\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {}}}}}"
                  }
                },
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"parameters\": {\"type\": \"object\", \"properties\": {\"kind\": {\"type\": \"string\"}}}}}"
                  }
                }
              }
            },
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "id": "ExportIKD",
            "name": "ExportIKD",
            "description": "ExportIKD"
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": {
                    "mapping": {
                      "body": "=$activity[ExportIKD].Output.records[0].text",
                      "headers": {
                        "Content-Type": "text/plain; charset=UTF-8"
                      }
                    }
                  }
                }
              }
            },
            "id": "ReturnIKD",
            "name": "ReturnIKD",
            "description": "ReturnIKD"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "kind",
              "type": "string"
            },
            {
              "name": "headers",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:ExtractSpecCore",
      "data": {
        "name": "ExtractSpecCore",
        "description": "NLU extraction shared by /extract and the chat: rules pre-extraction, LLM, JSON clean-up",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "RegexPreExtract",
            "type": "label",
            "label": "StartActivity to RegexPreExtract"
          },
          {
            "id": 2,
            "from": "RegexPreExtract",
            "to": "ExtractWithLLM",
            "type": "label",
            "label": "RegexPreExtract to ExtractWithLLM"
          },
          {
            "id": 3,
            "from": "ExtractWithLLM",
            "to": "CleanJSON",
            "type": "label",
            "label": "ExtractWithLLM to CleanJSON"
          },
          {
            "id": 4,
            "from": "CleanJSON",
            "to": "ParseExtraction",
            "type": "label",
            "label": "CleanJSON to ParseExtraction"
          },
          {
            "id": 5,
            "from": "ParseExtraction",
            "to": "Return",
            "type": "label",
            "label": "ParseExtraction to Return"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "NoOp Activity",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=$flow.content",
                "fileName": "rules/nlu-extraction.yaml",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "json",
                "disabledRules": {
                  "mapping": []
                },
                "tags": {
                  "mapping": [
                    "nlu"
                  ]
                }
              }
            },
            "id": "RegexPreExtract",
            "name": "RegexPreExtract",
            "description": "Deterministic regex/NLU pre-extraction: detects high-confidence tokens (IKD IDs, interface verbs, canonical systems, environments) in the raw user message and emits them as signals that anchor the downstream LLM extraction."
          },
          {
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:qX2c6EXhswJ8Rv92pEfkUd8Xzo9XMg==",
                "embeddingBaseURL": "=$property[\"LLM_EMBEDDING_BASE_URL\"]",
                "embeddingModel": "=$property[\"LLM_EMBEDDING_MODEL\"]",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0.9999,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": false,
                "hybridAlpha": 0.5,
                "enableLLMGenerate": true,
                "llmProvider": "Ollama",
                "llmBaseURL": "=$property[\"LLM_BASE_URL\"]",
                "llmAPIKey": "",
                "llmModel": "=$property[\"LLM_MODEL\"]",
                "systemPrompt": "=$property[\"EXTRACTION_SYSTEM_PROMPT\"]",
                "maxTokens": 1024,
                "temperature": 0
              },
              "input": {
                "queryText": "=string.concat(coerce.toString($flow.content.message), \" \", coerce.toString($activity[RegexPreExtract].markdown))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 2,
                "systemPrompt": "=$property[\"EXTRACTION_SYSTEM_PROMPT\"]"
              }
            },
            "id": "ExtractWithLLM",
            "name": "ExtractWithLLM",
            "description": "Uses the Weaviate RAG connector LLM generation to extract a structured integration spec from the free-text message."
          },
          {
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "cleaned": "=(string.trim(coerce.toString($flow.content.message), \" \") == \"\") ? \"{}\" : string.replaceAll(string.replaceAll(coerce.toString($activity[ExtractWithLLM].answer), \"```json\", \"\"), \"```\", \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            },
            "id": "CleanJSON",
            "name": "CleanJSON",
            "description": "Strips markdown code fences from the LLM answer so it can be parsed as JSON."
          },
          {
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[CleanJSON].output.cleaned"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            },
            "id": "ParseExtraction",
            "name": "ParseExtraction",
            "description": "Parses the cleaned LLM JSON answer into a structured object."
          },
          {
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "extraction": "=$activity[ParseExtraction].jsonObject",
                  "answer": "=$activity[ExtractWithLLM].answer"
                }
              }
            },
            "id": "Return",
            "name": "Return",
            "description": "Return"
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjEwMCwieSI6MTAwfX0=",
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "extraction",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
              }
            },
            {
              "name": "answer",
              "type": "string"
            }
          ],
          "fe_metadata": {}
        }
      }
    }
  ],
  "properties": [
    {
      "name": "PostgreSQL.GenerationRegistry.Host",
      "type": "string",
      "value": "localhost"
    },
    {
      "name": "PostgreSQL.GenerationRegistry.Port",
      "type": "float64",
