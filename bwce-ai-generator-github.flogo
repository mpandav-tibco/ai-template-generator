                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "DO $$ BEGIN CREATE EXTENSION IF NOT EXISTS pgcrypto; CREATE TABLE IF NOT EXISTS public.app_user (username_key TEXT PRIMARY KEY, username TEXT NOT NULL, display_name TEXT NOT NULL DEFAULT '', role TEXT NOT NULL CHECK (role IN ('admin', 'reader')), password_hash TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now()); CREATE TABLE IF NOT EXISTS public.login_attempt (username_key TEXT PRIMARY KEY, failures INT NOT NULL DEFAULT 0, first_failed_at TIMESTAMPTZ NOT NULL DEFAULT now()); CREATE TABLE IF NOT EXISTS public.audit_log (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), username TEXT NOT NULL DEFAULT '', display_name TEXT NOT NULL DEFAULT '', role TEXT NOT NULL DEFAULT '', ip TEXT NOT NULL DEFAULT '', action TEXT NOT NULL, path TEXT NOT NULL DEFAULT '', message TEXT NOT NULL DEFAULT '', mechanism TEXT NOT NULL DEFAULT ''); CREATE TABLE IF NOT EXISTS public.code_review_history (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), repo_name TEXT, product_name TEXT, version TEXT, checkbwdesign BOOLEAN, status TEXT NOT NULL, error TEXT, links JSONB NOT NULL DEFAULT '[]', master_html TEXT, app_html TEXT); CREATE TABLE IF NOT EXISTS public.ikd_registry (kind TEXT NOT NULL, ikd_value TEXT NOT NULL, repo_name TEXT NOT NULL, updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), PRIMARY KEY (kind, repo_name)); DELETE FROM public.audit_log WHERE id <= (SELECT max(id) - 2000 FROM public.audit_log); DELETE FROM public.code_review_history WHERE id <= (SELECT max(id) - 500 FROM public.code_review_history); END $$",
                "manualmode": false,
                "fetchMetadata": "false",
                "Fields": [],
                "RuntimeQuery": "",
                "State": "e54e3591-f053-576d-b9d9-85ee4788475bDO $$ BEGIN CREATE EXTENSION IF NOT EXISTS pgcrypto; CREATE TABLE IF NOT EXISTS public.app_user (username_key TEXT PRIMARY KEY, username TEXT NOT NULL, display_name TEXT NOT NULL DEFAULT '', role TEXT NOT NULL CHECK (role IN ('admin', 'reader')), password_hash TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now()); CREATE TABLE IF NOT EXISTS public.login_attempt (username_key TEXT PRIMARY KEY, failures INT NOT NULL DEFAULT 0, first_failed_at TIMESTAMPTZ NOT NULL DEFAULT now()); CREATE TABLE IF NOT EXISTS public.audit_log (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), username TEXT NOT NULL DEFAULT '', display_name TEXT NOT NULL DEFAULT '', role TEXT NOT NULL DEFAULT '', ip TEXT NOT NULL DEFAULT '', action TEXT NOT NULL, path TEXT NOT NULL DEFAULT '', message TEXT NOT NULL DEFAULT '', mechanism TEXT NOT NULL DEFAULT ''); CREATE TABLE IF NOT EXISTS public.code_review_history (id BIGSERIAL PRIMARY KEY, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), repo_name TEXT, product_name TEXT, version TEXT, checkbwdesign BOOLEAN, status TEXT NOT NULL, error TEXT, links JSONB NOT NULL DEFAULT '[]', master_html TEXT, app_html TEXT); CREATE TABLE IF NOT EXISTS public.ikd_registry (kind TEXT NOT NULL, ikd_value TEXT NOT NULL, repo_name TEXT NOT NULL, updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), PRIMARY KEY (kind, repo_name)); DELETE FROM public.audit_log WHERE id <= (SELECT max(id) - 2000 FROM public.audit_log); DELETE FROM public.code_review_history WHERE id <= (SELECT max(id) - 500 FROM public.code_review_history); END $$"
              },
              "schemas": {
                "output": {
