{
  "openapi": "3.0.0",
  "info": {
    "title": "BWCE AI Integration Generator",
    "description": "AI-powered accelerator that generates TIBCO BWCE integration repositories through natural language conversation",
    "version": "1.0.0",
    "contact": {
      "name": "Core Integration Team",
      "email": "core-integration@adidas.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:9999",
      "description": "Local BWCE AI Generator (REST)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health and readiness check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/templates": {
      "get": {
        "operationId": "listTemplates",
        "summary": "List all available BWCE templates",
        "tags": [
          "Templates"
        ],
        "responses": {
          "200": {
            "description": "List of available templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "interface_types": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "cdm": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/init": {
      "post": {
        "operationId": "chatInit",
        "summary": "Initialize a new chat session",
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Optional \u2014 provide to resume an existing session"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string",
                      "example": "Hello! I can help you generate a BWCE integration repository. Describe your integration requirement in plain English."
                    },
                    "spec": {
                      "type": "object",
                      "properties": {
                        "source_system": {
                          "type": "string",
                          "example": "s4hana"
                        },
                        "target_system": {
                          "type": "string",
                          "example": "kafka"
                        },
                        "business_object": {
                          "type": "string",
                          "example": "article"
                        },
                        "interface_type": {
                          "type": "string",
                          "enum": [
                            "pub",
                            "sub",
                            "service"
                          ]
                        },
                        "template_type": {
                          "type": "string",
                          "example": "REST_SERVICE_To_KAFKATopic"
                        },
                        "cdm": {
                          "type": "boolean",
                          "default": false
                        },
                        "interface_id": {
                          "type": "string",
                          "default": "NA"
                        },
                        "scenario_id": {
                          "type": "string",
                          "default": "1234"
                        },
                        "bitbucket_project": {
                          "type": "string"
                        },
                        "env": {
                          "type": "string",
                          "default": "DEV"
                        },
                        "bw_profile": {
                          "type": "string",
                          "default": "default"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "k8s_domain": {
                          "type": "string",
                          "default": "cite"
                        },
                        "need_secret": {
                          "type": "boolean",
                          "default": false
                        },
                        "country_code": {
                          "type": "string",
                          "default": "NA"
                        },
                        "unique_id": {
                          "type": "string",
                          "default": "NA"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/message": {
      "post": {
        "operationId": "chatMessage",
        "summary": "Send a message and get bot response with updated spec state",
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id",
                  "message"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string",
                    "example": "create a repo from s4hana to poc for article data using rest to kafka"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bot response with current spec state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string",
                      "description": "Bot response or follow-up question"
                    },
                    "spec": {
                      "type": "object",
                      "properties": {
                        "source_system": {
                          "type": "string",
                          "example": "s4hana"
                        },
                        "target_system": {
                          "type": "string",
                          "example": "kafka"
                        },
                        "business_object": {
                          "type": "string",
                          "example": "article"
                        },
                        "interface_type": {
                          "type": "string",
                          "enum": [
                            "pub",
                            "sub",
                            "service"
                          ]
                        },
                        "template_type": {
                          "type": "string",
                          "example": "REST_SERVICE_To_KAFKATopic"
                        },
                        "cdm": {
                          "type": "boolean",
                          "default": false
                        },
                        "interface_id": {
                          "type": "string",
                          "default": "NA"
                        },
                        "scenario_id": {
                          "type": "string",
                          "default": "1234"
                        },
                        "bitbucket_project": {
                          "type": "string"
                        },
                        "env": {
                          "type": "string",
                          "default": "DEV"
                        },
                        "bw_profile": {
                          "type": "string",
                          "default": "default"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "k8s_domain": {
                          "type": "string",
                          "default": "cite"
                        },
                        "need_secret": {
                          "type": "boolean",
                          "default": false
                        },
                        "country_code": {
                          "type": "string",
                          "default": "NA"
                        },
                        "unique_id": {
                          "type": "string",
                          "default": "NA"
                        }
                      }
                    },
                    "missing_fields": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ready_to_generate": {
                      "type": "boolean"
                    },
                    "shell_command": {
                      "type": "string",
                      "description": "Pre-filled GenerateCodeFromTemplate.sh command (when all fields complete)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/reset": {
      "post": {
        "operationId": "chatReset",
        "summary": "Reset session to blank state",
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "operationId": "extractSpec",
        "summary": "One-shot NLU extraction from free-text message",
        "tags": [
          "Extraction"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "from wms to Demandware for salesorder sub"
                  },
                  "current_spec": {
                    "type": "object",
                    "properties": {
                      "source_system": {
                        "type": "string",
                        "example": "s4hana"
                      },
                      "target_system": {
                        "type": "string",
                        "example": "kafka"
                      },
                      "business_object": {
                        "type": "string",
                        "example": "article"
                      },
                      "interface_type": {
                        "type": "string",
                        "enum": [
                          "pub",
                          "sub",
                          "service"
                        ]
                      },
                      "template_type": {
                        "type": "string",
                        "example": "REST_SERVICE_To_KAFKATopic"
                      },
                      "cdm": {
                        "type": "boolean",
                        "default": false
                      },
                      "interface_id": {
                        "type": "string",
                        "default": "NA"
                      },
                      "scenario_id": {
                        "type": "string",
                        "default": "1234"
                      },
                      "bitbucket_project": {
                        "type": "string"
                      },
                      "env": {
                        "type": "string",
                        "default": "DEV"
                      },
                      "bw_profile": {
                        "type": "string",
                        "default": "default"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "k8s_domain": {
                        "type": "string",
                        "default": "cite"
                      },
                      "need_secret": {
                        "type": "boolean",
                        "default": false
                      },
                      "country_code": {
                        "type": "string",
                        "default": "NA"
                      },
                      "unique_id": {
                        "type": "string",
                        "default": "NA"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted integration spec fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "extracted_fields": {
                      "type": "object",
                      "properties": {
                        "source_system": {
                          "type": "string",
                          "example": "s4hana"
                        },
                        "target_system": {
                          "type": "string",
                          "example": "kafka"
                        },
                        "business_object": {
                          "type": "string",
                          "example": "article"
                        },
                        "interface_type": {
                          "type": "string",
                          "enum": [
                            "pub",
                            "sub",
                            "service"
                          ]
                        },
                        "template_type": {
                          "type": "string",
                          "example": "REST_SERVICE_To_KAFKATopic"
                        },
                        "cdm": {
                          "type": "boolean",
                          "default": false
                        },
                        "interface_id": {
                          "type": "string",
                          "default": "NA"
                        },
                        "scenario_id": {
                          "type": "string",
                          "default": "1234"
                        },
                        "bitbucket_project": {
                          "type": "string"
                        },
                        "env": {
                          "type": "string",
                          "default": "DEV"
                        },
                        "bw_profile": {
                          "type": "string",
                          "default": "default"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "k8s_domain": {
                          "type": "string",
                          "default": "cite"
                        },
                        "need_secret": {
                          "type": "boolean",
                          "default": false
                        },
                        "country_code": {
                          "type": "string",
                          "default": "NA"
                        },
                        "unique_id": {
                          "type": "string",
                          "default": "NA"
                        }
                      }
                    },
                    "missing_fields": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "format": "float"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/generate": {
      "post": {
        "operationId": "generateRepository",
        "summary": "Generate BWCE repository from a complete integration spec",
        "tags": [
          "Generation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "spec"
                ],
                "properties": {
                  "spec": {
                    "type": "object",
                    "properties": {
                      "source_system": {
                        "type": "string",
                        "example": "s4hana"
                      },
                      "target_system": {
                        "type": "string",
                        "example": "kafka"
                      },
                      "business_object": {
                        "type": "string",
                        "example": "article"
                      },
                      "interface_type": {
                        "type": "string",
                        "enum": [
                          "pub",
                          "sub",
                          "service"
                        ]
                      },
                      "template_type": {
                        "type": "string",
                        "example": "REST_SERVICE_To_KAFKATopic"
                      },
                      "cdm": {
                        "type": "boolean",
                        "default": false
                      },
                      "interface_id": {
                        "type": "string",
                        "default": "NA"
                      },
                      "scenario_id": {
                        "type": "string",
                        "default": "1234"
                      },
                      "bitbucket_project": {
                        "type": "string"
                      },
                      "env": {
                        "type": "string",
                        "default": "DEV"
                      },
                      "bw_profile": {
                        "type": "string",
                        "default": "default"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "k8s_domain": {
                        "type": "string",
                        "default": "cite"
                      },
                      "need_secret": {
                        "type": "boolean",
                        "default": false
                      },
                      "country_code": {
                        "type": "string",
                        "default": "NA"
                      },
                      "unique_id": {
                        "type": "string",
                        "default": "NA"
                      }
                    }
                  },
                  "config_only": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, regenerates config files only without touching repository code"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "repo_name": {
                      "type": "string",
                      "example": "s4hana-article-kafka-pub"
                    },
                    "repo_url": {
                      "type": "string"
                    },
                    "shell_command": {
                      "type": "string"
                    },
                    "workspace_path": {
                      "type": "string"
                    },
                    "generation_id": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Repository already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "repo_name": {
                      "type": "string",
                      "example": "s4hana-article-kafka-pub"
                    },
                    "repo_url": {
                      "type": "string"
                    },
                    "shell_command": {
                      "type": "string"
                    },
                    "workspace_path": {
                      "type": "string"
                    },
                    "generation_id": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
