    "/k8s/{resource}/{name}/{view}": {
      "get": {
        "operationId": "k8s_view_GET",
        "summary": "Deployment rollout status, pod logs, or the pod port-forward command",
        "description": "Valid combinations: deployments/{name}/rollout, pods/{name}/logs, pods/{name}/port-forward.",
        "tags": [
          "Kubernetes"
        ],
        "parameters": [
          {
            "name": "resource",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "deployments",
                "pods"
              ]
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "view",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "rollout",
                "logs",
                "port-forward"
              ]
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "description": "logs: last N lines (1-10000)",
            "schema": {
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "previous",
            "in": "query",
            "required": false,
            "description": "logs: previous container",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "local_port",
            "in": "query",
            "required": false,
            "description": "port-forward",
            "schema": {
              "type": "integer",
              "default": 8080
            }
          },
          {
            "name": "pod_port",
            "in": "query",
            "required": false,
            "description": "port-forward",
            "schema": {
              "type": "integer",
              "default": 8080
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation result (kubectl-style fields; success and timestamp always present)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/K8sResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
