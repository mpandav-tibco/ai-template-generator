      }
    },
    "/api/ikd": {
      "get": {
        "operationId": "ikd_GET",
        "summary": "IKD registry export (\"<id>:<repository>\" lines)",
        "tags": [
          "Generation"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "InterfaceIDs",
                "ScenarioIDs"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per line",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/schemas/upload/{kind}": {
      "post": {
        "operationId": "schemas_upload_POST",
        "summary": "Commit XSD/WSDL schemas into a generated repository",
        "description": "`source` and `target` take one file (`filename` + `content`); `batch` takes `source_schemas` and `target_schemas`.",
        "tags": [
          "Schemas"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "source",
                "target",
                "batch"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemaUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
