{
  "openapi": "3.0.0",
  "info": {
    "title": "BWCE AI Integration Generator (GitHub edition)",
    "description": "Generates TIBCO BWCE integration repositories from natural language and publishes them to GitHub, plus the operations APIs (Kubernetes, code review, schema upload, IKD registry). Authentication and authorization are done by the API gateway (Kong) in front of the app. Every operation is implemented by one Flogo flow of the same name.",
    "version": "1.0.0",
    "contact": {
      "name": "Core Integration Team",
      "email": "core-integration@adidas.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:9999",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Chat"
    },
    {
      "name": "Templates"
    },
    {
      "name": "Generation"
    },
    {
      "name": "Schemas"
    },
    {
      "name": "Code Review"
    },
    {
      "name": "Kubernetes"
    }
  ],
  "paths": {
