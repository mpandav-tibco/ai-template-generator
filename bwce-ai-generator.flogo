                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"source_system\":{\"type\":\"string\"},\"target_system\":{\"type\":\"string\"},\"business_object\":{\"type\":\"string\"},\"interface_type\":{\"type\":\"string\"},\"template_type\":{\"type\":\"string\"},\"cdm\":{\"type\":\"string\"},\"interface_id\":{\"type\":\"string\"},\"scenario_id\":{\"type\":\"string\"},\"bitbucket_project\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"env\":{\"type\":\"string\"},\"k8s_domain\":{\"type\":\"string\"},\"country_code\":{\"type\":\"string\"},\"unique_id\":{\"type\":\"string\"},\"missing_fields\":{\"type\":\"string\"},\"ready_to_generate\":{\"type\":\"string\"}}}},\"parameters\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"records\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReplyChat",
            "name": "ReplyChat",
            "description": "Returns the assistant message, merged spec and readiness to the client.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildChatResponse].output"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] api_chat/message_POST failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
            },
            {
              "id": "BuildError",
              "name": "BuildError",
              "description": "Builds the structured HTTP 500 error body from the flow error.",
              "activity": {
                "ref": "#mapper",
                "input": {
                  "input": {
                    "mapping": {
                      "success": false,
                      "error": "INTERNAL_ERROR",
                      "message": "=coerce.toString($error.message)",
                      "activity": "=coerce.toString($error.activity)",
                      "code": "=coerce.toString($error.code)"
                    }
                  }
                },
                "schemas": {
                  "output": {
                    "output": {
                      "type": "json",
                      "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}",
                      "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the structured error body.",
              "activity": {
                "ref": "#actreply",
                "input": {
                  "reply": {
                    "mapping": {
                      "code": 500,
                      "data": "=$activity[BuildError].output"
                    }
                  }
                },
                "schemas": {
                  "input": {
                    "reply": {
                      "type": "json",
                      "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                      "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            }
          ],
          "links": [
            {
              "id": 13,
              "from": "LogError",
              "to": "BuildError",
              "type": "label",
              "label": "LogError to BuildError"
            },
            {
              "id": 14,
              "from": "BuildError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:api_chat/reset_POST",
      "data": {
        "name": "api_chat/reset_POST",
        "description": "Resets a conversation (POST /api/chat/reset) by deleting the stored session so the user can start over.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "ClearSession",
            "type": "label",
            "label": "Log_API to ClearSession"
          },
          {
            "id": 3,
            "from": "ClearSession",
            "to": "BuildResetResponse",
            "type": "label",
            "label": "ClearSession to BuildResetResponse"
          },
          {
            "id": 4,
            "from": "BuildResetResponse",
            "to": "Reply_to_API",
            "type": "label",
            "label": "BuildResetResponse to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the session-reset request.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[CHAT-RESET] Resetting chat session\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "ClearSession",
            "name": "ClearSession",
            "description": "Deletes the stored session row from the PostgreSQL chat_session table.",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 1000
              }
            },
            "activity": {
              "ref": "#delete",
              "input": {
                "Connection": "conn://1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
                "QueryName": "",
                "Schema": "public",
                "Query": "DELETE FROM public.chat_session WHERE session_id = ?session_id;",
                "manualmode": false,
                "RuntimeQuery": "",
                "Fields": [
                  {
                    "FieldName": "session_id",
                    "Type": "LONGVARCHAR",
                    "Selected": false,
                    "Parameter": true,
                    "isEditable": false
                  }
                ],
                "State": "d40fffb9-3b56-41c6-a970-8f39edb758b4DELETE FROM public.chat_session WHERE session_id = ?session_id;",
                "input": {
                  "mapping": {
                    "parameters": {
                      "session_id": "=$flow.content.session_id"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"definitions\":{},\"properties\":{\"parameters\":{\"type\":\"object\",\"properties\":{\"session_id\":{\"type\":\"string\"}}}}}"
                  }
                },
                "output": {
                  "Output": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"rowsAffected\":{\"type\":\"int\"}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"rowsAffected\":{\"type\":\"int\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildResetResponse",
            "name": "BuildResetResponse",
            "description": "Builds the confirmation response for the reset.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "session_id": "=$flow.content.session_id",
                    "message": "\"Session reset successfully\""
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_id\": {\n      \"type\": \"string\",\n      \"format\": \"color\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_id\": {\n      \"type\": \"string\",\n      \"format\": \"color\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_id\": {\n      \"type\": \"string\",\n      \"format\": \"color\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}",
                    "fe_metadata": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"session_id\": {\n      \"type\": \"string\",\n      \"format\": \"color\"\n    },\n    \"message\": {\n      \"type\": \"string\"\n    }\n  }\n}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns the reset confirmation to the client.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildResetResponse].output"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5IjoxNTB9LCJDbGVhclNlc3Npb24iOnsieCI6NDUwLCJ5IjoyNTB9LCJCdWlsZFJlc2V0UmVzcG9uc2UiOnsieCI6NjUwLCJ5IjozNTB9LCJSZXBseV90b19BUEkiOnsieCI6ODUwLCJ5Ijo0NTB9fQ==",
        "errorHandler": {
