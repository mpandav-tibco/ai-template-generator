        "port": 9999,
        "APISpecUpdate": true,
        "swagger": "spec://9fa13808-932f-485a-94b0-2ccbe0cb3547",
        "swaggerVersion": "v3",
        "authenticationType": "None",
        "username": "",
        "password": "",
        "apiVersion": "1.0.0",
        "secureConnection": false,
        "serverKey": "",
        "caCertificate": ""
      },
      "id": "BWCEAIIntegrationGenerator",
