    {
      "ref": "#startuphook",
      "name": "tibco-appstartup",
      "description": "Runs once when the application starts. Loads the template registry and provider/protocol alias mappings into shared memory and ensures the PostgreSQL generation_log table exists.",
      "settings": {},
      "id": "AppStartup",
      "handlers": [
        {
          "description": "Application bootstrap flow. Loads the template registry and alias mappings from disk into shared memory and initializes the PostgreSQL schema.",
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:StartupFlow"
            }
          },
          "name": "StartupFlow"
        }
      ]
    },
    {
      "ref": "#mcpserver",
      "name": "flogo-mcp-mcpsever",
      "description": "Model Context Protocol (MCP) server. Exposes the generator's capabilities as MCP tools (extract_spec, generate_code, list_templates) so AI assistants and agents can drive integration generation.",
      "settings": {
        "serverName": "bwce-ai-generator",
        "serverVersion": "1.0.0",
        "serverType": "HTTP",
        "serverPort": "=$property[\"MCP_PORT\"]",
        "statelessServer": false,
        "serverEndpointPath": "/mcp",
        "enableTLS": false,
        "serverCertificate": "",
        "serverPrivateKey": "",
        "authType": "None",
        "authToken": ""
      },
      "id": "MCPServer",
      "handlers": [
        {
          "description": "MCP tool 'extract_spec'. Wraps the extract flow so AI agents can turn a natural-language description into a structured BWCE spec.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "extract_spec",
            "handlerDescription": "Extract BWCE integration spec from natural language description",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPExtractSpecTool"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "MCPExtractSpecTool"
        },
        {
          "description": "MCP tool 'generate_code'. Validates the spec, derives the repository name, and records the generation, returning the result to the calling AI agent.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "generate_code",
            "handlerDescription": "Generate BWCE integration code from extracted spec",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPGenerateTool"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "MCPGenerateTool"
        },
        {
          "description": "MCP tool 'list_templates'. Returns all available BWCE integration templates from shared memory.",
          "settings": {
            "handlerType": "Tool",
            "resourceUri": "",
            "handlerName": "list_templates",
            "handlerDescription": "List all available BWCE integration templates",
            "readOnlyToolHint": false,
            "destructiveToolHint": false,
            "idempotentToolHint": false,
            "openWorldToolHint": true
          },
          "action": {
            "ref": "github.com/project-flogo/flow",
            "settings": {
              "flowURI": "res://flow:MCPListTemplates"
            },
            "input": {
              "arguments": "=$.arguments"
            },
            "output": {
              "response": "=$.response"
            }
          },
          "schemas": {
            "reply": {
              "response": {
                "type": "json",
                "value": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}",
                "fe_metadata": "{\r\n    \"type\": \"object\",\r\n  \"properties\": {\r\n    \"data\": {\r\n      \"type\": \"string\"\r\n    },\r\n    \"error\": {\r\n      \"type\": \"string\"\r\n    }\r\n }\r\n}"
              }
            },
            "output": {
              "arguments": {
                "type": "json",
                "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{}}",
                "fe_metadata": "{}"
              }
            }
          },
          "name": "MCPListTemplates"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "flow:health_GET",
      "data": {
        "name": "health_GET",
        "description": "Health-check endpoint (GET /health). Returns service status so load balancers and monitoring probes can verify the generator is running.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "Reply_to_API",
            "type": "label",
            "label": "Log_API to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs that a health check was requested.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[HEALTH] Health check requested\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns HTTP 200 with service status confirming the generator is healthy.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": {
                      "status": "healthy",
                      "version": "1.0.0",
                      "service": "bwce-ai-generator",
                      "engine": "TIBCO Flogo"
                    }
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIlJlcGx5X3RvX0FQSSI6eyJ4Ijo0NTEsInkiOjQ1fX0=",
        "metadata": {
          "input": [],
          "output": [
            {
              "name": "code",
              "type": "integer"
            },
            {
              "name": "message",
              "type": "string"
            }
          ],
          "fe_metadata": {
            "output": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:api_templates_GET",
      "data": {
        "name": "api_templates_GET",
        "description": "Lists available BWCE integration templates (GET /api/templates) from the cached template registry.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "GetTemplateList",
            "type": "label",
            "label": "Log_API to GetTemplateList"
          },
          {
            "id": 3,
            "from": "GetTemplateList",
            "to": "Reply_to_API",
            "type": "label",
            "label": "GetTemplateList to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the templates-listing request.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[TEMPLATES] Listing available templates\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "GetTemplateList",
            "name": "GetTemplateList",
            "description": "Reads the cached template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object",
                "objectSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"templates\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"interface_types\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"cdm\": {\n            \"type\": \"boolean\"\n          }\n        }\n      }\n    },\n    \"aliases\": {\n      \"type\": \"object\"\n    }\n  }\n}"
              },
              "input": {
                "key": "\"APP_CONFIG\""
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"exist\":{\"type\":\"boolean\"},\"data\":{\"type\":\"object\",\"properties\":{\"templates\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"interface_types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"cdm\":{\"type\":\"boolean\"}}}},\"aliases\":{\"type\":\"object\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"exist\":{\"type\":\"boolean\"},\"data\":{\"type\":\"object\",\"properties\":{\"templates\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"interface_types\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"cdm\":{\"type\":\"boolean\"}}}},\"aliases\":{\"type\":\"object\"}}}}}"
                  }
                },
                "settings": {
                  "objectSchema": "schema://AppConfig"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns the list of available templates to the caller.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[GetTemplateList].output.data"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkxvZ19BUEkiOnsieCI6MjUwLCJ5Ijo0NX0sIkdldFRlbXBsYXRlTGlzdCI6eyJ4Ijo0NTAsInkiOjQ1fSwiUmVwbHlfdG9fQVBJIjp7IngiOjY1MCwieSI6NDV9fQ==",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] api_templates_GET failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
            },
            {
              "id": "BuildError",
              "name": "BuildError",
              "description": "Builds the structured HTTP 500 error body from the flow error.",
              "activity": {
                "ref": "#mapper",
                "input": {
                  "input": {
                    "mapping": {
                      "success": false,
                      "error": "INTERNAL_ERROR",
                      "message": "=coerce.toString($error.message)",
                      "activity": "=coerce.toString($error.activity)",
                      "code": "=coerce.toString($error.code)"
                    }
                  }
                },
                "schemas": {
                  "output": {
                    "output": {
                      "type": "json",
                      "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}",
                      "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the structured error body.",
              "activity": {
                "ref": "#actreply",
                "input": {
                  "reply": {
                    "mapping": {
                      "code": 500,
                      "data": "=$activity[BuildError].output"
                    }
                  }
                },
                "schemas": {
                  "input": {
                    "reply": {
                      "type": "json",
                      "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                      "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            }
          ],
          "links": [
            {
              "id": 4,
              "from": "LogError",
              "to": "BuildError",
              "type": "label",
              "label": "LogError to BuildError"
            },
            {
              "id": 5,
              "from": "BuildError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:api_chat/init_POST",
      "data": {
        "name": "api_chat/init_POST",
        "description": "Starts a new conversational session (POST /api/chat/init). Creates an empty spec, allocates a session id, and stores the session in shared memory.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "CreateSession",
            "type": "label",
            "label": "Log_API to CreateSession"
          },
          {
            "id": 3,
            "from": "CreateSession",
            "to": "StoreSession",
            "type": "label",
            "label": "CreateSession to StoreSession"
          },
          {
            "id": 4,
            "from": "StoreSession",
            "to": "Reply_to_API",
