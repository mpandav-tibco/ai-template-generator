      "fe_metadata": "{\"$schema\": \"http://json-schema.org/draft-04/schema#\", \"type\": \"object\", \"properties\": {\"interface_id_valid\": {\"type\": \"boolean\"}, \"scenario_id_valid\": {\"type\": \"boolean\"}, \"ikd_valid\": {\"type\": \"boolean\"}}}"
