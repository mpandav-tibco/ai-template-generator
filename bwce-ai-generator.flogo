    {
      "id": "flow:extract_POST",
      "data": {
        "name": "extract_POST",
        "description": "Extracts a structured BWCE integration spec from a free-text description (POST /extract). Runs the LLM, normalizes provider/protocol aliases, and reports any missing required fields.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "GetAppConfig",
            "type": "label",
            "label": "Log_API to GetAppConfig"
          },
          {
            "id": 3,
            "from": "GetAppConfig",
            "to": "RegexPreExtract",
            "type": "label",
            "label": "GetAppConfig to RenderExtractionPrompt"
          },
          {
            "id": 4,
            "from": "RegexPreExtract",
            "to": "ExtractWithLLM",
            "type": "label",
            "label": "RegexPreExtract to ExtractWithLLM"
          },
          {
            "id": 5,
            "from": "ExtractWithLLM",
            "to": "CleanJSON",
            "type": "label",
            "label": "ExtractWithLLM to CleanJSON"
          },
          {
            "id": 6,
            "from": "CleanJSON",
            "to": "ParseExtraction",
            "type": "label",
            "label": "CleanJSON to ParseExtraction"
          },
          {
            "id": 7,
            "from": "ParseExtraction",
            "to": "MergeSpec",
            "type": "label",
            "label": "ParseExtraction to MergeSpec"
          },
          {
            "id": 8,
            "from": "MergeSpec",
            "to": "BuildExtractResponse",
            "type": "label",
            "label": "MergeSpec to BuildExtractResponse"
          },
          {
            "id": 9,
            "from": "BuildExtractResponse",
            "to": "ReplyExtract",
            "type": "label",
            "label": "BuildExtractResponse to ReplyExtract"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the extraction request.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[EXTRACT] Processing extraction request\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "GetAppConfig",
            "name": "GetAppConfig",
            "description": "Loads the provider/protocol alias mappings (APP_ALIASES) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_ALIASES\"",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "RegexPreExtract",
            "name": "RegexPreExtract",
            "description": "Deterministic regex/NLU pre-extraction: detects high-confidence tokens (IKD IDs, interface verbs, canonical systems, environments) in the raw user message and emits them as signals that anchor the downstream LLM extraction.",
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=$flow.content",
                "fileName": "rules/nlu-extraction.yaml",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "json",
                "disabledRules": {
                  "mapping": []
                },
                "tags": {
                  "mapping": [
                    "nlu"
                  ]
                }
              }
            }
          },
          {
            "id": "ExtractWithLLM",
            "name": "ExtractWithLLM",
            "description": "Uses the Weaviate RAG connector LLM generation to extract a structured integration spec from the free-text message.",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:tro+3WNqx1jB2Q7ycp3EWElqm4PvaA==",
                "embeddingBaseURL": "http://localhost:11434/v1",
                "embeddingModel": "nomic-embed-text",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": false,
                "hybridAlpha": 0.5,
                "enableLLMGenerate": true,
                "llmProvider": "Ollama",
                "llmBaseURL": "http://localhost:11434",
                "llmAPIKey": "",
                "llmModel": "qwen2.5:14b",
                "systemPrompt": "You convert a user's integration request into a JSON spec. Use ONLY the user's Question text for values; the Context section is a template catalog you may use ONLY to choose template_type. Output ONLY one JSON object, no code fences and no prose, with these string keys: source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id. interface_type must be one of pub, sub or service. Use pub for publish or publisher or produce, sub for subscribe or subscriber or consume, and service for request-reply or api. cdm must be \"true\" or \"false\". Use \"\" for any field the user did not mention. Example Question: I need a publisher from SAP ECC to MQ for invoice data with CDM enabled. Example JSON: {\"source_system\":\"SAP ECC\",\"target_system\":\"MQ\",\"business_object\":\"invoice\",\"interface_type\":\"pub\",\"template_type\":\"\",\"cdm\":\"true\",\"interface_id\":\"\",\"scenario_id\":\"\",\"bitbucket_project\":\"\",\"email\":\"\",\"env\":\"\",\"k8s_domain\":\"\",\"country_code\":\"\",\"unique_id\":\"\"}",
                "maxTokens": 1024,
                "temperature": 0
              },
              "input": {
                "queryText": "=string.concat(coerce.toString($flow.content.message), \" \", coerce.toString($activity[RegexPreExtract].markdown))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 2,
                "systemPrompt": "You convert a user's integration request into a JSON spec. Use ONLY the user's Question text for values; the Context section is a template catalog you may use ONLY to choose template_type. Output ONLY one JSON object, no code fences and no prose, with these string keys: source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id. interface_type must be one of pub, sub or service. Use pub for publish or publisher or produce, sub for subscribe or subscriber or consume, and service for request-reply or api. cdm must be \"true\" or \"false\". Use \"\" for any field the user did not mention. Example Question: I need a publisher from SAP ECC to MQ for invoice data with CDM enabled. Example JSON: {\"source_system\":\"SAP ECC\",\"target_system\":\"MQ\",\"business_object\":\"invoice\",\"interface_type\":\"pub\",\"template_type\":\"\",\"cdm\":\"true\",\"interface_id\":\"\",\"scenario_id\":\"\",\"bitbucket_project\":\"\",\"email\":\"\",\"env\":\"\",\"k8s_domain\":\"\",\"country_code\":\"\",\"unique_id\":\"\"}"
              }
            }
          },
          {
            "id": "CleanJSON",
            "name": "CleanJSON",
            "description": "Strips markdown code fences from the LLM answer so it can be parsed as JSON.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "cleaned": "=string.replaceAll(string.replaceAll(coerce.toString($activity[ExtractWithLLM].answer), \"```json\", \"\"), \"```\", \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseExtraction",
            "name": "ParseExtraction",
            "description": "Parses the cleaned LLM JSON answer into a structured object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[CleanJSON].output.cleaned"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "MergeSpec",
            "name": "MergeSpec",
            "description": "Merges the LLM-extracted fields with the caller's current_spec (extracted value wins when present).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=(coerce.toString($activity[ParseExtraction].jsonObject.source_system) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.source_system) : (isDefined($flow.content.current_spec.source_system) ? coerce.toString($flow.content.current_spec.source_system) : \"\")",
                    "target_system": "=(coerce.toString($activity[ParseExtraction].jsonObject.target_system) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.target_system) : (isDefined($flow.content.current_spec.target_system) ? coerce.toString($flow.content.current_spec.target_system) : \"\")",
                    "business_object": "=(coerce.toString($activity[ParseExtraction].jsonObject.business_object) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.business_object) : (isDefined($flow.content.current_spec.business_object) ? coerce.toString($flow.content.current_spec.business_object) : \"\")",
                    "interface_type": "=(coerce.toString($activity[ParseExtraction].jsonObject.interface_type) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.interface_type) : (isDefined($flow.content.current_spec.interface_type) ? coerce.toString($flow.content.current_spec.interface_type) : \"\")",
                    "template_type": "=(coerce.toString($activity[ParseExtraction].jsonObject.template_type) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.template_type) : (isDefined($flow.content.current_spec.template_type) ? coerce.toString($flow.content.current_spec.template_type) : \"\")",
                    "cdm": "=(coerce.toString($activity[ParseExtraction].jsonObject.cdm) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.cdm) : (isDefined($flow.content.current_spec.cdm) ? coerce.toString($flow.content.current_spec.cdm) : \"\")",
                    "interface_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.interface_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.interface_id) : (isDefined($flow.content.current_spec.interface_id) ? coerce.toString($flow.content.current_spec.interface_id) : \"\")",
                    "scenario_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.scenario_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.scenario_id) : (isDefined($flow.content.current_spec.scenario_id) ? coerce.toString($flow.content.current_spec.scenario_id) : \"\")",
                    "bitbucket_project": "=(coerce.toString($activity[ParseExtraction].jsonObject.bitbucket_project) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.bitbucket_project) : (isDefined($flow.content.current_spec.bitbucket_project) ? coerce.toString($flow.content.current_spec.bitbucket_project) : \"\")",
                    "email": "=(coerce.toString($activity[ParseExtraction].jsonObject.email) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.email) : (isDefined($flow.content.current_spec.email) ? coerce.toString($flow.content.current_spec.email) : \"\")",
                    "env": "=(coerce.toString($activity[ParseExtraction].jsonObject.env) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.env) : (isDefined($flow.content.current_spec.env) ? coerce.toString($flow.content.current_spec.env) : \"\")",
                    "k8s_domain": "=(coerce.toString($activity[ParseExtraction].jsonObject.k8s_domain) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.k8s_domain) : (isDefined($flow.content.current_spec.k8s_domain) ? coerce.toString($flow.content.current_spec.k8s_domain) : \"\")",
                    "country_code": "=(coerce.toString($activity[ParseExtraction].jsonObject.country_code) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.country_code) : (isDefined($flow.content.current_spec.country_code) ? coerce.toString($flow.content.current_spec.country_code) : \"\")",
                    "unique_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.unique_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.unique_id) : (isDefined($flow.content.current_spec.unique_id) ? coerce.toString($flow.content.current_spec.unique_id) : \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildExtractResponse",
            "name": "BuildExtractResponse",
            "description": "Assembles the /extract response: merged spec, readiness, missing required fields, and a human message.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "spec": {
                      "source_system": "=$activity[MergeSpec].output.source_system",
                      "target_system": "=$activity[MergeSpec].output.target_system",
                      "business_object": "=$activity[MergeSpec].output.business_object",
                      "interface_type": "=$activity[MergeSpec].output.interface_type",
                      "template_type": "=$activity[MergeSpec].output.template_type",
                      "cdm": "=$activity[MergeSpec].output.cdm",
                      "interface_id": "=$activity[MergeSpec].output.interface_id",
                      "scenario_id": "=$activity[MergeSpec].output.scenario_id",
                      "bitbucket_project": "=$activity[MergeSpec].output.bitbucket_project",
                      "email": "=$activity[MergeSpec].output.email",
                      "env": "=$activity[MergeSpec].output.env",
                      "k8s_domain": "=$activity[MergeSpec].output.k8s_domain",
                      "country_code": "=$activity[MergeSpec].output.country_code",
                      "unique_id": "=$activity[MergeSpec].output.unique_id"
                    },
                    "ready_to_generate": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\" && $activity[MergeSpec].output.template_type != \"\")",
                    "missing": {
                      "source_system": "=($activity[MergeSpec].output.source_system == \"\")",
                      "target_system": "=($activity[MergeSpec].output.target_system == \"\")",
                      "business_object": "=($activity[MergeSpec].output.business_object == \"\")",
                      "interface_type": "=($activity[MergeSpec].output.interface_type == \"\")",
                      "template_type": "=($activity[MergeSpec].output.template_type == \"\")"
                    },
                    "message": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\" && $activity[MergeSpec].output.template_type != \"\") ? \"All required fields captured — ready to generate.\" : \"Some required fields are still missing. Please provide the missing values.\"",
                    "raw_answer": "=coerce.toString($activity[ExtractWithLLM].answer)"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"missing\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"boolean\"}, \"target_system\": {\"type\": \"boolean\"}, \"business_object\": {\"type\": \"boolean\"}, \"interface_type\": {\"type\": \"boolean\"}, \"template_type\": {\"type\": \"boolean\"}}}, \"message\": {\"type\": \"string\"}, \"raw_answer\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReplyExtract",
            "name": "ReplyExtract",
            "description": "Returns the extracted spec and readiness to the caller.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildExtractResponse].output"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] extract_POST failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
            },
            {
              "id": "BuildError",
              "name": "BuildError",
              "description": "Builds the structured HTTP 500 error body from the flow error.",
              "activity": {
                "ref": "#mapper",
                "input": {
                  "input": {
                    "mapping": {
                      "success": false,
                      "error": "INTERNAL_ERROR",
                      "message": "=coerce.toString($error.message)",
                      "activity": "=coerce.toString($error.activity)",
                      "code": "=coerce.toString($error.code)"
                    }
                  }
                },
                "schemas": {
                  "output": {
                    "output": {
                      "type": "json",
                      "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}",
                      "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the structured error body.",
              "activity": {
                "ref": "#actreply",
                "input": {
                  "reply": {
                    "mapping": {
                      "code": 500,
                      "data": "=$activity[BuildError].output"
                    }
                  }
                },
                "schemas": {
                  "input": {
                    "reply": {
                      "type": "json",
                      "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                      "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            }
          ],
          "links": [
            {
              "id": 10,
              "from": "LogError",
              "to": "BuildError",
              "type": "label",
              "label": "LogError to BuildError"
            },
            {
              "id": 11,
              "from": "BuildError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "content",
              "type": "object"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:generate_POST",
      "data": {
        "name": "generate_POST",
        "description": "Generates a BWCE integration repository from a validated spec (POST /generate). Validates the spec, selects the best-matching template via Weaviate vector search, records the generation in PostgreSQL, and returns the result.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "Log_API",
            "type": "label",
            "label": "StartActivity to Log_API"
          },
          {
            "id": 2,
            "from": "Log_API",
            "to": "NormalizeSpec",
            "type": "label",
            "label": "Log_API to NormalizeSpec"
          },
          {
            "id": 3,
            "from": "NormalizeSpec",
            "to": "ValidateSpec",
            "type": "label",
            "label": "NormalizeSpec to ValidateSpec"
          },
          {
            "id": 4,
            "from": "ValidateSpec",
            "to": "GetIKDInterfaces",
            "type": "expression",
            "label": "Spec valid (0 errors)",
            "value": "$activity[ValidateSpec].errorCount == 0"
          },
          {
            "id": 5,
            "from": "ValidateSpec",
            "to": "BuildValidationError",
            "type": "expression",
            "label": "Spec invalid",
            "value": "$activity[ValidateSpec].errorCount > 0"
          },
          {
            "id": 6,
            "from": "GetIKDInterfaces",
            "to": "GetIKDScenarios",
            "type": "label",
            "label": "GetIKDInterfaces to GetIKDScenarios"
          },
          {
            "id": 7,
            "from": "BuildValidationError",
            "to": "ReplyValidationError",
            "type": "label",
            "label": "BuildValidationError to ReplyValidationError"
          },
          {
            "id": 8,
            "from": "GetIKDScenarios",
            "to": "CrossCheckIKD",
            "type": "label",
            "label": "GetIKDScenarios to CrossCheckIKD"
          },
          {
            "id": 9,
            "from": "CrossCheckIKD",
            "to": "BuildRepoName",
            "type": "expression",
            "label": "IKD valid",
            "value": "$activity[CrossCheckIKD].output.ikd_valid == true"
          },
          {
            "id": 10,
            "from": "CrossCheckIKD",
            "to": "BuildIKDErrorResponse",
            "type": "expression",
            "label": "IKD invalid",
            "value": "$activity[CrossCheckIKD].output.ikd_valid == false"
          },
          {
            "id": 11,
            "from": "BuildRepoName",
            "to": "CheckDuplicate",
            "type": "label",
            "label": "BuildRepoName to CheckDuplicate"
          },
          {
            "id": 12,
            "from": "BuildIKDErrorResponse",
            "to": "ReplyIKDError",
            "type": "label",
            "label": "BuildIKDErrorResponse to ReplyIKDError"
          },
          {
            "id": 13,
            "from": "CheckDuplicate",
            "to": "SelectTemplate",
            "type": "expression",
            "label": "No duplicate or config-only",
            "value": "array.count($activity[CheckDuplicate].Output.records) == 0 || $activity[NormalizeSpec].output.config_only == true"
          },
          {
            "id": 14,
            "from": "CheckDuplicate",
            "to": "BuildDuplicateResponse",
            "type": "expression",
            "label": "Duplicate (full generate only)",
            "value": "array.count($activity[CheckDuplicate].Output.records) > 0 && $activity[NormalizeSpec].output.config_only == false"
          },
          {
            "id": 15,
            "from": "SelectTemplate",
            "to": "ResolveTemplateName",
            "type": "label",
            "label": "SelectTemplate to ResolveTemplateName"
          },
          {
            "id": 16,
            "from": "BuildDuplicateResponse",
            "to": "ReplyDuplicate",
            "type": "label",
            "label": "BuildDuplicateResponse to ReplyDuplicate"
          },
          {
            "id": 17,
            "from": "ResolveTemplateName",
            "to": "RegisterGeneration",
            "type": "label",
            "label": "ResolveTemplateName to RegisterGeneration"
          },
          {
            "from": "RegisterGeneration",
            "to": "ScaffoldArtifacts",
            "type": "label",
            "label": "RegisterGeneration to ScaffoldArtifacts",
            "id": 18
          },
          {
            "from": "ScaffoldArtifacts",
            "to": "NotifyTeam",
            "type": "label",
            "label": "ScaffoldArtifacts to NotifyTeam",
            "id": 19
          },
          {
            "from": "NotifyTeam",
            "to": "BuildGenerateResponse",
            "type": "label",
            "label": "NotifyTeam to BuildGenerateResponse",
            "id": 20
          },
          {
            "id": 21,
            "from": "BuildGenerateResponse",
            "to": "Reply_to_API",
            "type": "label",
            "label": "BuildGenerateResponse to Reply_to_API"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "Log_API",
            "name": "Log_API",
            "description": "Logs the generation request.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[GENERATE] Processing generation request\"",
                "logLevel": ""
              }
            }
          },
          {
            "id": "NormalizeSpec",
            "name": "NormalizeSpec",
            "description": "Normalises the incoming spec: lowercases/trims identifiers and applies safe defaults (scenario_id=1234, env=DEV, k8s_domain=cite, bw_profile=default, interface_id/country_code/unique_id=NA).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=string.toLower(string.trim(coerce.toString($flow.content.spec.source_system), \" \"))",
                    "target_system": "=string.toLower(string.trim(coerce.toString($flow.content.spec.target_system), \" \"))",
                    "business_object": "=string.toLower(string.trim(coerce.toString($flow.content.spec.business_object), \" \"))",
                    "interface_type": "=string.toLower(string.trim(coerce.toString($flow.content.spec.interface_type), \" \"))",
                    "template_type": "=coerce.toString($flow.content.spec.template_type)",
                    "bitbucket_project": "=coerce.toString($flow.content.spec.bitbucket_project)",
                    "email": "=coerce.toString($flow.content.spec.email)",
                    "cdm": "=$flow.content.spec.cdm == true",
                    "need_secret": "=$flow.content.spec.need_secret == true",
                    "interface_id": "=(coerce.toString($flow.content.spec.interface_id) != \"\") ? coerce.toString($flow.content.spec.interface_id) : \"NA\"",
                    "scenario_id": "=(coerce.toString($flow.content.spec.scenario_id) != \"\") ? coerce.toString($flow.content.spec.scenario_id) : \"1234\"",
                    "env": "=(coerce.toString($flow.content.spec.env) != \"\") ? coerce.toString($flow.content.spec.env) : \"DEV\"",
                    "k8s_domain": "=(coerce.toString($flow.content.spec.k8s_domain) != \"\") ? coerce.toString($flow.content.spec.k8s_domain) : \"cite\"",
                    "bw_profile": "=(coerce.toString($flow.content.spec.bw_profile) != \"\") ? coerce.toString($flow.content.spec.bw_profile) : \"default\"",
                    "country_code": "=(coerce.toString($flow.content.spec.country_code) != \"\") ? coerce.toString($flow.content.spec.country_code) : \"NA\"",
                    "unique_id": "=(coerce.toString($flow.content.spec.unique_id) != \"\") ? coerce.toString($flow.content.spec.unique_id) : \"NA\"",
                    "country_suffix": "=(string.toLower(coerce.toString($flow.content.spec.country_code)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.country_code)) != \"\") ? string.concat(\"-\", string.toLower(coerce.toString($flow.content.spec.country_code))) : \"\"",
                    "unique_suffix": "=(string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"na\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"1none\" && string.toLower(coerce.toString($flow.content.spec.unique_id)) != \"\") ? string.concat(\"-\", string.toLower(coerce.toString($flow.content.spec.unique_id))) : \"\"",
                    "generation_id": "=utils.uuid()",
                    "config_only": "=$flow.content.config_only == true"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
