      "fe_metadata": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"success\": {\n      \"type\": \"boolean\"\n    },\n    \"repo_name\": {\n      \"type\": \"string\"\n    },\n    \"template_name\": {\n      \"type\": \"string\"\n    },\n    \"generation_id\": {\n      \"type\": \"string\"\n    },\n    \"shell_command\": {\n      \"type\": \"string\"\n    }\n  }\n}"
