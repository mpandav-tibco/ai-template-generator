          {
            "id": "BuildGenerateResponse",
            "name": "BuildGenerateResponse",
            "description": "Builds an idempotent response indicating the repository already exists, echoing the existing registration id and status from the registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "repo_name": "=$activity[BuildRepoName].output.repo_name",
                    "generation_id": "=$activity[NormalizeSpec].output.generation_id",
                    "template_name": "=$activity[ResolveTemplateName].output.template_name",
                    "message": "=$activity[NormalizeSpec].output.config_only == true ? \"Configuration files (Dockerfile, Kubernetes, pipeline) refreshed — repository scaffold and git were left untouched.\" : \"Repository scaffolded successfully and registered.\"",
                    "shell_command": "=string.concat(\"git clone https://bitbucket.org/\", $activity[NormalizeSpec].output.bitbucket_project, \"/\", $activity[BuildRepoName].output.repo_name, \".git\")",
                    "source_system": "=$activity[NormalizeSpec].output.source_system",
                    "target_system": "=$activity[NormalizeSpec].output.target_system",
                    "business_object": "=$activity[NormalizeSpec].output.business_object",
                    "interface_type": "=$activity[NormalizeSpec].output.interface_type",
                    "env": "=$activity[NormalizeSpec].output.env",
                    "scenario_id": "=$activity[NormalizeSpec].output.scenario_id",
                    "interface_id": "=$activity[NormalizeSpec].output.interface_id",
                    "template_type": "=coerce.toString($activity[NormalizeSpec].output.template_type)",
                    "template_match_score": "=$activity[ResolveTemplateName].output.match_score",
                    "need_secret": "=$activity[NormalizeSpec].output.need_secret",
                    "country_code": "=$activity[NormalizeSpec].output.country_code",
                    "unique_id": "=$activity[NormalizeSpec].output.unique_id",
                    "config_only": "=$activity[NormalizeSpec].output.config_only"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://DuplicateResponse"
                },
                "output": {
                  "output": "schema://DuplicateResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "Reply_to_API",
            "name": "Reply_to_API",
            "description": "Returns the idempotent duplicate-detection result to the caller without creating a new repository.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildGenerateResponse].output"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildDuplicateResponse",
            "name": "BuildDuplicateResponse",
            "description": "Builds an idempotent response indicating the repository already exists, echoing the existing registration id and status from the registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": true,
                    "duplicate": true,
                    "repo_name": "=$activity[BuildRepoName].output.repo_name",
                    "message": "Repository already exists in the generation registry; returning the existing registration (idempotent, no new repository was scaffolded).",
                    "existing_status": "=$activity[CheckDuplicate].Output.records[0].status",
                    "existing_generation_id": "=$activity[CheckDuplicate].Output.records[0].generation_id"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://DuplicateResponse"
                },
                "output": {
                  "output": "schema://DuplicateResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReplyDuplicate",
            "name": "ReplyDuplicate",
            "description": "Returns the idempotent duplicate-detection result to the caller without creating a new repository.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildDuplicateResponse].output"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildIKDErrorResponse",
            "name": "BuildIKDErrorResponse",
            "description": "Builds a validation-error response when the interface_id and/or scenario_id are not registered in the IKD registry.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": false,
                    "error": "IKD_VALIDATION_FAILED",
                    "message": "=string.concat(\"IKD validation failed. interface_id='\", $activity[NormalizeSpec].output.interface_id, \"', scenario_id='\", $activity[NormalizeSpec].output.scenario_id, \"'. One or both are not present in the IKD registry.\")",
                    "interface_id_valid": "=$activity[CrossCheckIKD].output.interface_id_valid",
                    "scenario_id_valid": "=$activity[CrossCheckIKD].output.scenario_id_valid",
                    "interface_id": "=$activity[NormalizeSpec].output.interface_id",
                    "scenario_id": "=$activity[NormalizeSpec].output.scenario_id"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://IKDErrorResponse"
                },
                "output": {
                  "output": "schema://IKDErrorResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReplyIKDError",
            "name": "ReplyIKDError",
            "description": "Returns the IKD validation error to the caller without registering or scaffolding a repository.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "data": "=$activity[BuildIKDErrorResponse].output"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildValidationError",
            "name": "BuildValidationError",
            "description": "Builds the 400 Bad Request response from the rule-engine validation findings (errorCount + formatted markdown report).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "success": false,
                    "error": "VALIDATION_FAILED",
                    "error_count": "=$activity[ValidateSpec].errorCount",
                    "message": "=string.concat(\"Spec validation failed with \", coerce.toString($activity[ValidateSpec].errorCount), \" error(s). See details.\")",
                    "details": "=coerce.toString($activity[ValidateSpec].markdown)"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://ValidationErrorResponse"
                },
                "output": {
                  "output": "schema://ValidationErrorResponse"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReplyValidationError",
            "name": "ReplyValidationError",
            "description": "Returns HTTP 400 with the spec-validation errors; no repository is registered or scaffolded.",
            "activity": {
              "ref": "#actreply",
              "input": {
                "reply": {
                  "mapping": {
                    "code": 400,
                    "data": "=$activity[BuildValidationError].output"
                  }
                }
              },
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                    "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "",
        "errorHandler": {
          "tasks": [
            {
              "id": "LogError",
              "name": "LogError",
              "description": "Logs the unhandled flow error (activity, code, message).",
              "activity": {
                "ref": "#log",
                "input": {
                  "Log Level": "ERROR",
                  "flowInfo": true,
                  "message": "=string.concat(\"[ERROR] generate_POST failed at activity \", coerce.toString($error.activity), \" (code \", coerce.toString($error.code), \"): \", coerce.toString($error.message))",
                  "logLevel": ""
                }
              }
            },
            {
              "id": "BuildError",
              "name": "BuildError",
              "description": "Builds the structured HTTP 500 error body from the flow error.",
              "activity": {
                "ref": "#mapper",
                "input": {
                  "input": {
                    "mapping": {
                      "success": false,
                      "error": "INTERNAL_ERROR",
                      "message": "=coerce.toString($error.message)",
                      "activity": "=coerce.toString($error.activity)",
                      "code": "=coerce.toString($error.code)"
                    }
                  }
                },
                "schemas": {
                  "output": {
                    "output": {
                      "type": "json",
                      "value": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}",
                      "fe_metadata": "{\"type\": \"object\", \"properties\": {\"success\": {\"type\": \"boolean\"}, \"error\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"activity\": {\"type\": \"string\"}, \"code\": {\"type\": \"string\"}}}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            },
            {
              "id": "ReplyError",
              "name": "ReplyError",
              "description": "Returns HTTP 500 with the structured error body.",
              "activity": {
                "ref": "#actreply",
                "input": {
                  "reply": {
                    "mapping": {
                      "code": 500,
                      "data": "=$activity[BuildError].output"
                    }
                  }
                },
                "schemas": {
                  "input": {
                    "reply": {
                      "type": "json",
                      "value": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}",
                      "fe_metadata": "{\"type\":\"object\",\"title\":\"Inputs\",\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[]}"
                    }
                  }
                },
                "feSchemaMap": {}
              }
            }
          ],
          "links": [
            {
              "id": 29,
              "from": "LogError",
              "to": "BuildError",
              "type": "label",
              "label": "LogError to BuildError"
            },
            {
              "id": 30,
              "from": "BuildError",
              "to": "ReplyError",
              "type": "label",
              "label": "BuildError to ReplyError"
            }
          ]
        },
        "metadata": {
          "input": [
            {
              "name": "headers",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}}"
              }
            },
            {
              "name": "requestURI",
              "type": "string"
            },
            {
              "name": "method",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {
            "input": "{\"type\":\"object\",\"title\":\"BWCEAIIntegrationGenerator\",\"properties\":{\"headers\":{\"type\":\"object\",\"properties\":{\"Accept\":{\"type\":\"string\",\"visible\":false},\"Accept-Charset\":{\"type\":\"string\",\"visible\":false},\"Accept-Encoding\":{\"type\":\"string\",\"visible\":false},\"Authorization\":{\"type\":\"string\",\"visible\":false},\"Connection\":{\"type\":\"string\",\"visible\":false},\"Content-Length\":{\"type\":\"string\",\"visible\":false},\"Content-Type\":{\"type\":\"string\",\"visible\":false},\"Cookie\":{\"type\":\"string\",\"visible\":false},\"Pragma\":{\"type\":\"string\",\"visible\":false}},\"required\":[]},\"requestURI\":{\"type\":\"string\",\"required\":false},\"method\":{\"type\":\"string\",\"required\":false}}}"
          }
        },
        "explicitReply": true
      }
    },
    {
      "id": "flow:ScaffoldArtifactsFlow",
      "data": {
        "name": "ScaffoldArtifactsFlow",
        "description": "Scaffolds the mock BWCE repository artifacts (manifest, README, CI pipeline, Dockerfile, Kubernetes manifest). For config_only runs it skips the repo+README scaffold and writes only the config files.",
        "links": [
          {
            "from": "StartActivity",
            "to": "ScaffoldRepo",
            "type": "expression",
            "label": "Full generate (scaffold repo)",
            "value": "$flow.config_only == false",
            "id": 1
          },
          {
            "from": "StartActivity",
            "to": "ScaffoldPipeline",
            "type": "expression",
            "label": "Config-only (skip repo scaffold)",
            "value": "$flow.config_only == true",
            "id": 2
          },
          {
            "from": "ScaffoldRepo",
            "to": "ScaffoldReadme",
            "type": "label",
            "label": "ScaffoldRepo to ScaffoldReadme",
            "id": 3
          },
          {
            "from": "ScaffoldPipeline",
            "to": "ScaffoldDockerfile",
            "type": "label",
            "label": "ScaffoldPipeline to ScaffoldDockerfile",
            "id": 4
          },
          {
            "from": "ScaffoldReadme",
            "to": "ScaffoldPipeline",
            "type": "label",
            "label": "ScaffoldReadme to ScaffoldPipeline",
            "id": 5
          },
          {
            "from": "ScaffoldDockerfile",
            "to": "ScaffoldK8s",
            "type": "label",
            "label": "ScaffoldDockerfile to ScaffoldK8s",
            "id": 6
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ScaffoldRepo",
            "name": "ScaffoldRepo",
            "description": "Mocks Bitbucket repository creation by writing a scaffold manifest (repo name, Bitbucket URL, selected template, and spec details) to the local SCAFFOLD_OUTPUT_DIR folder.",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/manifest.json\")",
                    "overwrite": true,
                    "textContent": "=string.concat(\"{\\n  \\\"repo_name\\\": \\\"\", $flow.repo_name, \"\\\",\\n  \\\"bitbucket_url\\\": \\\"\", $property[\"BITBUCKET_BASE_URL\"], \"/\", $flow.repo_name, \".git\", \"\\\",\\n  \\\"template\\\": \\\"\", $flow.template_name, \"\\\",\\n  \\\"source_system\\\": \\\"\", $flow.source_system, \"\\\",\\n  \\\"target_system\\\": \\\"\", $flow.target_system, \"\\\",\\n  \\\"business_object\\\": \\\"\", $flow.business_object, \"\\\",\\n  \\\"interface_type\\\": \\\"\", $flow.interface_type, \"\\\",\\n  \\\"env\\\": \\\"\", $flow.env, \"\\\",\\n  \\\"country_code\\\": \\\"\", $flow.country_code, \"\\\",\\n  \\\"unique_id\\\": \\\"\", $flow.unique_id, \"\\\",\\n  \\\"need_secret\\\": \", coerce.toString($flow.need_secret), \",\\n  \\\"scaffold_command\\\": \\\"./GenerateCodeFromTemplate.sh --repo=\", $flow.repo_name, \"\\\"\\n}\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ScaffoldReadme",
            "name": "ScaffoldReadme",
            "description": "Mock scaffold: writes the repository README.md describing the generated integration.",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/README.md\")",
                    "overwrite": true,
                    "textContent": "=string.concat(\"# \", $flow.repo_name, \"\\n\\nAuto-generated BWCE integration repository (mock scaffold).\\n\\n| Field | Value |\\n| --- | --- |\\n| Source System | \", $flow.source_system, \" |\\n| Target System | \", $flow.target_system, \" |\\n| Business Object | \", $flow.business_object, \" |\\n| Interface Type | \", $flow.interface_type, \" |\\n| Environment | \", $flow.env, \" |\\n\\n## Repository\\n\", $property[\"BITBUCKET_BASE_URL\"], \"/\", $flow.repo_name, \".git\\n\\n## Build & Deploy\\n```\\n./GenerateCodeFromTemplate.sh --repo=\", $flow.repo_name, \"\\nmvn clean package\\ndocker build -t \", $flow.repo_name, \":latest .\\nkubectl apply -f k8s/deployment.yaml\\n```\\n\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ScaffoldPipeline",
            "name": "ScaffoldPipeline",
            "description": "Mock scaffold: writes the Bitbucket CI/CD pipeline (bitbucket-pipelines.yml).",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/bitbucket-pipelines.yml\")",
                    "overwrite": true,
                    "textContent": "=string.concat(\"image: tibco/bwce:latest\\n\\npipelines:\\n  default:\\n    - step:\\n        name: Build EAR\\n        script:\\n          - mvn -q clean package\\n        artifacts:\\n          - target/*.ear\\n    - step:\\n        name: Docker Build & Push\\n        services:\\n          - docker\\n        script:\\n          - docker build -t \", $flow.repo_name, \":$BITBUCKET_BUILD_NUMBER .\\n          - docker push \", $flow.repo_name, \":$BITBUCKET_BUILD_NUMBER\\n    - step:\\n        name: Deploy to Kubernetes (\", $flow.env, \")\\n        deployment: \", $flow.env, \"\\n        script:\\n          - kubectl apply -f k8s/deployment.yaml\\n\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ScaffoldDockerfile",
            "name": "ScaffoldDockerfile",
            "description": "Mock scaffold: writes the container Dockerfile for the BWCE app.",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/Dockerfile\")",
                    "overwrite": true,
                    "textContent": "=string.concat(\"FROM tibco/bwce:latest\\n\\nLABEL repo=\\\"\", $flow.repo_name, \"\\\" source=\\\"\", $flow.source_system, \"\\\" target=\\\"\", $flow.target_system, \"\\\" interface=\\\"\", $flow.interface_type, \"\\\"\\n\\nCOPY target/\", $flow.repo_name, \".ear /resources/addons/ear/\\nENV APP_NAME=\", $flow.repo_name, \"\\nEXPOSE 8080\\n\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ScaffoldK8s",
            "name": "ScaffoldK8s",
            "description": "Mock scaffold: writes the Kubernetes Deployment + Service manifest.",
            "activity": {
              "ref": "#write",
              "input": {
                "writeAs": "Text",
                "createNonExistingDir": true,
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=string.concat($property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/k8s/deployment.yaml\")",
                    "overwrite": true,
                    "textContent": "=string.concat(\"apiVersion: apps/v1\\nkind: Deployment\\nmetadata:\\n  name: \", $flow.repo_name, \"\\n  namespace: \", $flow.env, \"\\n  labels:\\n    app: \", $flow.repo_name, \"\\nspec:\\n  replicas: 1\\n  selector:\\n    matchLabels:\\n      app: \", $flow.repo_name, \"\\n  template:\\n    metadata:\\n      labels:\\n        app: \", $flow.repo_name, \"\\n    spec:\\n      containers:\\n        - name: \", $flow.repo_name, \"\\n          image: \", $flow.repo_name, \":latest\\n          ports:\\n            - containerPort: 8080\\n          env:\\n            - name: SOURCE_SYSTEM\\n              value: \\\"\", $flow.source_system, \"\\\"\\n            - name: TARGET_SYSTEM\\n              value: \\\"\", $flow.target_system, \"\\\"\\n---\\napiVersion: v1\\nkind: Service\\nmetadata:\\n  name: \", $flow.repo_name, \"\\n  namespace: \", $flow.env, \"\\nspec:\\n  selector:\\n    app: \", $flow.repo_name, \"\\n  ports:\\n    - port: 80\\n      targetPort: 8080\\n\")"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"textContent\":{\"type\":\"string\"}},\"required\":[\"fileName\",\"overwrite\",\"textContent\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5IjoxNTB9LCJTY2FmZm9sZFJlcG8iOnsieCI6MjUwLCJ5Ijo0NX0sIlNjYWZmb2xkUmVhZG1lIjp7IngiOjQ1MCwieSI6NDV9LCJTY2FmZm9sZFBpcGVsaW5lIjp7IngiOjY1MCwieSI6MTUwfSwiU2NhZmZvbGREb2NrZXJmaWxlIjp7IngiOjg1MCwieSI6MTUwfSwiU2NhZmZvbGRLOHMiOnsieCI6MTA1MCwieSI6MTUwfX0=",
        "metadata": {
          "input": [
            {
              "name": "repo_name",
              "type": "string"
            },
            {
              "name": "template_name",
              "type": "string"
            },
            {
              "name": "business_object",
              "type": "string"
            },
            {
              "name": "config_only",
              "type": "boolean"
            },
            {
              "name": "country_code",
              "type": "string"
            },
            {
              "name": "env",
              "type": "string"
            },
            {
              "name": "interface_type",
              "type": "string"
            },
            {
              "name": "need_secret",
              "type": "boolean"
            },
            {
              "name": "source_system",
              "type": "string"
            },
            {
              "name": "target_system",
              "type": "string"
            },
            {
              "name": "unique_id",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:SendNotificationFlow",
      "data": {
        "name": "SendNotificationFlow",
        "description": "Builds the rich HTML email (full-repo vs config-only variant) with the inline brand logo and doc attachment, and sends it via SMTP to the core integration team.",
        "links": [
          {
            "from": "StartActivity",
            "to": "BuildEmailParts",
            "type": "label",
            "label": "StartActivity to BuildEmailParts",
            "id": 1
          },
          {
            "from": "BuildEmailParts",
            "to": "BuildEmailAttachment",
            "type": "label",
            "label": "BuildEmailParts to BuildEmailAttachment",
            "id": 2
          },
          {
            "from": "BuildEmailAttachment",
            "to": "SendNotification",
            "type": "label",
            "label": "BuildEmailAttachment to SendNotification",
            "id": 3
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "BuildEmailParts",
            "name": "BuildEmailParts",
            "description": "Pre-builds both notification variants (full repo vs config-only) as complete plain-concat strings: message, subject and the doc-attachment file/name. The downstream mapper then selects per config_only with simple ref-only ternaries (Flogo cannot parse a ternary whose branch is a function call).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "message_full": "=string.concat(\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='color-scheme' content='light dark'><meta name='supported-color-schemes' content='light dark'></head><body style='margin:0;padding:0;background:#eef1f6'><div style='display:none;max-height:0;overflow:hidden;mso-hide:all;opacity:0;color:#eef1f6;font-size:1px;line-height:1px'>New repository scaffolded &mdash; \", $flow.repo_name, \"</div><div style='margin:0;padding:24px 12px;background:#eef1f6;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif'><table role='presentation' align='center' width='600' cellpadding='0' cellspacing='0' style='max-width:600px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0'><tr><td style='background:#0b1f3a;padding:22px 28px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0'><tr><td style='vertical-align:middle;width:44px'><img src='cid:email-logo.png' width='44' height='44' alt='BWCE AI' style='display:block;width:44px;height:44px;border-radius:10px' /></td><td style='vertical-align:middle;padding-left:14px'><div style='color:#ffffff;font-size:18px;font-weight:700;letter-spacing:0.2px'>BWCE AI Generator</div><div style='color:#9fb3c8;font-size:12px;margin-top:2px'>New integration repository scaffolded</div></td></tr></table></td></tr><tr><td style='height:3px;background:#00e0a4;line-height:3px;font-size:0'>&nbsp;</td></tr><tr><td style='padding:22px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#e6f9f2;border:1px solid #00b386;border-radius:10px'><tr><td style='padding:13px 16px;color:#04694f;font-size:14px;font-weight:600'>&#10003;&nbsp; Repository generated and registered successfully.</td></tr></table></td></tr><tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em'>Repository</div><div style='font-family:Consolas,Menlo,monospace;font-size:20px;font-weight:700;color:#0b1f3a;margin-top:5px;word-break:break-all'>\", $flow.repo_name, \"</div></td></tr><tr><td style='padding:18px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;border-collapse:collapse'>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Template</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.template_name, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Source &rarr; Target</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6'>\", $flow.source_system, \" &rarr; \", $flow.target_system, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Business Object</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.business_object, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Interface Type</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.interface_type, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Environment</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.env, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>CDM</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", coerce.toString($flow.cdm), \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;width:42%'>Template Match Score</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;'>\", coerce.toString($flow.match_score), \"</td></tr>\", \"</table></td></tr>\", \"<tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px'>Clone</div><div style='background:#0a0c10;border-radius:8px;padding:12px 14px;font-family:Consolas,Menlo,monospace;font-size:12.5px;color:#00e0a4;word-break:break-all'>git clone \", $property[\"BITBUCKET_BASE_URL\"], \"/\", $flow.repo_name, \".git</div></td></tr><tr><td style='padding:18px 28px 26px'><a href='\", $property[\"BITBUCKET_BASE_URL\"], \"/\", $flow.repo_name, \".git' style='display:inline-block;background:#00b386;color:#ffffff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 24px;border-radius:8px'>Open in Bitbucket &rarr;</a></td></tr>\", \"<tr><td style='background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 28px;color:#94a3b8;font-size:11px;line-height:1.6'>Generation ID: \", $flow.generation_id, \"<br />Automated notification from the BWCE AI Integration Generator</td></tr></table><div style='text-align:center;color:#b4c0cf;font-size:11px;padding:14px 0 2px'>adidas &middot; Core Integration Platform</div></div></body></html>\")",
                    "message_config": "=string.concat(\"<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta name='color-scheme' content='light dark'><meta name='supported-color-schemes' content='light dark'></head><body style='margin:0;padding:0;background:#eef1f6'><div style='display:none;max-height:0;overflow:hidden;mso-hide:all;opacity:0;color:#eef1f6;font-size:1px;line-height:1px'>Config-only generation complete &mdash; \", $flow.repo_name, \"</div><div style='margin:0;padding:24px 12px;background:#eef1f6;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif'><table role='presentation' align='center' width='600' cellpadding='0' cellspacing='0' style='max-width:600px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e2e8f0'><tr><td style='background:#0b1f3a;padding:22px 28px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0'><tr><td style='vertical-align:middle;width:44px'><img src='cid:email-logo.png' width='44' height='44' alt='BWCE AI' style='display:block;width:44px;height:44px;border-radius:10px' /></td><td style='vertical-align:middle;padding-left:14px'><div style='color:#ffffff;font-size:18px;font-weight:700;letter-spacing:0.2px'>BWCE AI Generator</div><div style='color:#9fb3c8;font-size:12px;margin-top:2px'>Config-only generation &middot; scaffold skipped</div></td></tr></table></td></tr><tr><td style='height:3px;background:#00e0a4;line-height:3px;font-size:0'>&nbsp;</td></tr><tr><td style='padding:22px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#e6f9f2;border:1px solid #00b386;border-radius:10px'><tr><td style='padding:13px 16px;color:#04694f;font-size:14px;font-weight:600'>&#10003;&nbsp; Configuration generated successfully (config-only).</td></tr></table></td></tr><tr><td style='padding:20px 28px 0'><div style='color:#64748b;font-size:11px;text-transform:uppercase;letter-spacing:0.08em'>Repository (name reserved)</div><div style='font-family:Consolas,Menlo,monospace;font-size:20px;font-weight:700;color:#0b1f3a;margin-top:5px;word-break:break-all'>\", $flow.repo_name, \"</div></td></tr><tr><td style='padding:18px 28px 0'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;border-collapse:collapse'>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Template</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.template_name, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Source &rarr; Target</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6'>\", $flow.source_system, \" &rarr; \", $flow.target_system, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Business Object</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.business_object, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Interface Type</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.interface_type, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>Environment</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", $flow.env, \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;border-bottom:1px solid #eef1f6;width:42%'>CDM</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;border-bottom:1px solid #eef1f6;'>\", coerce.toString($flow.cdm), \"</td></tr>\", \"<tr><td style='padding:9px 0;color:#64748b;width:42%'>Template Match Score</td><td style='padding:9px 0;font-weight:600;color:#0b1f3a;'>\", coerce.toString($flow.match_score), \"</td></tr>\", \"</table></td></tr>\", \"<tr><td style='padding:20px 28px 26px'><table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background:#fff7ed;border:1px solid #fdba74;border-radius:10px'><tr><td style='padding:13px 16px;color:#9a3412;font-size:13px;line-height:1.55'><strong>Config-only run.</strong> No Bitbucket repository was created. Generated artifacts: <strong>bitbucket-pipelines.yml</strong>, <strong>Dockerfile</strong> and the <strong>Kubernetes manifest</strong> &mdash; the pipeline file is attached.</td></tr></table></td></tr>\", \"<tr><td style='background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 28px;color:#94a3b8;font-size:11px;line-height:1.6'>Generation ID: \", $flow.generation_id, \"<br />Automated notification from the BWCE AI Integration Generator</td></tr></table><div style='text-align:center;color:#b4c0cf;font-size:11px;padding:14px 0 2px'>adidas &middot; Core Integration Platform</div></div></body></html>\")",
                    "subject_full": "=string.concat(\"✅ [BWCE AI Generator] New repository: \", $flow.repo_name)",
                    "subject_config": "=string.concat(\"✅ [BWCE AI Generator] Config generated: \", $flow.repo_name)",
                    "docfile_full": "=string.concat(\"file://\", $property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/manifest.json\")",
                    "docfile_config": "=string.concat(\"file://\", $property[\"SCAFFOLD_OUTPUT_DIR\"], \"/\", $flow.repo_name, \"/bitbucket-pipelines.yml\")",
                    "docname_full": "=string.concat($flow.repo_name, \"-manifest.json\")",
                    "docname_config": "=string.concat($flow.repo_name, \"-pipeline.yml\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}, \"docfile_full\": {\"type\": \"string\"}, \"docfile_config\": {\"type\": \"string\"}, \"docname_full\": {\"type\": \"string\"}, \"docname_config\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"message_full\": {\"type\": \"string\"}, \"message_config\": {\"type\": \"string\"}, \"subject_full\": {\"type\": \"string\"}, \"subject_config\": {\"type\": \"string\"}, \"docfile_full\": {\"type\": \"string\"}, \"docfile_config\": {\"type\": \"string\"}, \"docname_full\": {\"type\": \"string\"}, \"docname_config\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildEmailAttachment",
            "name": "BuildEmailAttachment",
            "description": "Selects the notification variant (full repo vs config-only) for subject, HTML body and the doc attachment via ref-only ternaries on config_only, and adds the inline CID brand logo attachment.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "subject": "=$flow.config_only == true ? $activity[BuildEmailParts].output.subject_config : $activity[BuildEmailParts].output.subject_full",
                    "message": "=$flow.config_only == true ? $activity[BuildEmailParts].output.message_config : $activity[BuildEmailParts].output.message_full",
                    "attachments": [
                      {
                        "file": "=string.concat(\"file://\", $property[\"BRAND_LOGO_FILE\"])",
                        "filename": "email-logo.png",
                        "inline": true,
                        "base64EncodedContents": false
                      },
                      {
                        "file": "=$flow.config_only == true ? $activity[BuildEmailParts].output.docfile_config : $activity[BuildEmailParts].output.docfile_full",
                        "filename": "=$flow.config_only == true ? $activity[BuildEmailParts].output.docname_config : $activity[BuildEmailParts].output.docname_full",
                        "inline": false,
                        "base64EncodedContents": false
                      }
                    ]
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"attachments\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"file\": {\"type\": \"string\"}, \"filename\": {\"type\": \"string\"}, \"inline\": {\"type\": \"boolean\"}, \"base64EncodedContents\": {\"type\": \"boolean\"}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "SendNotification",
            "name": "SendNotification",
            "description": "Sends an email notification (via the configured SMTP server / maildev mock) to the core integration team announcing the newly scaffolded repository.",
            "settings": {
              "retryOnError": {
                "count": 3,
                "interval": 2000
              }
            },
            "activity": {
              "ref": "#sendmail",
              "input": {
                "Server": "=$property[\"SMTP_HOST\"]",
                "Port": "=$property[\"SMTP_PORT\"]",
                "authorizationType": "Basic",
                "Username": "",
                "Password": "",
                "authorizationConn": "",
                "Connection Security": "NONE",
                "message_content_type": "text/html",
                "sender": "=$property[\"NOTIFY_SENDER\"]",
                "recipients": "=$property[\"NOTIFY_RECIPIENTS\"]",
                "cc_recipients": "",
                "bcc_recipients": "",
                "reply_to": "",
                "subject": "=$activity[BuildEmailAttachment].output.subject",
                "message": "=$activity[BuildEmailAttachment].output.message",
                "attachments": "=$activity[BuildEmailAttachment].output.attachments"
              },
              "schemas": {
                "input": {
                  "attachments": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"items\":{\"properties\":{\"file\":{\"type\":\"string\"},\"filename\":{\"type\":\"string\"},\"base64EncodedContents\":{\"type\":\"boolean\"}},\"required\":[\"file\"],\"type\":\"object\"},\"type\":\"array\"}"
                  },
                  "headers": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"name\",\"value\"]}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkJ1aWxkRW1haWxQYXJ0cyI6eyJ4IjoyNTAsInkiOjQ1fSwiQnVpbGRFbWFpbEF0dGFjaG1lbnQiOnsieCI6NDUwLCJ5Ijo0NX0sIlNlbmROb3RpZmljYXRpb24iOnsieCI6NjUwLCJ5Ijo0NX19",
        "metadata": {
          "input": [
            {
              "name": "business_object",
              "type": "string"
            },
            {
              "name": "cdm",
              "type": "boolean"
            },
            {
              "name": "config_only",
              "type": "boolean"
            },
            {
              "name": "env",
              "type": "string"
            },
            {
              "name": "generation_id",
              "type": "string"
            },
            {
              "name": "interface_type",
              "type": "string"
            },
            {
              "name": "match_score",
              "type": "string"
            },
            {
              "name": "repo_name",
              "type": "string"
            },
            {
              "name": "source_system",
              "type": "string"
            },
            {
              "name": "target_system",
              "type": "string"
            },
            {
              "name": "template_name",
              "type": "string"
            }
          ],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:StartupFlow",
      "data": {
        "name": "StartupFlow",
        "description": "Application bootstrap flow. Loads the template registry and alias mappings from disk into shared memory and initializes the PostgreSQL schema.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadTemplateRegistry",
            "type": "label",
            "label": "StartActivity to ReadTemplateRegistry"
          },
          {
            "id": 2,
            "from": "ReadTemplateRegistry",
            "to": "ParseTemplateRegistry",
            "type": "label",
            "label": " vc "
          },
          {
            "id": 3,
            "from": "ParseTemplateRegistry",
            "to": "ReadAliasMappings",
            "type": "label",
            "label": "ParseTemplateRegistry to ReadAliasMappings"
          },
          {
            "id": 4,
            "from": "ReadAliasMappings",
            "to": "ParseAliasMappings",
            "type": "label",
            "label": "ReadAliasMappings to ParseAliasMappings"
          },
          {
            "id": 5,
            "from": "ParseAliasMappings",
            "to": "StoreConfigToSharedData",
            "type": "label",
            "label": "ParseAliasMappings to StoreConfigToSharedData"
          },
          {
            "id": 6,
            "from": "StoreConfigToSharedData",
            "to": "StoreAliasesToSharedData",
            "type": "label",
            "label": "StoreConfigToSharedData to SetupDatabase"
          },
          {
            "id": 7,
            "from": "StoreAliasesToSharedData",
            "to": "SetupDatabase",
            "type": "label",
            "label": "StoreAliasesToSharedData to SetupDatabase"
          },
          {
            "id": 8,
            "from": "SetupDatabase",
            "to": "IngestTemplatesToVectorDB",
            "type": "label",
            "label": "SetupDatabase to IngestTemplatesToVectorDB"
          },
          {
            "id": 9,
            "from": "IngestTemplatesToVectorDB",
            "to": "ReadIKDInterfaces",
            "type": "label",
            "label": "IngestTemplatesToVectorDB to ReadIKDInterfaces"
          },
          {
            "id": 10,
            "from": "ReadIKDInterfaces",
            "to": "ParseIKDInterfaces",
            "type": "label",
            "label": "ReadIKDInterfaces to ParseIKDInterfaces"
          },
          {
            "id": 11,
            "from": "ParseIKDInterfaces",
            "to": "StoreIKDInterfaces",
            "type": "label",
            "label": "ParseIKDInterfaces to StoreIKDInterfaces"
          },
          {
            "id": 12,
            "from": "StoreIKDInterfaces",
            "to": "ReadIKDScenarios",
            "type": "label",
            "label": "StoreIKDInterfaces to ReadIKDScenarios"
          },
          {
            "id": 13,
            "from": "ReadIKDScenarios",
            "to": "ParseIKDScenarios",
            "type": "label",
            "label": "ReadIKDScenarios to ParseIKDScenarios"
          },
          {
            "id": 14,
            "from": "ParseIKDScenarios",
            "to": "StoreIKDScenarios",
            "type": "label",
            "label": "ParseIKDScenarios to StoreIKDScenarios"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadTemplateRegistry",
            "name": "ReadTemplateRegistry",
            "description": "Reads the template registry JSON file from disk.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"TEMPLATE_REGISTRY\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseTemplateRegistry",
            "name": "ParseTemplateRegistry",
            "description": "Parses the template registry JSON into an object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadTemplateRegistry].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "ReadAliasMappings",
            "name": "ReadAliasMappings",
            "description": "Reads the provider/protocol alias-mappings JSON file from disk.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"ALIAS_MAPPINGS\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseAliasMappings",
            "name": "ParseAliasMappings",
            "description": "Parses the alias mappings JSON into an object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadAliasMappings].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreConfigToSharedData",
            "name": "StoreConfigToSharedData",
            "description": "Caches the template registry in shared memory under APP_CONFIG.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_CONFIG\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseTemplateRegistry].jsonObject"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": "schema://AppConfig"
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "StoreAliasesToSharedData",
            "name": "StoreAliasesToSharedData",
            "description": "Caches the alias mappings in shared memory under APP_ALIASES.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_ALIASES\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseAliasMappings].jsonObject"
                  }
                }
              }
            }
          },
          {
            "id": "SetupDatabase",
            "name": "SetupDatabase",
            "description": "Invokes the SetupDatabaseFlow subflow to initialize the PostgreSQL schema.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:SetupDatabaseFlow",
                "detached": false,
                "execTimeout": 0
              }
            }
          },
          {
            "id": "IngestTemplatesToVectorDB",
            "name": "IngestTemplatesToVectorDB",
            "description": "Invokes the TemplateIngestionFlow subflow to load BWCE templates into the Weaviate vector database so semantic template selection has data to search.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:TemplateIngestionFlow",
                "detached": false,
                "execTimeout": 0
              }
            }
          },
          {
            "id": "ReadIKDInterfaces",
            "name": "ReadIKDInterfaces",
            "description": "Reads the IKD interface-ID registry (JSON array of valid IKD interface identifiers) from disk during startup.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"IKD_INTERFACES_FILE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseIKDInterfaces",
            "name": "ParseIKDInterfaces",
            "description": "Parses the IKD interface-ID registry text into a JSON array.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadIKDInterfaces].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreIKDInterfaces",
            "name": "StoreIKDInterfaces",
            "description": "Caches the valid IKD interface IDs in application shared data (APP_IKD_INTERFACES) for fast cross-checking during generation.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "array"
              },
              "input": {
                "key": "\"APP_IKD_INTERFACES\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseIKDInterfaces].jsonObject"
                  }
                }
              }
            }
          },
          {
            "id": "ReadIKDScenarios",
            "name": "ReadIKDScenarios",
            "description": "Reads the IKD scenario-ID registry (JSON array of valid IKD scenario identifiers) from disk during startup.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "=$property[\"IKD_SCENARIOS_FILE\"]"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseIKDScenarios",
            "name": "ParseIKDScenarios",
            "description": "Parses the IKD scenario-ID registry text into a JSON array.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[ReadIKDScenarios].output.fileContent.textContent"
              }
            }
          },
          {
            "id": "StoreIKDScenarios",
            "name": "StoreIKDScenarios",
            "description": "Caches the valid IKD scenario IDs in application shared data (APP_IKD_SCENARIOS) for fast cross-checking during generation.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "SET",
                "type": "array"
              },
              "input": {
                "key": "\"APP_IKD_SCENARIOS\"",
                "input": {
                  "mapping": {
                    "data": "=$activity[ParseIKDScenarios].jsonObject"
                  }
                }
              }
            }
          }
        ],
        "fe_metadata": "",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:MCPExtractSpecTool",
      "data": {
        "name": "MCPExtractSpecTool",
        "description": "MCP tool 'extract_spec'. Wraps the extract flow so AI agents can turn a natural-language description into a structured BWCE spec.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ExtractSpecSubflow",
            "type": "label",
            "label": "StartActivity to ExtractSpecSubflow"
          },
          {
            "id": 2,
            "from": "ExtractSpecSubflow",
            "to": "ReturnResult",
            "type": "label",
            "label": "ExtractSpecSubflow to ReturnResult"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ExtractSpecSubflow",
            "name": "ExtractSpecSubflow",
            "description": "Runs the extract flow to convert the description into a structured spec.",
            "settings": {
              "retryOnError": {
                "count": 0,
                "interval": 0
              }
            },
            "activity": {
              "ref": "#subflow",
              "settings": {
                "flowURI": "res://flow:extract_POST",
                "detached": false,
                "execTimeout": 0
              },
              "input": {
                "input": {
                  "mapping": {
                    "message": "=$flow.arguments.message",
                    "current_spec": "=$flow.arguments.current_spec"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"object\",\"properties\":{}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnResult",
            "name": "ReturnResult",
            "description": "Wraps the extracted spec as an MCP ToolResult and returns it to the agent.",
            "activity": {
              "ref": "#actreply",
              "schemas": {
                "input": {
                  "reply": {
                    "type": "json",
                    "value": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}",
                    "fe_metadata": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkV4dHJhY3RTcGVjU3ViZmxvdyI6eyJ4IjoyNTAsInkiOjQ1fSwiUmV0dXJuUmVzdWx0Ijp7IngiOjQ1MCwieSI6NDV9fQ==",
        "metadata": {
          "input": [
            {
              "name": "arguments",
              "type": "object"
            }
          ],
          "output": [
            {
              "name": "response",
              "type": "object",
              "schema": {
                "type": "json",
                "value": "{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}"
              }
            }
          ],
          "fe_metadata": {
            "input": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"arguments\":{\"type\":\"object\",\"properties\":{}}}}",
            "output": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"response\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"}}}}}"
          }
        }
      }
    },
    {
      "id": "flow:MCPGenerateTool",
      "data": {
        "name": "MCPGenerateTool",
        "description": "MCP tool 'generate_code'. Validates the spec, derives the repository name, and records the generation, returning the result to the calling AI agent.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetAppConfig",
            "type": "label",
            "label": "StartActivity to GetAppConfig"
          },
          {
            "id": 2,
            "from": "GetAppConfig",
            "to": "ValidateSpec",
            "type": "label",
            "label": "GetAppConfig to ValidateSpec"
          },
          {
            "id": 3,
            "from": "ValidateSpec",
            "to": "BuildRepoName",
            "type": "label",
            "label": "ValidateSpec to BuildRepoName"
          },
          {
            "id": 4,
            "from": "BuildRepoName",
            "to": "CheckDuplicate",
            "type": "label",
            "label": "BuildRepoName to CheckDuplicate"
          },
          {
            "id": 5,
            "from": "CheckDuplicate",
            "to": "RegisterGeneration",
            "type": "expression",
            "label": "No duplicate",
            "value": "array.count($activity[CheckDuplicate].Output.records) == 0"
          },
          {
            "id": 6,
            "from": "CheckDuplicate",
            "to": "ReturnResult",
            "type": "expression",
            "label": "Duplicate found",
            "value": "array.count($activity[CheckDuplicate].Output.records) > 0"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetAppConfig",
            "name": "GetAppConfig",
            "description": "Loads alias mappings (APP_ALIASES) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_ALIASES\"",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "ValidateSpec",
            "name": "ValidateSpec",
            "description": "Validates the spec against required-field rules.",
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=$flow.arguments.spec",
                "fileName": "\"rules/spec-validation.yaml\"",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "",
                "disabledRules": {
                  "mapping": []
                },
                "tags": {
                  "mapping": []
