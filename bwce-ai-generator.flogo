  "connections": {
    "1291b51d-31ef-4b7c-80c2-59344a2fc4e3": {
      "id": "1291b51d-31ef-4b7c-80c2-59344a2fc4e3",
      "name": "GenerationRegistry",
      "ref": "#connection",
      "isGlobal": false,
      "settings": {
        "databaseType": "PostgreSQL",
        "name": "GenerationRegistry",
        "description": "Your PostgreSQL Connector",
        "host": "=$property[\"PostgreSQL.GenerationRegistry.Host\"]",
        "port": "=$property[\"PostgreSQL.GenerationRegistry.Port\"]",
        "databaseName": "=$property[\"PostgreSQL.GenerationRegistry.Database_Name\"]",
        "user": "=$property[\"PostgreSQL.GenerationRegistry.User\"]",
        "password": "=$property[\"PostgreSQL.GenerationRegistry.Password\"]",
        "maxopenconnection": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Open_Connections\"]",
        "maxidleconnection": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Idle_Connections\"]",
        "connmaxlifetime": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Connection_Lifetime\"]",
        "maxconnectattempts": "=$property[\"PostgreSQL.GenerationRegistry.Maximum_Connection_Retry_Attempts\"]",
        "connectionretrydelay": "=$property[\"PostgreSQL.GenerationRegistry.Connection_Retry_Delay\"]",
        "connectiontimeout": "=$property[\"PostgreSQL.GenerationRegistry.Connection_Timeout\"]",
        "onprem": false,
        "tlsconfig": false,
        "tlsparam": "VerifyCA",
        "cacert": "",
        "clientcert": "",
        "clientkey": ""
      }
    },
    "6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924": {
      "id": "6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
      "name": "WeaviateTemplateKB",
      "ref": "#connector",
      "isGlobal": false,
      "settings": {
        "name": "=$property[\"VectorDB.WeaviateTemplateKB.Connection_Name\"]",
        "host": "=$property[\"VectorDB.WeaviateTemplateKB.Host\"]",
        "port": "=$property[\"VectorDB.WeaviateTemplateKB.Port\"]",
        "apiKey": "=$property[\"VectorDB.WeaviateTemplateKB.API_Key\"]",
        "useTLS": "=$property[\"VectorDB.WeaviateTemplateKB.Secure_Connection\"]",
        "tlsInsecureSkipVerify": false,
        "timeoutSeconds": "=$property[\"VectorDB.WeaviateTemplateKB.Timeout_(seconds)\"]",
        "maxRetries": "=$property[\"VectorDB.WeaviateTemplateKB.Max_Retries\"]",
        "retryBackoffMs": "=$property[\"VectorDB.WeaviateTemplateKB.Retry_Backoff_(ms)\"]",
        "scheme": "http",
        "enableEmbedding": "=$property[\"VectorDB.WeaviateTemplateKB.Configure_Embedding_Provider\"]",
        "embeddingProvider": "OpenAI"
      }
    },
    "3a36f9db-e22f-4599-b533-3bcaf19db634": {
      "id": "3a36f9db-e22f-4599-b533-3bcaf19db634",
      "name": "LLMProvider",
      "ref": "#llmprovider",
      "isGlobal": false,
      "settings": {
        "name": "LLMProvider",
        "llmProvider": "Ollama",
        "anthropicProvider": "Default",
        "apiKey": "",
        "llmProviderUrl": "http://localhost:11434"
      }
    }
  },
  "contrib": "",
  "metadata": {
    "endpoints": [
      {
        "protocol": "http",
        "port": "9999",
        "spec": {
          "name": "bwce-ai-generator",
          "version": "1.0.0"
        },
        "title": "BWCEAIIntegrationGenerator",
        "swagger": {
          "openapi": "3.0.0",
          "info": {
            "title": "bwce-ai-generator",
            "version": "1.0.0",
            "description": "AI-powered accelerator that generates TIBCO BWCE integration repositories through natural language conversation"
          },
          "paths": {
            "/health": {
              "get": {
                "summary": "health_GET",
                "operationId": "get_health",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Health-check endpoint (GET /health). Returns service status so load balancers and monitoring probes can verify the generator is running."
              }
            },
            "/api/templates": {
              "get": {
                "summary": "api_templates_GET",
                "operationId": "get_api_templates",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Lists available BWCE integration templates (GET /api/templates) from the cached template registry."
              }
            },
            "/api/chat/init": {
              "post": {
                "summary": "api_chat/init_POST",
                "operationId": "post_api_chat_init",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Starts a new conversational session (POST /api/chat/init). Creates an empty spec, allocates a session id, and stores the session in shared memory.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema1"
                      }
                    }
                  }
                }
              }
            },
            "/api/chat/message": {
              "post": {
                "summary": "api_chat/message_POST",
                "operationId": "post_api_chat_message",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Handles one turn of the conversational spec-building flow (POST /api/chat/message). Uses an LLM to extract integration fields from the user's message, checks spec completeness, and asks the next clarifying question.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema2"
                      }
                    }
                  }
                }
              }
            },
            "/api/chat/reset": {
              "post": {
                "summary": "api_chat/reset_POST",
                "operationId": "post_api_chat_reset",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Resets a conversation (POST /api/chat/reset) by deleting the stored session so the user can start over.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema3"
                      }
                    }
                  }
                }
              }
            },
            "/extract": {
              "post": {
                "summary": "extract_POST",
                "operationId": "post_extract",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Extracts a structured BWCE integration spec from a free-text description (POST /extract). Runs the LLM, normalizes provider/protocol aliases, and reports any missing required fields.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema4"
                      }
                    }
                  }
                }
              }
            },
            "/generate": {
              "post": {
                "summary": "generate_POST",
                "operationId": "post_generate",
                "parameters": [
                  {
                    "name": "Authorization",
                    "in": "header",
                    "description": "Request parameter",
                    "required": false,
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "",
                    "content": {
                      "text/plain": {
                        "schema": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "description": "Generates a BWCE integration repository from a validated spec (POST /generate). Validates the spec, selects the best-matching template via Weaviate vector search, records the generation in PostgreSQL, and returns the result.",
                "requestBody": {
                  "description": "",
                  "required": false,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/schema5"
                      }
                    }
                  }
                }
              }
            }
          },
          "components": {
            "schemas": {
              "schema1": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string",
                    "description": "Optional â provide to resume an existing session"
                  }
                }
              },
              "schema2": {
                "type": "object",
                "required": [
                  "session_id",
                  "message"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
