          {
            "id": "RegexPreExtract",
            "name": "RegexPreExtract",
            "description": "Deterministic regex/NLU pre-extraction: detects high-confidence tokens (IKD IDs, interface verbs, canonical systems, environments) in the raw user message and emits them as signals that anchor the downstream LLM extraction.",
            "activity": {
              "ref": "#ruleengine",
              "input": {
                "content": "=$flow.content",
                "fileName": "rules/nlu-extraction.yaml",
                "rulesPath": "=$property[\"RULES_PATH\"]",
                "parserOverride": "json",
                "disabledRules": {
                  "mapping": []
                },
                "tags": {
                  "mapping": [
                    "nlu"
                  ]
                }
              }
            }
          },
          {
            "id": "ExtractWithLLM",
            "name": "ExtractWithLLM",
            "description": "Uses the Weaviate RAG connector LLM generation to extract a structured integration spec from the free-text message.",
            "activity": {
              "ref": "#ragQuery",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:jB0SFBx3H99F6Egxoi96RlvJHWX/1g==",
                "embeddingBaseURL": "http://localhost:11434/v1",
                "embeddingModel": "nomic-embed-text",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "defaultTopK": 5,
                "scoreThreshold": 0,
                "contentField": "text",
                "contextFormat": "numbered",
                "timeoutSeconds": 30,
                "useHybridSearch": false,
                "hybridAlpha": 0.5,
                "enableLLMGenerate": true,
                "llmProvider": "Ollama",
                "llmBaseURL": "http://localhost:11434",
                "llmAPIKey": "",
                "llmModel": "qwen2.5:14b",
                "systemPrompt": "You convert a user's integration request into a JSON spec. Use ONLY the user's Question text for values; the Context section is a template catalog you may use ONLY to choose template_type. Output ONLY one JSON object, no code fences and no prose, with these string keys: source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id. interface_type must be one of pub, sub or service. Use pub for publish or publisher or produce, sub for subscribe or subscriber or consume, and service for request-reply or api. cdm must be \"true\" or \"false\". Use \"\" for any field the user did not mention. Example Question: I need a publisher from SAP ECC to MQ for invoice data with CDM enabled. Example JSON: {\"source_system\":\"SAP ECC\",\"target_system\":\"MQ\",\"business_object\":\"invoice\",\"interface_type\":\"pub\",\"template_type\":\"\",\"cdm\":\"true\",\"interface_id\":\"\",\"scenario_id\":\"\",\"bitbucket_project\":\"\",\"email\":\"\",\"env\":\"\",\"k8s_domain\":\"\",\"country_code\":\"\",\"unique_id\":\"\"}",
                "maxTokens": 1024,
                "temperature": 0
              },
              "input": {
                "queryText": "=string.concat(coerce.toString($flow.content.message), \" \", coerce.toString($activity[RegexPreExtract].markdown))",
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "topK": 2,
                "systemPrompt": "You convert a user's integration request into a JSON spec. Use ONLY the user's Question text for values; the Context section is a template catalog you may use ONLY to choose template_type. Output ONLY one JSON object, no code fences and no prose, with these string keys: source_system, target_system, business_object, interface_type, template_type, cdm, interface_id, scenario_id, bitbucket_project, email, env, k8s_domain, country_code, unique_id. interface_type must be one of pub, sub or service. Use pub for publish or publisher or produce, sub for subscribe or subscriber or consume, and service for request-reply or api. cdm must be \"true\" or \"false\". Use \"\" for any field the user did not mention. Example Question: I need a publisher from SAP ECC to MQ for invoice data with CDM enabled. Example JSON: {\"source_system\":\"SAP ECC\",\"target_system\":\"MQ\",\"business_object\":\"invoice\",\"interface_type\":\"pub\",\"template_type\":\"\",\"cdm\":\"true\",\"interface_id\":\"\",\"scenario_id\":\"\",\"bitbucket_project\":\"\",\"email\":\"\",\"env\":\"\",\"k8s_domain\":\"\",\"country_code\":\"\",\"unique_id\":\"\"}"
              }
            }
          },
          {
            "id": "CleanJSON",
            "name": "CleanJSON",
            "description": "Strips markdown code fences from the LLM answer so it can be parsed as JSON.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "cleaned": "=string.replaceAll(string.replaceAll(coerce.toString($activity[ExtractWithLLM].answer), \"```json\", \"\"), \"```\", \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"cleaned\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseExtraction",
            "name": "ParseExtraction",
            "description": "Parses the cleaned LLM JSON answer into a structured object.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=$activity[CleanJSON].output.cleaned"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "MergeSpec",
            "name": "MergeSpec",
            "description": "Merges newly LLM-extracted fields with the spec stored in the session (extracted value wins when present).",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "source_system": "=(coerce.toString($activity[ParseExtraction].jsonObject.source_system) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.source_system) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].source_system) : \"\")",
                    "target_system": "=(coerce.toString($activity[ParseExtraction].jsonObject.target_system) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.target_system) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].target_system) : \"\")",
                    "business_object": "=(coerce.toString($activity[ParseExtraction].jsonObject.business_object) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.business_object) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].business_object) : \"\")",
                    "interface_type": "=(coerce.toString($activity[ParseExtraction].jsonObject.interface_type) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.interface_type) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].interface_type) : \"\")",
                    "template_type": "=(coerce.toString($activity[ParseExtraction].jsonObject.template_type) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.template_type) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].template_type) : \"\")",
                    "cdm": "=(coerce.toString($activity[ParseExtraction].jsonObject.cdm) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.cdm) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].cdm) : \"\")",
                    "interface_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.interface_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.interface_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].interface_id) : \"\")",
                    "scenario_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.scenario_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.scenario_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].scenario_id) : \"\")",
                    "bitbucket_project": "=(coerce.toString($activity[ParseExtraction].jsonObject.bitbucket_project) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.bitbucket_project) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].bitbucket_project) : \"\")",
                    "email": "=(coerce.toString($activity[ParseExtraction].jsonObject.email) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.email) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].email) : \"\")",
                    "env": "=(coerce.toString($activity[ParseExtraction].jsonObject.env) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.env) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].env) : \"\")",
                    "k8s_domain": "=(coerce.toString($activity[ParseExtraction].jsonObject.k8s_domain) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.k8s_domain) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].k8s_domain) : \"\")",
                    "country_code": "=(coerce.toString($activity[ParseExtraction].jsonObject.country_code) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.country_code) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].country_code) : \"\")",
                    "unique_id": "=(coerce.toString($activity[ParseExtraction].jsonObject.unique_id) != \"\") ? coerce.toString($activity[ParseExtraction].jsonObject.unique_id) : ((array.count($activity[GetSession].Output.records) > 0) ? coerce.toString($activity[GetSession].Output.records[0].unique_id) : \"\")"
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ComputeMissing",
            "name": "ComputeMissing",
            "description": "Computes which required fields are still missing, whether the spec is ready, and the next clarifying question to ask.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "p_source_system": "=($activity[MergeSpec].output.source_system == \"\") ? \"\\\"source_system\\\",\" : \"\"",
                    "p_target_system": "=($activity[MergeSpec].output.target_system == \"\") ? \"\\\"target_system\\\",\" : \"\"",
                    "p_business_object": "=($activity[MergeSpec].output.business_object == \"\") ? \"\\\"business_object\\\",\" : \"\"",
                    "p_interface_type": "=($activity[MergeSpec].output.interface_type == \"\") ? \"\\\"interface_type\\\",\" : \"\"",
                    "p_template_type": "=($activity[MergeSpec].output.template_type == \"\") ? \"\\\"template_type\\\",\" : \"\"",
                    "ready": "=($activity[MergeSpec].output.source_system != \"\" && $activity[MergeSpec].output.target_system != \"\" && $activity[MergeSpec].output.business_object != \"\" && $activity[MergeSpec].output.interface_type != \"\" && $activity[MergeSpec].output.template_type != \"\")",
                    "next_q": "=($activity[MergeSpec].output.source_system == \"\") ? \"Which source system should the data come FROM? (e.g. s4hana, wms, salesforce)\" : ($activity[MergeSpec].output.target_system == \"\") ? \"Which target system should the data go TO? (e.g. kafka, ems, rest)\" : ($activity[MergeSpec].output.business_object == \"\") ? \"What business object is this integration about? (e.g. article, invoice, order)\" : ($activity[MergeSpec].output.interface_type == \"\") ? \"What interface type should this be? (pub, sub, or service)\" : ($activity[MergeSpec].output.template_type == \"\") ? \"Which template should we use? (e.g. S4HANA_PUB_To_KAFKATopic_CDM)\" : \"All required fields collected — ready to generate!\""
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"p_source_system\": {\"type\": \"string\"}, \"p_target_system\": {\"type\": \"string\"}, \"p_business_object\": {\"type\": \"string\"}, \"p_interface_type\": {\"type\": \"string\"}, \"p_template_type\": {\"type\": \"string\"}, \"ready\": {\"type\": \"boolean\"}, \"next_q\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"p_source_system\": {\"type\": \"string\"}, \"p_target_system\": {\"type\": \"string\"}, \"p_business_object\": {\"type\": \"string\"}, \"p_interface_type\": {\"type\": \"string\"}, \"p_template_type\": {\"type\": \"string\"}, \"ready\": {\"type\": \"boolean\"}, \"next_q\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ParseMissing",
            "name": "ParseMissing",
            "description": "Parses the assembled JSON array of missing required field names into a string array.",
            "activity": {
              "ref": "#parsejson",
              "input": {
                "validate": false,
                "jsonString": "=string.replaceAll(string.concat(\"[\", $activity[ComputeMissing].output.p_source_system, $activity[ComputeMissing].output.p_target_system, $activity[ComputeMissing].output.p_business_object, $activity[ComputeMissing].output.p_interface_type, $activity[ComputeMissing].output.p_template_type, \"]\"), \",]\", \"]\")"
              },
              "schemas": {
                "output": {
                  "jsonObject": {
                    "type": "json",
                    "value": "{\"type\": \"array\", \"items\": {\"type\": \"string\"}}",
                    "fe_metadata": "{\"type\": \"array\", \"items\": {\"type\": \"string\"}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildChatResponse",
            "name": "BuildChatResponse",
            "description": "Assembles the chat turn response and the updated session state: merged spec, missing fields, readiness and the assistant message.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "session_id": "=$flow.content.session_id",
                    "status": "\"active\"",
                    "message": "=$activity[ComputeMissing].output.next_q",
                    "spec": {
                      "source_system": "=$activity[MergeSpec].output.source_system",
                      "target_system": "=$activity[MergeSpec].output.target_system",
                      "business_object": "=$activity[MergeSpec].output.business_object",
                      "interface_type": "=$activity[MergeSpec].output.interface_type",
                      "template_type": "=$activity[MergeSpec].output.template_type",
                      "cdm": "=$activity[MergeSpec].output.cdm",
                      "interface_id": "=$activity[MergeSpec].output.interface_id",
                      "scenario_id": "=$activity[MergeSpec].output.scenario_id",
                      "bitbucket_project": "=$activity[MergeSpec].output.bitbucket_project",
                      "email": "=$activity[MergeSpec].output.email",
                      "env": "=$activity[MergeSpec].output.env",
                      "k8s_domain": "=$activity[MergeSpec].output.k8s_domain",
                      "country_code": "=$activity[MergeSpec].output.country_code",
                      "unique_id": "=$activity[MergeSpec].output.unique_id"
                    },
                    "missing_fields": "=$activity[ParseMissing].jsonObject",
                    "ready_to_generate": "=$activity[ComputeMissing].output.ready",
                    "shell_command": "=($activity[ComputeMissing].output.ready == true) ? \"Ready — POST /generate with this spec to create the repository.\" : \"\""
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\": \"object\", \"properties\": {\"session_id\": {\"type\": \"string\"}, \"status\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"missing_fields\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"shell_command\": {\"type\": \"string\"}}}",
                    "fe_metadata": "{\"type\": \"object\", \"properties\": {\"session_id\": {\"type\": \"string\"}, \"status\": {\"type\": \"string\"}, \"message\": {\"type\": \"string\"}, \"spec\": {\"type\": \"object\", \"properties\": {\"source_system\": {\"type\": \"string\"}, \"target_system\": {\"type\": \"string\"}, \"business_object\": {\"type\": \"string\"}, \"interface_type\": {\"type\": \"string\"}, \"template_type\": {\"type\": \"string\"}, \"cdm\": {\"type\": \"string\"}, \"interface_id\": {\"type\": \"string\"}, \"scenario_id\": {\"type\": \"string\"}, \"bitbucket_project\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"env\": {\"type\": \"string\"}, \"k8s_domain\": {\"type\": \"string\"}, \"country_code\": {\"type\": \"string\"}, \"unique_id\": {\"type\": \"string\"}}}, \"missing_fields\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"ready_to_generate\": {\"type\": \"boolean\"}, \"shell_command\": {\"type\": \"string\"}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
