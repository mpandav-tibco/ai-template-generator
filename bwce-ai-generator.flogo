    {
      "id": "flow:TemplateIngestionFlow",
      "data": {
        "name": "TemplateIngestionFlow",
        "description": "Loads BWCE templates into the Weaviate vector database. Ensures the target collection exists, then ingests template documents with embeddings to power semantic template selection.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "GetTemplates",
            "type": "label",
            "label": "StartActivity to GetTemplates"
          },
          {
            "id": 2,
            "from": "GetTemplates",
            "to": "CheckCollection",
            "type": "label",
            "label": "GetTemplates to CheckCollection"
          },
          {
            "id": 3,
            "from": "CheckCollection",
            "to": "CreateCollection",
            "type": "label",
            "label": "CheckCollection to CreateCollection"
          },
          {
            "id": 4,
            "from": "CreateCollection",
            "to": "IngestTemplates",
            "type": "label",
            "label": "CreateCollection to IngestTemplates"
          },
          {
            "id": 5,
            "from": "IngestTemplates",
            "to": "LogIngestionComplete",
            "type": "label",
            "label": "IngestTemplates to LogIngestionComplete"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "GetTemplates",
            "name": "GetTemplates",
            "description": "Reads the template registry (APP_CONFIG) from shared memory.",
            "activity": {
              "ref": "#shareddata",
              "settings": {
                "scope": "Application",
                "operation": "GET",
                "type": "object"
              },
              "input": {
                "key": "\"APP_CONFIG\"",
                "input": {
                  "mapping": {}
                }
              }
            }
          },
          {
            "id": "CheckCollection",
            "name": "CheckCollection",
            "description": "Lists existing Weaviate collections to check whether the template collection already exists.",
            "activity": {
              "ref": "#listCollections",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924"
              }
            }
          },
          {
            "id": "CreateCollection",
            "name": "CreateCollection",
            "description": "Creates the Weaviate template collection with the correct vector schema if it is missing.",
            "activity": {
              "ref": "#createCollection",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924"
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "dimensions": 768,
                "distanceMetric": "cosine",
                "onDisk": false,
                "replicationFactor": 1
              }
            }
          },
          {
            "id": "IngestTemplates",
            "name": "IngestTemplates",
            "description": "Ingests template documents into the Weaviate collection, generating embeddings for semantic search.",
            "activity": {
              "ref": "#ingestDocuments",
              "settings": {
                "connection": "conn://6c0d4f9e-c11f-4b05-8d4b-e95f88cc3924",
                "enableChunking": false,
                "chunkStrategy": "heading",
                "chunkSize": 1000,
                "chunkOverlap": 200,
                "useConnectorEmbedding": false,
                "embeddingProvider": "OpenAI",
                "embeddingAPIKey": "SECRET:yJ4kvCQdM+1FQBh/1dW8bFpoGCNx+w==",
                "embeddingBaseURL": "http://localhost:11434/v1",
                "embeddingModel": "nomic-embed-text",
                "embeddingDimensions": 768,
                "defaultCollection": "",
                "contentField": "text",
                "timeoutSeconds": 60,
                "embeddingBatchSize": 100
              },
              "input": {
                "collectionName": "=$property[\"VECTOR_COLLECTION\"]",
                "documents": "=$activity[GetTemplates].output.data.templates"
              }
            }
          },
          {
            "id": "LogIngestionComplete",
            "name": "LogIngestionComplete",
            "description": "Logs that templates have been ingested into the vector database.",
            "activity": {
              "ref": "#log",
              "input": {
                "Log Level": "INFO",
                "flowInfo": false,
                "message": "\"[INGESTION] Templates ingested into VectorDB collection.\"",
                "logLevel": ""
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo0NX0sIkdldFRlbXBsYXRlcyI6eyJ4IjoyNTAsInkiOjQ1fSwiQ2hlY2tDb2xsZWN0aW9uIjp7IngiOjQ1MCwieSI6NDV9LCJDcmVhdGVDb2xsZWN0aW9uIjp7IngiOjY1MCwieSI6NDV9LCJJbmdlc3RUZW1wbGF0ZXMiOnsieCI6MjUwLCJ5IjoxOTV9LCJMb2dJbmdlc3Rpb25Db21wbGV0ZSI6eyJ4Ijo0NTAsInkiOjE5NX19",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        }
      }
    },
    {
      "id": "flow:root_GET",
      "data": {
        "name": "root_GET",
        "description": "Serves the conversational Web Chat UI (GET /). Reads static/chat.html from disk and returns it as text/html via an implicit reply.",
        "links": [
          {
            "id": 1,
            "from": "StartActivity",
            "to": "ReadChatHtml",
            "type": "label",
            "label": "StartActivity to ReadChatHtml"
          },
          {
            "id": 2,
            "from": "ReadChatHtml",
            "to": "BuildHtmlResponse",
            "type": "label",
            "label": "ReadChatHtml to BuildHtmlResponse"
          },
          {
            "id": 3,
            "from": "BuildHtmlResponse",
            "to": "ReturnHtml",
            "type": "label",
            "label": "BuildHtmlResponse to ReturnHtml"
          }
        ],
        "tasks": [
          {
            "id": "StartActivity",
            "name": "StartActivity",
            "description": "Flow entry point.",
            "activity": {
              "ref": "#noop"
            }
          },
          {
            "id": "ReadChatHtml",
            "name": "ReadChatHtml",
            "description": "Reads the static chat UI HTML file from disk.",
            "activity": {
              "ref": "#read",
              "input": {
                "readAs": "Text",
                "compress": "None",
                "input": {
                  "mapping": {
                    "fileName": "static/chat.html"
                  }
                }
              },
              "schemas": {
                "input": {
                  "input": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileName\":{\"type\":\"string\"}},\"required\":[\"fileName\"],\"type\":\"object\"}"
                  }
                },
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}",
                    "fe_metadata": "{\"properties\":{\"fileMetadata\":{\"properties\":{\"fullPath\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"size\":{\"type\":\"number\"},\"mode\":{\"type\":\"string\"},\"modTime\":{\"type\":\"string\",\"format\":\"date-time\"},\"isDir\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"fileContent\":{\"properties\":{\"textContent\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "BuildHtmlResponse",
            "name": "BuildHtmlResponse",
            "description": "Builds the responseBody object {body, headers} with the HTML evaluated, so the implicit reply emits text/html.",
            "activity": {
              "ref": "#mapper",
              "input": {
                "input": {
                  "mapping": {
                    "responseBody": {
                      "body": "=$activity[ReadChatHtml].output.fileContent.textContent",
                      "headers": {
                        "Content-Type": "text/html; charset=UTF-8"
                      }
                    }
                  }
                }
              },
              "schemas": {
                "output": {
                  "output": {
                    "type": "json",
                    "value": "{\"type\":\"object\",\"properties\":{\"responseBody\":{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"string\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Content-Type\":{\"type\":\"string\"}}}}}}}",
                    "fe_metadata": "{\"type\":\"object\",\"properties\":{\"responseBody\":{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"string\"},\"headers\":{\"type\":\"object\",\"properties\":{\"Content-Type\":{\"type\":\"string\"}}}}}}}"
                  }
                }
              },
              "feSchemaMap": {}
            }
          },
          {
            "id": "ReturnHtml",
            "name": "ReturnHtml",
            "description": "Returns the HTML page with Content-Type text/html (implicit reply via responseBody+headers).",
            "activity": {
              "ref": "#actreturn",
              "settings": {
                "mappings": {
                  "code": 200,
                  "responseBody": "=$activity[BuildHtmlResponse].output.responseBody"
                }
              }
            }
          }
        ],
        "fe_metadata": "eyJTdGFydEFjdGl2aXR5Ijp7IngiOjUwLCJ5Ijo1MH0sIlJlYWRDaGF0SHRtbCI6eyJ4IjoyNTAsInkiOjUwfSwiQnVpbGRIdG1sUmVzcG9uc2UiOnsieCI6NDUwLCJ5Ijo1MH0sIlJldHVybkh0bWwiOnsieCI6NjUwLCJ5Ijo1MH19",
        "metadata": {
          "input": [],
          "output": [],
          "fe_metadata": {}
        },
        "explicitReply": true
      }
    },
